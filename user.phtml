!! Nova : feuille de surcharge du portail ou du groupement (WIMS ne la charge que dans la structure elle-meme) :
!! transmise a nova.js (reglagesStructure), qui en applique les reglages --nova-... dans toutes ses zones.
!if $wims_superclass!=$empty
  !! Lu par !sh comme scripts/adm/css.phtml : !record couperait au premier « :root » (separateur WIMS).
  !set nova_css_structure=!sh if test -r $wims_home/log/classes/$wims_superclass/css; then cat $wims_home/log/classes/$wims_superclass/css; fi
  !! Toujours transmise, meme vide : sinon nova.js reprendrait l'ancienne valeur gardee (sessionStorage).
<script type="text/plain" id="nova-css-structure">$nova_css_structure</script>
  !reset nova_css_structure
!endif

!set percents=!getscorepercent
!set class_homepage=!getdef class_homepage in wimshome/log/classes/$wims_class/.def
!set etest=!record 0 of wimshome/log/classes/$wims_class/.parmreg/$wims_user.exam
!set n_=!wordcnt $etest

!if / isin $class_homepage and _tool notin $wims_session
  !set deffile=wimshome/log/classes/$wims_class/doc/$class_homepage.def
  !set t_=!getdef titb in $deffile
  !if $t_=$empty or $n_>=4
    !goto normal
  !endif
  !read ./userhome.phtml
  !goto end
!endif

:normal
!! Nova : bouton Mes notes bien visible, tout en haut de l'accueil de l'eleve (demande de l'utilisateur,
!! 2026-10-03). Lien du menu de WIMS (module adm/class/userscore), libelle de WIMS.
!! Nova : badges de l'eleve (demande de l'utilisateur, 2026-10-07 : Fidelite ; 2026-10-09 : Persevérance). Calcul par
!! _procs/badges.awk (Fidelite : semaines avec assez d'exercices, vacances sautees ; Perseverance : exercices reussis
!! apres des notes faibles) ; reglages --nova-badges, --nova-badges-actifs, --nova-fidelite-*, --nova-perseverance-*,
!! --nova-vacances lus dans les feuilles du site, de la structure et de la classe (la derniere l'emporte) ; niveaux
!! gardes dans score/<eleve>.nova (jamais perdus, annonces une seule fois). Une seule pastille « Badges » (maquette B,
!! 2026-10-09), fenetre a onglets (nova.js fenetreBadges). Pas dans l'accueil d'un portail ou d'un groupement (le
!! travail est dans ses zones), ni en examen.
!reset nova_bdg nova_lf nova_lp nova_lc nova_lr
!if $wims_user!=supervisor and $wims_user!=$empty and _exam notin $wims_session
  !ifval 0$class_type<2
    !set nova_cl=$wims_home/log/classes
    !set nova_auj=!char 1 to 8 of $wims_now
    !set nova_bd=!sh { echo '#conf'; cat $wims_home/log/nova.conf $nova_cl/$wims_superclass/css $nova_cl/$wims_class/css 2>/dev/null; echo; echo '#stock'; cat $nova_cl/$wims_class/score/$wims_user.nova 2>/dev/null; echo '#score'; cat $nova_cl/$wims_class/score/$wims_user $nova_cl/$wims_class/noscore/$wims_user 2>/dev/null; } | awk -v auj=$nova_auj -f $wims_home/public_html/themes/Nova/_procs/badges.awk
    !set nova_lf=!line 1 of $nova_bd
    !set nova_lp=!line 2 of $nova_bd
    !set nova_lc=!line 3 of $nova_bd
    !set nova_lr=!line 4 of $nova_bd
    !set nova_le=!line 5 of $nova_bd
    !set nova_le=!word 2 of $nova_le
    !if $nova_le=1
      !set nova_st=!line 6 to -1 of $nova_bd
      !writefile wimshome/log/classes/$wims_class/score/$wims_user.nova $nova_st
    !endif
    !set nova_fo=!word 2 of $nova_lf
    !set nova_po=!word 2 of $nova_lp
    !if $nova_fo=on or $nova_po=on
      !set nova_bdg=on
    !endif
    !! Exercice « en cours » de Perseverance (assez de notes faibles, pas encore de reussite) : son titre.
    !reset nova_ct
    !set nova_cx=!word 2 of $nova_lc
    !if $nova_po=on and $nova_cx!=- and $nova_cx!=$empty
      !set nova_cf=!word 3 of $nova_lc
      !set nova_co=!word 4 of $nova_lc
      !set nova_cn=!word 5 of $nova_lc
      !if $nova_cx=1
        !set nova_rec=!record $nova_co of wimshome/log/classes/$wims_class/exams/.exam$nova_cf
        !set nova_ct=!line 3 of $nova_rec
      !else
        !set nova_rec=!record $nova_co of wimshome/log/classes/$wims_class/sheets/.sheet$nova_cf
        !set nova_ct=!line 5 of $nova_rec
      !endif
      !set nova_ct=!replace internal " by ' in $nova_ct
      !set nova_ct=$nova_ct|$nova_cn
      !reset nova_cf nova_co nova_cn nova_rec
    !endif
    !reset nova_cl nova_auj nova_bd nova_le nova_st nova_cx
  !endif
!endif
!if $wims_user!=supervisor and $wims_user!=$empty
  <div class="nova-mes-notes">
  !set wims_ref_class=nova-mes-notes-bouton
  !href module=adm/class/userscore &#127942; $wims_name_myscore &#127942;
  !reset wims_ref_class
  !if $nova_bdg=on
    <a class="nova-pastille-badge" href="#nova-badges" aria-label="$nova_badges_titre">
    !if $nova_fo=on
      !set nova_n=!word 3 of $nova_lf
      !set nova_i=$nova_n
      !if $nova_i<1
        !set nova_i=1
      !endif
      <img class="nova-badge-niv-$nova_n" src="themes/Nova/img/badges/fidelite/coeur_0$nova_i.webp" alt="" width="36" height="36">
    !endif
    !if $nova_po=on
      !set nova_n=!word 3 of $nova_lp
      !set nova_i=$nova_n
      !if $nova_i<1
        !set nova_i=1
      !endif
      <img class="nova-badge-niv-$nova_n" src="themes/Nova/img/badges/perseverance/flamme_0$nova_i.webp" alt="" width="36" height="36">
    !endif
    <span>$nova_badges_court</span>
    </a>
  !endif
  </div>
  !if $nova_bdg=on
    !! Annonce d'un nouveau niveau, une par badge (une seule fois : « vu » dans le stock).
    !if $nova_fo=on
      !set nova_nv=!word 8 of $nova_lf
      !if $nova_nv=1
        !set nova_n=!word 3 of $nova_lf
        !set nova_bnom=!item $nova_n of $nova_fid_niveaux
        !set nova_bp=!word $[$nova_n+10] of $nova_lf
        !set nova_bm=!replace internal %n by $nova_bp in $(nova_fid_bravo$nova_n)
      <div class="nova-badge-annonce" role="status">
        <img src="themes/Nova/img/badges/fidelite/coeur_0$nova_n.webp" alt="" width="72" height="72">
        <div><b>$nova_fid_nouveau $nova_fid_nom $nova_bnom&nbsp;!</b><p>$nova_bm</p></div>
        <p class="nova-badge-annonce-liens"><a href="#nova-badges" data-badge="fidelite">$nova_badges_voir</a><button type="button" class="nova-badge-masquer">$nova_badges_masquer</button></p>
      </div>
      !endif
    !endif
    !if $nova_po=on
      !set nova_nv=!word 6 of $nova_lp
      !if $nova_nv=1
        !set nova_n=!word 3 of $nova_lp
        !set nova_bnom=!item $nova_n of $nova_fid_niveaux
        !set nova_bp=!word 4 of $nova_lp
        !if $nova_bp=1
          !set nova_bm=$nova_per_bravo1
        !else
          !set nova_bm=!replace internal %n by $nova_bp in $nova_per_bravo
        !endif
      <div class="nova-badge-annonce" role="status">
        <img src="themes/Nova/img/badges/perseverance/flamme_0$nova_n.webp" alt="" width="72" height="72">
        <div><b>$nova_fid_nouveau $nova_per_nom $nova_bnom&nbsp;!</b><p>$nova_bm</p></div>
        <p class="nova-badge-annonce-liens"><a href="#nova-badges" data-badge="perseverance">$nova_badges_voir</a><button type="button" class="nova-badge-masquer">$nova_badges_masquer</button></p>
      </div>
      !endif
    !endif
    <div id="nova-badges" hidden data-fidelite="$nova_lf" data-perseverance="$nova_lp" data-encours="$nova_ct" data-reglages="$nova_lr"
      data-niveaux="$nova_fid_niveaux" data-images-fidelite="themes/Nova/img/badges/fidelite/coeur_0" data-images-perseverance="themes/Nova/img/badges/perseverance/flamme_0"
      data-titre="$nova_badges_titre" data-niveau="$nova_badges_niveau" data-obtenu="$nova_badges_obtenu"
      data-serie="$nova_badges_serie" data-record="$nova_badges_record" data-avant="$nova_badges_avant" data-max="$nova_badges_max"
      data-aucun="$nova_badges_aucun" data-sem="$nova_badges_sem" data-fermer="$nova_badges_fermer"
      data-fid-nom="$nova_fid_nom" data-fid-regle="$nova_fid_regle" data-fid-regle1="$nova_fid_regle1" data-fid-vacances="$nova_fid_vacances"
      data-fid-suite="$nova_fid_suite" data-fid-suite1="$nova_fid_suite1"
      data-fid-etat-fait="$nova_fid_etat_fait" data-fid-etat-attente="$nova_fid_etat_attente" data-fid-etat-attente1="$nova_fid_etat_attente1"
      data-fid-etat-pause="$nova_fid_etat_pause" data-fid-etat-danger="$nova_fid_etat_danger"
      data-per-nom="$nova_per_nom" data-per-regle="$nova_per_regle" data-per-total="$nova_per_total" data-per-encours="$nova_per_encours"
      data-per-suite="$nova_per_suite" data-per-suite1="$nova_per_suite1" data-per-examens-oui="$nova_per_examens_oui" data-per-examens-non="$nova_per_examens_non"></div>
  !endif
!endif
!reset nova_bdg nova_lf nova_lp nova_lc nova_lr nova_fo nova_po nova_ct nova_n nova_i nova_nv nova_bnom nova_bp nova_bm
!read classlogo.phtml
