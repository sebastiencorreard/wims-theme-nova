!read themes/$wims_theme/lang/suivi.phtml.$lang
<section id="nova-suivi" aria-labelledby="nova-suivi-titre">
  <div class="nova-suivi-haut">
    <div><h1 id="nova-suivi-titre">$nova_sv_titre</h1><p id="nova-suivi-sous-titre">$nova_sv_sous_titre</p></div>
    <div class="nova-suivi-actions">
      <p id="nova-suivi-etat" role="status">$nova_sv_chargement</p>
      <label class="nova-suivi-auto"><input id="nova-suivi-auto" type="checkbox" checked> <span id="nova-suivi-auto-libelle">$nova_sv_actualiser</span></label>
      <button type="button" id="nova-suivi-actualiser" class="wims_button wims_secondary_button">$nova_sv_actualiser</button>
      <button type="button" id="nova-suivi-reglages" class="wims_button wims_secondary_button" aria-haspopup="dialog">$nova_sv_reglages</button>
      <span hidden id="nova-suivi-refresh">
      !href module=home&nova_suivi=1 $nova_sv_actualiser
      </span>
    </div>
  </div>
  <div id="nova-suivi-commandes" hidden>
    <div id="nova-suivi-compteurs" class="nova-suivi-puces" role="group" aria-label="$nova_sv_afficher"></div>
    <input type="hidden" id="nova-suivi-filtre" value="actifs">
    <div class="nova-suivi-cherche">
      <input id="nova-suivi-recherche" type="search" placeholder="$nova_sv_recherche" aria-label="$nova_sv_recherche_aide">
      <label id="nova-suivi-classe-bloc" hidden><span class="nova-suivi-cache">$nova_sv_classe</span><select id="nova-suivi-classe"><option value="">$nova_sv_toutes</option></select></label>
    </div>
  </div>
  <div class="nova-suivi-tableau"><table id="nova-suivi-table"><caption class="nova-suivi-cache">$nova_sv_legende</caption><thead><tr><th scope="col">$nova_sv_col_situation</th><th scope="col">$nova_sv_col_eleve</th><th scope="col">$nova_sv_col_exercice</th><th scope="col">$nova_sv_col_notes</th><th scope="col">$nova_sv_col_action</th><th scope="col"><span class="nova-suivi-cache">$nova_sv_col_chrono</span></th></tr></thead><tbody></tbody></table></div>
  <p id="nova-suivi-vide" hidden>$nova_sv_vide</p>
  <p class="nova-suivi-aide">$nova_sv_aide</p>
  <dialog id="nova-suivi-panneau" class="nova-dialogue" aria-labelledby="nova-suivi-panneau-titre">
    <h2 id="nova-suivi-panneau-titre">$nova_sv_panneau_titre</h2>
    <button type="button" id="nova-suivi-fermer" class="nova-suivi-fermer" aria-label="$nova_sv_fermer">×</button>
    <p class="nova-suivi-aide">$nova_sv_panneau_aide</p>
    <div class="nova-suivi-regle" role="group" aria-labelledby="nova-suivi-r-seance">
      <strong id="nova-suivi-r-seance">$nova_sv_seance</strong>
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_1
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_2
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_3
    </div>
    <div class="nova-suivi-regle" role="group" aria-labelledby="nova-suivi-r-difficulte">
      <span id="nova-suivi-r-difficulte" class="nova-suivi-tag nova-suivi-tag-difficulte">$nova_svj_difficulte</span>
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_4
    </div>
    <div class="nova-suivi-regle" role="group" aria-labelledby="nova-suivi-r-attente">
      <span id="nova-suivi-r-attente" class="nova-suivi-tag nova-suivi-tag-attente">$nova_svj_attente</span>
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_5
    </div>
    <div class="nova-suivi-regle" role="group" aria-labelledby="nova-suivi-r-repetition">
      <span id="nova-suivi-r-repetition" class="nova-suivi-tag nova-suivi-tag-repetition">$nova_svj_repetition</span>
      !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_6
    </div>
    <div class="nova-suivi-panneau-bas">
      <button type="button" id="nova-suivi-defauts" class="wims_button wims_secondary_button">$nova_sv_defauts</button>
      <button type="button" id="nova-suivi-fermer-bas" class="wims_button">$nova_sv_fermer</button>
    </div>
  </dialog>
  <noscript><p>$nova_sv_noscript</p></noscript>
  !read themes/$wims_theme/lang/suivi-textes.phtml.$lang suivi_7
</section>
!set nova_sid=!text select char abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_ in $wims_session
!if $nova_sid=$wims_session
  !sh perl $wims_home/public_html/themes/$wims_theme/_procs/suivi.pl $nova_sid --render
  !read wimshome/sessions/$nova_sid/nova-suivi.phtml
!endif
!reset nova_sid
<div id="nova-suivi-avatar-script" hidden data-script="themes/$wims_theme/js/avatar.js"></div>
<script src="html/themes/$wims_theme/js/suivi.js?v=10" defer></script>
