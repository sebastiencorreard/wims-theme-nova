!if $module = home
  !set w_path = ./adm/
!else
  !set w_path = $empty
!endif
<!-- begin of standard/header.phtml -->
!read themes/Nova/_widgets/accent.phtml
!read themes/Nova/_widgets/couleurs-notes.phtml

!! Nova : reglages du thème pour tout le site (2026-10-06, demande de l'utilisateur), dans log/nova.conf
!! (declarations CSS --nova-...). Enregistres depuis la page Apparence de la maintenance, par le gestionnaire
!! seulement ($wims_ismanager=2, calcule par WIMS).
!! Parametres inconnus du module : WIMS n'en fait pas des variables, et $httpd_QUERY_STRING est celui de la
!! connexion (restitue par la session) : la requete en cours est lue dans l'environnement du processus.
!if $module=adm/manage and $wims_ismanager=2
  !set nova_q=!sh printf '%s' "$$QUERY_STRING"
  !set nova_q=!replace internal & by $ $ in $nova_q
  !set nova_reglages=!getopt nova_reglages in $nova_q
  !set nova_animations=!getopt nova_animations in $nova_q
  !set nova_entree_directe=!getopt nova_entree_directe in $nova_q
  !set nova_clavier_maths=!getopt nova_clavier_maths in $nova_q
  !reset nova_q
!endif
!if $module=adm/manage and $wims_ismanager=2 and $nova_reglages=enregistrer
  !bound nova_animations within oui,non default non
  !bound nova_entree_directe within oui,non default oui
  !bound nova_clavier_maths within oui,non default non
  !writefile wimshome/log/nova.conf --nova-animations: $nova_animations;
  !appendfile wimshome/log/nova.conf --nova-entree-directe: $nova_entree_directe;
  !appendfile wimshome/log/nova.conf --nova-clavier-maths: $nova_clavier_maths;
  !set nova_app_fait=yes
!endif
!! Lecture seulement la ou wimshome/log est lisible (module home et adm/...) ; ailleurs, nova.js reprend la
!! derniere valeur lue (sessionStorage).
!set nova_m=!char 1 to 4 of $module
!if $module=home or $nova_m=adm/
  !set nova_site=!sh if test -r $wims_home/log/nova.conf; then cat $wims_home/log/nova.conf; fi
  !if $nova_site!=$empty
<script type="text/plain" id="nova-css-site">$nova_site</script>
  !endif
!endif
!! Page Apparence (configuration du site, rubrique 1) : carte « Reglages de Nova » et reglages de WIMS sans effet
!! avec Nova (repères par leur nom dans lang/confdata, leur rang donne le champ conf_N). Placees par nova.js.
!if $module=adm/manage and $wims_ismanager=2 and $job=conf and $confcat=1
  !read themes/Nova/_widgets/apparence.phtml
!endif
!! Page Apparence de la configuration d'une classe, d'un groupement ou d'un portail : meme carte, ecrite dans
!! la feuille de style de la classe (js/nova.js, apparenceClasse). WIMS ne montre cette page qu'a qui en a le droit.
!if $module=adm/class/config and $wims_user!=$empty and $wims_class!=$empty
  !read themes/Nova/_widgets/apparence-classe.phtml
!endif
!reset nova_m nova_site
!! Header menu bar definition.
!nocache
!set wims_theme_header=yes
!set jquery_defined=yes

!default wims_theme_icon=$class_theme_icon
!default wims_theme_icon=wimsedu

!if _help isin $wims_session
  <div id="wimsmhelp">
!endif

!if _exam isin $wims_session
  <div id="wimsexam">
!endif

!if $wims_lightpopup=yes
  <div id="wimslightpopup">
   <link rel="stylesheet" href="html/themes/_css/light.css">
!endif

!set wims_theme_version=1
!set current_module=!replace / by , in $module
!set module_path= !item 1 of $current_module

!! Nova : la deconnexion d'un eleve (lien de html/headmenu_user.phtml) ramene a la page de connexion de sa
!! classe, ou de son portail ou groupement ($wims_superclass), au lieu de la liste des classes (demande de
!! l'utilisateur, 2026-10-05), identifiant pre-rempli (auth_user). WIMS ferme la session (cmd=close) et
!! ouvre cette page dans la meme requete.
!! Pas pour une classe a authentification CAS (lien different, laisse tel quel).
!if $wims_class!=$empty and $wims_user!=supervisor and $wims_user!=$empty and anonymous notin $wims_user and $class_cas_auth=$empty
  !set nova_entree=$wims_superclass
  !default nova_entree=$wims_class
  !set wims_link_close=!replace internal cmd=close&module=adm/class/classes&type=participant by cmd=close&module=adm/class/classes&type=authparticipant&class=$nova_entree&auth_user=$wims_user in $wims_link_close
!endif

!! Nova : classe (ou portail, groupement) en authentification CAS, page de connexion sans session : adresse de
!! connexion CAS de la classe (comme le bouton « Entrer » de la liste des classes, participant2.phtml), pour que
!! nova.js (reconnexionCas) y renvoie l'eleve qui vient de terminer une session d'examen ; le CAS, qui le
!! connait encore, le ramene dans la classe (demande de l'utilisateur, 2026-10-06).
!if $module=adm/class/classes and $type=authparticipant and $wims_user=$empty and $class!=$empty
  !set nova_ss=!replace internal / by , in $class
  !set nova_ss=$(nova_ss[1])
  !set nova_idp=!defof class_authidp in wimshome/log/classes/$nova_ss/.def
  !set nova_idp=$(nova_idp[1;])
  !if $nova_idp=cas
    !set nova_cas=!defof class_cas_auth in wimshome/log/classes/$nova_ss/.def
    !default nova_cas=!defof cas_auth in wimshome/log/wims.conf
    !if $nova_cas!=$empty
      !! Adresse de retour encodee par nova.js : adm/codeurl de WIMS depend de liburi-perl (absent ici, adresse vide).
      <span id="nova-cas" hidden data-cas="$nova_cas" data-service="$wims_ref_name?module=adm/class/classes&amp;type=authparticipant&amp;class=$class"></span>
    !endif
  !endif
  !reset nova_ss nova_idp nova_cas
!endif

!if $[$wims_home_items_cnt + $wims_hm_cnt + $wims_link_close_cnt]!=0 or ($module_path notitemof home,adm,classes and _exam notin $session and $module_init_parm == $empty)
  !if $module!=home or $wims_user!=
    <div id="wimstopbox">
    !distribute items span into div1
    <div class="wimsmenu menu float_left">
    !read themes/Nova/_widgets/headhome.phtml
    !! Nova : le nom de la classe a cote de l'accueil (pas pendant un examen : place au chronometre).
    !if $wims_classname!=$empty and _exam notin $wims_session
      <span class="nova-classe">$wims_classname</span>
    !endif
    !read themes/Nova/_widgets/examencours.phtml
    !! Nova : marque des participants (eleves) : fil d'Ariane masque, bouton Retour (js/nova.js).
    !read themes/Nova/_procs/eleve.proc
    !if $nova_est_eleve=yes
      <span id="nova-eleve" hidden></span>
    !endif
    </div>
    !distribute items li into div1
    !read themes/Nova/_widgets/user_links.phtml
    <div class="wimsmenu menu">
    !!read themes/_widgets/headmenu.phtml
    !!read themes/_widgets/about.phtml
    !if _help notin $wims_session
      !distribute items div,span into div0,div1
!!## technical parameters FIXME, should be elsewere
      !if $class_cas_auth=$empty
        !set m_init_parm=!replace internal & by $ $ in $module_init_parm
        !set class_cas_auth=!getopt class_auth in $m_init_parm
      !endif
      !if $class_cas_auth!=$empty and $wims_class=$empty
        <$div1 class="menuitem">
        !read adm/class/logout_cas
        </$div1>
      !endif
    !endif
    </div><!--wimsmenu-->
    <br class="clearall">
    !reset div1
    </div><!--wimstopbox-->
    !if _light notin $wims_session
      !read themes/Nova/_widgets/ariane.phtml
    !endif
  !endif
!endif

!if $module!=home or $wims_user!=
  <div id="wimsbodybox">
    <div id="wimspagebox">
!endif

!read themes/_widgets/alertchat.phtml

<!-- end of standard/header.phtml -->
