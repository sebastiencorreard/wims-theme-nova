!! Lu par header.phtml : gestionnaire du site ($module=adm/manage et $wims_ismanager=2).
!! Nova : reglages du thème pour tout le site (2026-10-06, demande de l'utilisateur), dans log/nova.conf
!! (declarations CSS --nova-...). Enregistres depuis la page Apparence de la maintenance, par le gestionnaire
!! seulement ($wims_ismanager=2, calcule par WIMS).
!! Parametres inconnus du module : WIMS n'en fait pas des variables, et $httpd_QUERY_STRING est celui de la
!! connexion (restitue par la session) : la requete en cours est lue dans l'environnement du processus.
!read themes/$wims_theme/lang/reglages.phtml.$lang
!set nova_q=!sh printf '%s' "$$QUERY_STRING"
!set nova_q=!replace internal & by $ $ in $nova_q
!set nova_reglages=!getopt nova_reglages in $nova_q
!set nova_animations=!getopt nova_animations in $nova_q
!set nova_entree_directe=!getopt nova_entree_directe in $nova_q
!set nova_clavier_maths=!getopt nova_clavier_maths in $nova_q
!set nova_badges=!getopt nova_badges in $nova_q
!set nova_mq_c=!getopt nova_masque_communication in $nova_q
!set nova_mq_l=!getopt nova_masque_liens in $nova_q
!set nova_activite=!getopt nova_activite in $nova_q
!set nova_fil=!getopt nova_fil in $nova_q
!set nova_deco=!getopt nova_deco in $nova_q
!set nova_act_s=!getopt nova_activite_seuil in $nova_q
!set nova_act_o=!getopt nova_activite_objectif in $nova_q
!set nova_act_h=!getopt nova_activite_heures in $nova_q
!set nova_act_n=!getopt nova_activite_notes in $nova_q
!! Reglages « Rapprocher du theme standard » (2026-10-07) : une declaration par reglage, ecrite plus bas.
!reset nova_sd
!for nova_k in menus,navigation,reponse,examens,textes,listes,menu_complet,dominos,tableaux
  !set nova_sv=!getopt nova_s_$nova_k in $nova_q
  !bound nova_sv within oui,non default non
  !set nova_kh=!replace internal _ by - in $nova_k
  !set nova_sd=$nova_sd --nova-std-$nova_kh: $nova_sv;
!next nova_k
!reset nova_k nova_sv nova_kh
!reset nova_q
!if $nova_reglages=enregistrer
  !bound nova_animations within oui,non default non
  !bound nova_entree_directe within oui,non default oui
  !bound nova_clavier_maths within oui,non default non
  !bound nova_badges within oui,non default non
  !! Rubriques masquees aux eleves (2026-10-08) : remplace --nova-communication-eleves.
  !reset nova_mq
  !if $nova_mq_c=oui
    !set nova_mq=communication
  !endif
  !if $nova_mq_l=oui
    !set nova_mq=$nova_mq liens
  !endif
  !default nova_mq=aucune
  !writefile wimshome/log/nova.conf --nova-animations: $nova_animations;
  !appendfile wimshome/log/nova.conf --nova-entree-directe: $nova_entree_directe;
  !appendfile wimshome/log/nova.conf --nova-clavier-maths: $nova_clavier_maths;
  !appendfile wimshome/log/nova.conf --nova-badges: $nova_badges;
  !appendfile wimshome/log/nova.conf --nova-masques-eleves: $nova_mq;
  !appendfile wimshome/log/nova.conf --nova-fil-fixe: $nova_fil;
  !appendfile wimshome/log/nova.conf --nova-decorations: $nova_deco;
  !! Page « Mon activite » (2026-10-08) : objectif au moins egal au seuil d'encouragement.
  !bound nova_activite within oui,non default oui
  !bound nova_fil within oui,non default oui
  !bound nova_deco within oui,non default oui
  !bound nova_act_s between 1 and 7 default 2
  !bound nova_act_o between 1 and 7 default 3
  !bound nova_act_h between 1 and 80 default 6
  !bound nova_act_n between 1 and 20 default 5
  !set nova_act_s=$[floor($nova_act_s)]
  !set nova_act_o=$[floor($nova_act_o)]
  !set nova_act_h=$[floor($nova_act_h)]
  !set nova_act_n=$[floor($nova_act_n)]
  !ifval $nova_act_o<$nova_act_s
    !set nova_act_o=$nova_act_s
  !endif
  !appendfile wimshome/log/nova.conf --nova-activite: $nova_activite; --nova-activite-seuil: $nova_act_s; --nova-activite-objectif: $nova_act_o; --nova-activite-heures: $nova_act_h; --nova-activite-notes: $nova_act_n;
  !appendfile wimshome/log/nova.conf $nova_sd
  !set nova_app_fait=yes
!endif
