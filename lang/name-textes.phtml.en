!! Nova : textes de nova.js en clair (en), lus par !read themes/$wims_theme/lang/name-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:avatar_barre
!! _widgets/avatar-barre.phtml
<div id="nova-avatar-barre" hidden data-actif="$nova_avb" data-choix="$nova_avc" data-jetons="$nova_avj" data-script="themes/$wims_theme/js/avatar.js" data-titre="My avatar" data-t-jeton="%n coin" data-t-jetons="%n coins"></div>
!exit

:headmenu_1
!! _widgets/headmenu.phtml
    <div class="nova-chrono" data-etat="normal" data-texte-5min="Less than 5 minutes left" data-texte-1min="Last minute" data-texte-fin="Time is up" data-texte-fin-detail="Answers sent now will not be taken into account." data-texte-fin-a="Ends at">
!exit

:headmenu_2
!! _widgets/headmenu.phtml
<span id="nova-textes" hidden data-texte-mes-badges="$nova_badges_titre" data-texte-consigne-dominos="Drag each domino into a box, or tap a domino and then a box." data-texte-paysage="Turn your phone sideways (landscape) to see the dominoes better." data-texte-consigne-tuiles="Drag each label into a box, or tap a label and then a box." data-texte-consigne-associer="Tap an item on the left, then the matching item on the right." data-texte-deposer="Drop here" data-texte-indisponible-examen="Not available during an exam" data-texte-fermer="Close" data-texte-en-ligne="Online" data-texte-rubrique-reglages="$nova_rg_rubrique" data-texte-rubrique-reglages-aide="(Nova theme: display, students, WIMS homework, badges, advanced settings)" data-texte-nouveau="New" data-libelle="$nova_chrono_libelle" data-texte-5min="Less than 5 minutes left" data-texte-1min="Last minute" data-texte-fin="Time is up" data-texte-fin-detail="Answers sent now will not be taken into account." data-texte-fin-detail-exo="$nova_chrono_fin_detail_exo" data-profil="Profile" data-plus="More" data-retour="Back" data-terminer="Finish" data-fin-session="You have finished." data-fin-session-detail="Click on Finish to close this session: you will then be able to start another exam. You will be logged out." data-terminer-impossible="Answer at least one exercise before ending the session: as long as no answer has been sent, WIMS cannot close it." data-car-prec="Previous example" data-car-suiv="Next example" data-car-pause="Stop scrolling" data-car-lecture="Resume scrolling" data-car-diapo="Example %n of %t" data-car-titre="Examples" data-exo-suivant="Next exercise" data-revenir-liste="Back to the list" data-parcours="Exercise %n of %t" data-parcours-reussi="passed" data-parcours-a-faire="to do" data-parcours-en-cours="in progress" data-parcours-note="scored" data-parcours-termine="finished" data-parcours-question="Question %n of %t" data-parcours-titre="Course progress" data-valider="Submit" data-bonne="Correct answer" data-bonnes="Correct answers" data-mauvaise="Wrong answer" data-bonne-etait="the correct answer was" data-texte-propager-apparence="Nova settings: display, students, advanced settings" data-texte-propager-badges="Nova settings: WIMS homework, badges and rewards" data-texte-propager-tout="Select all" data-texte-propager-rien="Clear all" data-juste-sur="%1 correct answer out of %2" data-justes-sur="%1 correct answers out of %2" data-partielle="Partly correct answer" data-precision="Not precise enough" data-votre-reponse="Your answer:" data-mdp-afficher="Show password" data-mdp-masquer="Hide password" data-texte-autre-examen="You must finish the exam in progress before starting another one. Click the button below." data-texte-examen="$nova_examen_court" data-texte-examen-encours="$nova_examencours" data-texte-clavier="Math keyboard" data-texte-clavier-suivant="Next" data-texte-clavier-ok="Submit" data-texte-clavier-abc="Phone keyboard" data-texte-clavier-123="Math keyboard" data-texte-clavier-effacer="Delete" data-texte-clavier-gauche="Move left" data-texte-clavier-droite="Move right" data-texte-clavier-carre="Squared" data-texte-clavier-cube="Cubed" data-texte-clavier-racine="Square root" data-texte-clavier-puissance10="Times ten to the power" data-texte-signe-croix="session with no recorded duration (still running, or interrupted before being finished)" data-texte-signe-inconnu="exercise with no score in this session (not opened, or opened without an answer sent)" data-texte-masquer-moyenne="Hide the average" data-texte-titres-examens="Exams: show the title instead of the number" data-texte-titres-feuilles="Worksheets: show the title instead of the number" data-choix-juste="chosen, correct" data-choix-faux="chosen by mistake" data-choix-oublie="missed: it should have been chosen" data-choix-pris="chosen" data-choix-a-tort="%1 answer chosen by mistake" data-choix-a-torts="%1 answers chosen by mistake" data-choix-manque="%1 answer missing" data-choix-manques="%1 answers missing" data-texte-dm-note="Create the graded homework" data-texte-dm-note-aide="Copy of this exam, same exercises, %1 sessions, kept in preparation" data-texte-dm-note-encours="Creating..." data-texte-dm-note-mot="graded" data-texte-dm-note-fait="Graded homework created: "%1". It stays in preparation: check it, then activate it."></span>
!exit

:menu_bascule
!! _widgets/menu-bascule.phtml
<span id="nova-menu-bascule" hidden data-simplifie="Simplified menu"
  data-personnaliser="Choose menu items" data-termine="Done" data-defaut="Back to the default menu"
  data-cacher="Hide" data-montrer="Show" data-consigne="Click the eye of an item to keep or hide it." data-rien="No hidden item yet"></span>
!exit

:replis_classes
!! _widgets/replis-classes.phtml
<span id="nova-replis" hidden data-valeur="$nova_rv" data-replier="Fold the %1 classes" data-replier1="Fold the class" data-afficher="Show the %1 classes" data-afficher1="Show the class"></span>
!exit

:header
!! header.phtml
  <template id="nova-liens-textes" data-type="$class_type" data-qr-script="themes/$wims_theme/js/qrcode.js" data-script-flyers="themes/$wims_theme/js/flyers.js" data-nom="$wims_classname" data-flyers="Printable flyers (PDF)" data-fl-nom="Class name on the flyers" data-fl-aide="An A4 page of 30 flyers to cut out: one per student, to stick in their notebook." data-agrandir="Enlarge" data-telecharger="Download" data-fermer="Close" data-qr-alt="QR code of the link for your students" data-vous="Link for you" data-vous-aide="Opens the teacher login: worksheets, exams, students and their scores. Keep it in your bookmarks." data-eleves="Link for your students" data-eleves-aide="To register in the class, or to enter it once registered. Share it on your school platform or on the board." data-eleves-aide-s="To register in a class, or to enter it once registered. Share it on your school platform or on the board." data-qr="QR code to show in class: students scan it with their phone." data-ens="Link for teachers" data-ens-aide="For teachers to enter their classes." data-insc="Teacher registration" data-insc-aide="For a teacher to create their account." data-copier="Copy" data-copie="Copied" data-copier-num="Copy the number" data-echec="Cannot copy: select the link and copy it." data-numero="Class number" data-numero-s="Structure number" data-numero-aide="Keep it too: it lets you find it from the WIMS home page."></template>
!exit
