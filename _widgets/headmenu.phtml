!default div1=div
<!-- Nova/_widgets/headmenu.phtml -->
!! Copie de themes/_widgets/headmenu.phtml : écrit les entrées de la barre du haut ($wims_hm,
!! préparées par html/headmenu*.phtml). Seule différence : l'entrée « chrono » (session d'examen,
!! html/headmenu_user.phtml) devient le chronomètre de Nova. Son contenu WIMS - le span
!! #chrono_exam et le script clockid() qui le fait décompter et recharge la fenêtre parente - est
!! écrit tel quel à l'intérieur ; js/nova.js lit le décompte et pose les états (data-etat).
!! Textes : lang/name.phtml.<langue> du thème, lus par html/headmenu*.phtml.
!default nova_chrono_libelle=Time left
!default nova_chrono_fin_detail_exo=You can still finish the exercise, but the score goes down as time passes.
!default nova_chrono_fin_detail_exo0=An answer sent now will score 0.
!! Exercice OEF chronom�tr� (scoredelay=d1,d2, scripts/oef/var.proc) : apr�s d1 (fin du d�compte), la note baisse
!! avec le retard et vaut 0 � d2. Si d2 = d1, une r�ponse tardive vaut 0 tout de suite (2026-11-03, utilisateur).
!if 0$delay2<=0$delay1
  !set nova_chrono_fin_detail_exo=$nova_chrono_fin_detail_exo0
!endif
!for i_=1 to $wims_hm_cnt
  !set 1_=!line $i_ of $wims_hm
  !set wims_ref_class = !item 1 of $1_
  !if " isin $wims_ref_class
    !reset wims_ref_class
  !endif
  !if $wims_ref_class=chrono
    <$div1 class="menuitem chrono">
    !read themes/$wims_theme/lang/name-textes.phtml.$lang headmenu_1
      <svg class="nova-chrono-icone" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2.5M9 2h6"></path></svg>
      <span class="nova-chrono-libelle">$nova_chrono_libelle</span>
      <span class="nova-chrono-temps" role="timer" aria-label="$nova_chrono_libelle">
      !read $(w_path)oneitem.phtml $1_
      </span>
    </div>
    </$div1>
  !else
    <$div1 class="menuitem $wims_ref_class">
    !read $(w_path)oneitem.phtml $1_
    </$div1>
  !endif
  !reset wims_ref_class
!next i_
!! Textes du thème pour js/nova.js, utiles aussi hors de la fenêtre d'exercice (page de l'examen,
!! où le chronomètre est recopié depuis la page ; section « Profil »).
!read themes/$wims_theme/lang/name-textes.phtml.$lang headmenu_2
<!-- end Nova/_widgets/headmenu.phtml -->
