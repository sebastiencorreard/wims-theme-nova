!! Nova : textes de nova.js en clair (fr), lus par !read themes/$wims_theme/lang/name-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:avatar_barre
!! _widgets/avatar-barre.phtml
<div id="nova-avatar-barre" hidden data-actif="$nova_avb" data-choix="$nova_avc" data-jetons="$nova_avj" data-script="themes/$wims_theme/js/avatar.js" data-titre="Mon avatar" data-t-jeton="%n pièce" data-t-jetons="%n pièces"></div>
!exit

:headmenu_1
!! _widgets/headmenu.phtml
    <div class="nova-chrono" data-etat="normal" data-texte-5min="Moins de 5 minutes" data-texte-1min="Dernière minute" data-texte-fin="Temps écoulé" data-texte-fin-detail="Les réponses envoyées maintenant ne seront pas prises en compte." data-texte-fin-a="Fin à">
!exit

:headmenu_2
!! _widgets/headmenu.phtml
<span id="nova-textes" hidden data-texte-mes-badges="$nova_badges_titre" data-texte-consigne-dominos="Glissez chaque domino dans une case, ou touchez un domino puis une case." data-texte-paysage="Tournez votre téléphone en mode paysage pour mieux voir les dominos." data-texte-consigne-tuiles="Glissez chaque étiquette dans une case, ou touchez une étiquette puis une case." data-texte-consigne-associer="Touchez un élément à gauche, puis celui qui lui correspond à droite." data-texte-deposer="Déposer ici" data-texte-indisponible-examen="Non disponible pendant un examen" data-texte-fermer="Fermer" data-texte-en-ligne="En ligne" data-texte-rubrique-reglages="$nova_rg_rubrique" data-texte-rubrique-reglages-aide="(thème Nova : affichage, élèves, DM WIMS, badges, réglages avancés)" data-texte-nouveau="New" data-libelle="$nova_chrono_libelle" data-texte-5min="Moins de 5 minutes" data-texte-1min="Dernière minute" data-texte-fin="Temps écoulé" data-texte-fin-detail="Les réponses envoyées maintenant ne seront pas prises en compte." data-texte-fin-detail-exo="$nova_chrono_fin_detail_exo" data-profil="Profil" data-plus="Plus" data-retour="Retour" data-terminer="Terminer" data-fin-session="Vous avez terminé." data-fin-session-detail="Cliquez sur « Terminer » pour clore la session : vous pourrez ensuite commencer un autre examen ou une autre course. Vous serez déconnecté(e)." data-terminer-impossible="Répondez à au moins un exercice avant de terminer la session : tant qu'aucune réponse n'est envoyée, WIMS ne peut pas la clore." data-car-prec="Exemple précédent" data-car-suiv="Exemple suivant" data-car-pause="Arrêter le défilement" data-car-lecture="Relancer le défilement" data-car-diapo="Exemple %n sur %t" data-car-titre="Exemples" data-exo-suivant="Exercice suivant" data-revenir-liste="Revenir à la liste" data-parcours="Exercice %n sur %t" data-parcours-reussi="réussi" data-parcours-a-faire="à faire" data-parcours-en-cours="en cours" data-parcours-note="noté" data-parcours-termine="terminé" data-parcours-question="Question %n sur %t" data-parcours-titre="Progression du parcours" data-valider="Valider" data-bonne="Bonne réponse" data-bonnes="Bonnes réponses" data-mauvaise="Mauvaise réponse" data-bonne-etait="la bonne réponse était" data-texte-propager-apparence="Réglages de Nova : affichage, élèves, réglages avancés" data-texte-propager-badges="Réglages de Nova : DM WIMS, badges et récompenses" data-texte-propager-tout="Tout cocher" data-texte-propager-rien="Tout décocher" data-juste-sur="%1 réponse juste sur %2" data-justes-sur="%1 réponses justes sur %2" data-partielle="Réponse partiellement juste" data-precision="Précision insuffisante" data-votre-reponse="Votre réponse :" data-mdp-afficher="Afficher le mot de passe" data-mdp-masquer="Masquer le mot de passe" data-texte-autre-examen="Vous devez terminer l'examen en cours avant d'en commencer un autre. Cliquez sur le bouton ci-dessous." data-texte-examen="$nova_examen_court" data-texte-examen-encours="$nova_examencours" data-texte-clavier="Clavier mathématique" data-texte-clavier-suivant="Suivant" data-texte-clavier-ok="Valider" data-texte-clavier-abc="Clavier du téléphone" data-texte-clavier-123="Clavier mathématique" data-texte-clavier-effacer="Effacer" data-texte-clavier-gauche="Vers la gauche" data-texte-clavier-droite="Vers la droite" data-texte-clavier-carre="Au carré" data-texte-clavier-cube="Au cube" data-texte-clavier-racine="Racine carrée" data-texte-clavier-puissance10="Fois dix puissance" data-texte-signe-croix="session sans durée enregistrée (en cours, ou interrompue sans être terminée)" data-texte-signe-inconnu="exercice sans note dans cette session (pas ouvert, ou ouvert sans réponse envoyée)" data-texte-masquer-moyenne="Masquer la moyenne" data-texte-titres-examens="Examens : afficher le titre au lieu du numéro" data-texte-titres-feuilles="Feuilles : afficher le titre au lieu du numéro" data-choix-juste="choisi, juste" data-choix-faux="choisi à tort" data-choix-oublie="oublié : il fallait le choisir" data-choix-pris="choisi" data-choix-a-tort="%1 réponse choisie à tort" data-choix-a-torts="%1 réponses choisies à tort" data-choix-manque="il manque %1 réponse" data-choix-manques="il manque %1 réponses" data-texte-dm-note="Créer le DM noté" data-texte-dm-note-aide="Copie de cet examen, mêmes exercices, %1 sessions, laissée en préparation" data-texte-dm-note-encours="Création..." data-texte-dm-note-mot="noté" data-texte-dm-note-fait="DM noté créé : « %1 ». Il reste en préparation : vérifiez-le, puis activez-le."></span>
!exit

:menu_bascule
!! _widgets/menu-bascule.phtml
<span id="nova-menu-bascule" hidden data-simplifie="Menu simplifié"
  data-personnaliser="Choisir les entrées du menu" data-termine="Terminé" data-defaut="Revenir au menu par défaut"
  data-cacher="Cacher" data-montrer="Montrer" data-consigne="Cliquez sur l'&oelig;il d'une entrée pour la garder ou la cacher." data-rien="Aucune entrée cachée pour le moment"></span>
!exit

:replis_classes
!! _widgets/replis-classes.phtml
<span id="nova-replis" hidden data-valeur="$nova_rv" data-replier="Replier les %1 classes" data-replier1="Replier la classe" data-afficher="Afficher les %1 classes" data-afficher1="Afficher la classe"></span>
!exit

:header
!! header.phtml
  <template id="nova-liens-textes" data-type="$class_type" data-qr-script="themes/$wims_theme/js/qrcode.js" data-script-flyers="themes/$wims_theme/js/flyers.js" data-nom="$wims_classname" data-flyers="Flyers à imprimer (PDF)" data-fl-nom="Nom de la classe sur les flyers" data-fl-aide="Une page A4 de 30 flyers à découper : un par élève, à coller dans le cahier." data-agrandir="Agrandir" data-telecharger="Télécharger" data-fermer="Fermer" data-qr-alt="QR code du lien pour vos élèves" data-vous="Lien pour vous" data-vous-aide="Ouvre la connexion enseignant : feuilles, examens, élèves et leurs notes. Gardez-le dans vos favoris." data-eleves="Lien pour vos élèves" data-eleves-aide="Pour s'inscrire dans la classe ou y entrer une fois inscrits. À donner sur l'ENT ou au tableau." data-eleves-aide-s="Pour s'inscrire dans une classe ou y entrer une fois inscrits. À donner sur l'ENT ou au tableau." data-qr="QR code à projeter en classe : les élèves le scannent avec leur téléphone." data-ens="Lien pour les enseignants" data-ens-aide="Pour que les enseignants entrent dans leurs classes." data-insc="Inscription des enseignants" data-insc-aide="Pour qu'un enseignant crée son compte." data-copier="Copier" data-copie="Copié" data-copier-num="Copier le numéro" data-echec="Copie impossible : sélectionnez le lien et copiez-le." data-numero="Numéro de la classe" data-numero-s="Numéro de la structure" data-numero-aide="À garder aussi : il permet de la retrouver depuis l'accueil de WIMS."></template>
!exit
