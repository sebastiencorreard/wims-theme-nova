!! Nova : liste des eleves des pages a Part. precedent / suivant (detail des examens, des notes, scores bruts, fiche
!! du participant, activite, travaux libres, variables techniques ; 2026-11-25, utilisateur). Lu par tail.phtml,
!! enseignant seulement. nova.js elevesListe en fait une colonne a droite, sur grand ecran seulement ; les liens
!! reprennent celui de Part. suivant de WIMS, autre eleve.
!! Variables : nova_xdc classe ou zone de la liste (3 premiers niveaux, comme scripts/adm/class/getnextuser),
!! nova_xdu eleve affiche (gn_st de getnextuser, filtre).
!set nova_xdc=!text select 0123456789/ in $wims_class
!set nova_xdc=!replace internal / by , in $nova_xdc
!if $(nova_xdc[4])!=$empty
  !set nova_xdc=!item 1 to 3 of $nova_xdc
!endif
!set nova_xdc=!replace internal , by / in $nova_xdc
!set nova_xdc=!nospace $nova_xdc
!set nova_xdu=!text select abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.@- in $gn_st
<ul id="nova-eleves" hidden data-courant="$nova_xdu">
!sh sh $wims_home/public_html/themes/$wims_theme/_procs/eleves-liste.sh "$wims_home" "$nova_xdc"
</ul>
!read themes/$wims_theme/lang/enseignant-textes.phtml.$lang examens_detail
!reset nova_xdc nova_xdu
