!! Nova : textes de nova.js en clair (es), lus par !read themes/$wims_theme/lang/name-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:avatar_barre
!! _widgets/avatar-barre.phtml
<div id="nova-avatar-barre" hidden data-actif="$nova_avb" data-choix="$nova_avc" data-jetons="$nova_avj" data-script="themes/$wims_theme/js/avatar.js" data-titre="Mi avatar" data-t-jeton="%n moneda" data-t-jetons="%n monedas"></div>
!exit

:headmenu_1
!! _widgets/headmenu.phtml
    <div class="nova-chrono" data-etat="normal" data-texte-5min="Quedan menos de 5 minutos" data-texte-1min="Último minuto" data-texte-fin="Se acabó el tiempo" data-texte-fin-detail="Las respuestas enviadas ahora no se tendrán en cuenta." data-texte-fin-a="Termina a las">
!exit

:headmenu_2
!! _widgets/headmenu.phtml
<span id="nova-textes" hidden data-texte-mes-badges="$nova_badges_titre" data-texte-consigne-dominos="Arrastra cada dominó a una casilla, o toca un dominó y luego una casilla." data-texte-paysage="Gira el teléfono (modo horizontal) para ver mejor los dominós." data-texte-consigne-tuiles="Arrastra cada etiqueta a una casilla, o toca una etiqueta y luego una casilla." data-texte-consigne-associer="Toca un elemento a la izquierda y luego el que le corresponde a la derecha." data-texte-deposer="Suelta aquí" data-texte-indisponible-examen="No disponible durante un examen" data-texte-fermer="Cerrar" data-texte-en-ligne="En línea" data-texte-rubrique-reglages="$nova_rg_rubrique" data-texte-rubrique-reglages-aide="(tema Nova: visualización, alumnos, deberes WIMS, insignias, ajustes avanzados)" data-texte-nouveau="Nuevo" data-libelle="$nova_chrono_libelle" data-texte-5min="Quedan menos de 5 minutos" data-texte-1min="Último minuto" data-texte-fin="Se acabó el tiempo" data-texte-fin-detail="Las respuestas enviadas ahora no se tendrán en cuenta." data-texte-fin-detail-exo="$nova_chrono_fin_detail_exo" data-profil="Perfil" data-plus="Más" data-retour="Volver" data-terminer="Terminar" data-fin-session="Has terminado." data-fin-session-detail="Haz clic en Terminar para cerrar esta sesión: después podrás empezar otro examen. Se cerrará tu sesión." data-terminer-impossible="Responde al menos a un ejercicio antes de terminar la sesión: mientras no se haya enviado ninguna respuesta, WIMS no puede cerrarla." data-car-prec="Ejemplo anterior" data-car-suiv="Ejemplo siguiente" data-car-pause="Detener el desfile" data-car-lecture="Reanudar el desfile" data-car-diapo="Ejemplo %n de %t" data-car-titre="Ejemplos" data-exo-suivant="Ejercicio siguiente" data-revenir-liste="Volver a la lista" data-parcours="Ejercicio %n de %t" data-parcours-reussi="superado" data-parcours-a-faire="por hacer" data-parcours-en-cours="en curso" data-parcours-note="calificado" data-parcours-termine="terminado" data-parcours-question="Pregunta %n de %t" data-parcours-titre="Progreso del recorrido" data-valider="Validar" data-bonne="Respuesta correcta" data-bonnes="Respuestas correctas" data-mauvaise="Respuesta incorrecta" data-bonne-etait="la respuesta correcta era" data-texte-propager-apparence="Ajustes de Nova: visualización, alumnos, ajustes avanzados" data-texte-propager-badges="Ajustes de Nova: deberes WIMS, insignias y recompensas" data-texte-propager-tout="Marcar todo" data-texte-propager-rien="Desmarcar todo" data-juste-sur="%1 respuesta correcta de %2" data-justes-sur="%1 respuestas correctas de %2" data-partielle="Respuesta parcialmente correcta" data-precision="Precisión insuficiente" data-votre-reponse="Tu respuesta:" data-mdp-afficher="Mostrar la contraseña" data-mdp-masquer="Ocultar la contraseña" data-texte-autre-examen="Debes terminar el examen en curso antes de empezar otro. Haz clic en el botón de abajo." data-texte-examen="$nova_examen_court" data-texte-examen-encours="$nova_examencours" data-texte-clavier="Teclado matemático" data-texte-clavier-suivant="Siguiente" data-texte-clavier-ok="Validar" data-texte-clavier-abc="Teclado del teléfono" data-texte-clavier-123="Teclado matemático" data-texte-clavier-effacer="Borrar" data-texte-clavier-gauche="Mover a la izquierda" data-texte-clavier-droite="Mover a la derecha" data-texte-clavier-carre="Al cuadrado" data-texte-clavier-cube="Al cubo" data-texte-clavier-racine="Raíz cuadrada" data-texte-clavier-puissance10="Por diez elevado a" data-texte-signe-croix="sesión sin duración registrada (todavía en curso, o interrumpida antes de terminar)" data-texte-signe-inconnu="ejercicio sin nota en esta sesión (no abierto, o abierto sin enviar respuesta)" data-texte-masquer-moyenne="Ocultar la media" data-texte-titres-examens="Exámenes: mostrar el título en lugar del número" data-texte-titres-feuilles="Hojas: mostrar el título en lugar del número" data-choix-juste="elegida, correcta" data-choix-faux="elegida por error" data-choix-oublie="olvidada: había que elegirla" data-choix-pris="elegida" data-choix-a-tort="%1 respuesta elegida por error" data-choix-a-torts="%1 respuestas elegidas por error" data-choix-manque="falta %1 respuesta" data-choix-manques="faltan %1 respuestas" data-texte-dm-note="Crear el deber calificado" data-texte-dm-note-aide="Copia de este examen, mismos ejercicios, %1 sesiones, que queda en preparación" data-texte-dm-note-encours="Creando..." data-texte-dm-note-mot="calificado" data-texte-dm-note-fait="Deber calificado creado: «%1». Queda en preparación: revísalo y luego actívalo."></span>
!exit

:menu_bascule
!! _widgets/menu-bascule.phtml
<span id="nova-menu-bascule" hidden data-simplifie="Menú simplificado"
  data-personnaliser="Elegir las entradas del menú" data-termine="Hecho" data-defaut="Volver al menú por defecto"
  data-cacher="Ocultar" data-montrer="Mostrar" data-consigne="Haga clic en el ojo de una entrada para mostrarla u ocultarla." data-rien="Ninguna entrada oculta por ahora"></span>
!exit

:replis_classes
!! _widgets/replis-classes.phtml
<span id="nova-replis" hidden data-valeur="$nova_rv" data-replier="Plegar las %1 clases" data-replier1="Plegar la clase" data-afficher="Mostrar las %1 clases" data-afficher1="Mostrar la clase"></span>
!exit

:header
!! header.phtml
  <template id="nova-liens-textes" data-type="$class_type" data-qr-script="themes/$wims_theme/js/qrcode.js" data-script-flyers="themes/$wims_theme/js/flyers.js" data-nom="$wims_classname" data-flyers="Folletos para imprimir (PDF)" data-fl-nom="Nombre de la clase en los folletos" data-fl-aide="Una página A4 con 30 folletos para recortar: uno por alumno, para pegar en el cuaderno." data-agrandir="Ampliar" data-telecharger="Descargar" data-fermer="Cerrar" data-qr-alt="Código QR del enlace para sus alumnos" data-vous="Enlace para usted" data-vous-aide="Abre la conexión de profesor: hojas, exámenes, alumnos y sus notas. Guárdelo en sus favoritos." data-eleves="Enlace para sus alumnos" data-eleves-aide="Para inscribirse en la clase o entrar en ella una vez inscritos. Compártalo en la plataforma educativa o en la pizarra." data-eleves-aide-s="Para inscribirse en una clase o entrar en ella una vez inscritos. Compártalo en la plataforma educativa o en la pizarra." data-qr="Código QR para proyectar en clase: los alumnos lo escanean con su teléfono." data-ens="Enlace para los profesores" data-ens-aide="Para que los profesores entren en sus clases." data-insc="Inscripción de los profesores" data-insc-aide="Para que un profesor cree su cuenta." data-copier="Copiar" data-copie="Copiado" data-copier-num="Copiar el número" data-echec="No se puede copiar: seleccione el enlace y cópielo." data-numero="Número de la clase" data-numero-s="Número de la estructura" data-numero-aide="Guárdelo también: permite encontrarla desde la página de inicio de WIMS."></template>
!exit
