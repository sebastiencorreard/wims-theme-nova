!! Hook natif des menus WIMS : suivi dans Participants, pour les profs/admins seulement.
!! Pas sur une page d'aide (cmd=help, session _mhelp) : WIMS n'y met pas de menu, le suivi s'y affichait seul (2026-10-08).
!if $wims_class!=$empty and $wims_user!=$empty and _exam notin $wims_session and _tool notin $wims_session and _mhelp notin $wims_session and $cmd!=help
  !if $wims_user=supervisor or yes isin $supervisable $user_supervisable or $wims_supervise!=$empty
    !if nova_suivi notin $wims_rm_0
      !default nova_menu_participants=Participants
      !set wims_name_nova_suivi=$nova_sv_titre
      !! Avatars des eleves (2026-11-12, utilisateur) : sous le suivi, seulement si l'avatar est active (comme avatar-barre.phtml).
      !set nova_avm=!sh cat $wims_home/log/nova.conf $wims_home/log/classes/$wims_superclass/css $wims_home/log/classes/$wims_class/css 2>/dev/null | tr ';{}' '\n\n\n' | grep -o -- '--nova-avatar[[:space:]]*:[[:space:]]*[a-z]*' | tail -n 1 | sed 's/.*://' | tr -cd 'a-z'
      !! Badges seuls (2026-11-12, utilisateur) : la page s'ouvre aussi quand l'avatar est coupe et les badges actifs ;
      !! nova_avm vaut alors « badges ». Titre : nova_avs_titre = « avatars, badges » (name.phtml).
      !if $nova_avm!=oui
        !set nova_avm=!sh cat $wims_home/log/nova.conf $wims_home/log/classes/$wims_superclass/css $wims_home/log/classes/$wims_class/css 2>/dev/null | tr ';{}' '\n\n\n' | grep -o -- '--nova-badges[[:space:]]*:[[:space:]]*[a-z]*' | tail -n 1 | sed 's/.*://' | tr -cd 'a-z'
        !if $nova_avm=oui
          !set nova_avm=badges
        !endif
      !endif
      !! Trombinoscope (2026-11-12, utilisateur : plus personne ne met de photos) : la page des avatars PREND LA PLACE du
      !! trombinoscope de WIMS (adm/class/photoboard, menu de la page des participants) et garde son nom ; son entree est
      !! retiree. Reglage « menus du theme standard » (--nova-std-menus: oui) : rien n'est remplace, les deux entrees restent.
      !reset nova_avr
      !if $nova_avm isitemof oui,badges
        !default nova_avs_titre=Students' avatars,Students' badges
        !set wims_name_nova_avatars=!item 1 of $nova_avs_titre
        !if $nova_avm=badges
          !set wims_name_nova_avatars=!item 2 of $nova_avs_titre
        !endif
        !set nova_avr=!sh cat $wims_home/log/nova.conf $wims_home/log/classes/$wims_superclass/css $wims_home/log/classes/$wims_class/css 2>/dev/null | tr ';{}' '\n\n\n' | grep -o -- '--nova-std-menus[[:space:]]*:[[:space:]]*[a-z]*' | tail -n 1 | sed 's/.*://' | tr -cd 'a-z'
        !if $nova_avr!=oui and $wims_name_photoboard!=$empty
          !set wims_name_nova_avatars=$wims_name_photoboard
          !set nova_avr=remplace
        !endif
      !endif
      !set nova_sp=0
      !set nova_sg=0
      !! Separateur sans titre en tete (adm/class/sequence...) : menumodubox.phtml le retire quand il est
      !! premier ; place apres Participants, il ouvrirait un groupe sans titre, range sous Participants.
      !set wims_rm_0=!nonempty line $wims_rm_0
      !! Tous : adm/class/config en a deux de suite (vecu le 2026-10-08, groupes de la configuration sous Participants).
      !set nova_sl=!line 1 of $wims_rm_0
      !while itemsep isitemof $(nova_sl[1]) and $(nova_sl[3])=$empty
        !set wims_rm_0=!line 2 to -1 of $wims_rm_0
        !set nova_sl=!line 1 of $wims_rm_0
      !endwhile
      !set nova_sc=!linecnt $wims_rm_0
      !for nova_si=1 to $nova_sc
        !set nova_sl=!line $nova_si of $wims_rm_0
        !if $(nova_sl[1])=itemsep
          !set nova_sg=$nova_si
          !if $(nova_sl[3])=$nova_menu_participants
            !set nova_sp=$nova_si
          !endif
        !else
          !if $(nova_sl[1]) isitemof usermanage,participantview and $nova_sp=0
            !set nova_sp=$nova_sg
          !endif
        !endif
      !next nova_si
      !reset nova_sr
      !if $nova_sp=0
        !set nova_sr=itemsep,0,$nova_menu_participants\
nova_suivi,1,module=home&nova_suivi=1
        !if $nova_avm isitemof oui,badges
          !set nova_sr=!append line nova_avatars,1,module=home&nova_avatars=1 to $nova_sr
        !endif
        !if $nova_sc>0
          !set nova_sl=!line 1 of $wims_rm_0
          !if $(nova_sl[1])!=itemsep
            !! Titre traduit du module (comme html/title.phtml), sinon son titre (souvent en anglais).
            !set nova_sn=!module title_$lang
            !default nova_sn=$module_title
            !default nova_sn=$wims_name_configuration
            !default nova_sn=Navigation
            !set nova_sr=!append line itemsep,0,$nova_sn to $nova_sr
          !endif
        !endif
      !endif
      !for nova_si=1 to $nova_sc
        !set nova_sl=!line $nova_si of $wims_rm_0
        !if $nova_si=$nova_sp
          !set nova_sr=!append line itemsep,0,$nova_menu_participants\
nova_suivi,1,module=home&nova_suivi=1 to $nova_sr
          !if $nova_avm isitemof oui,badges
            !set nova_sr=!append line nova_avatars,1,module=home&nova_avatars=1 to $nova_sr
          !endif
        !else
          !if $nova_avr!=remplace or $(nova_sl[1])!=photoboard
            !set nova_sr=!append line $nova_sl to $nova_sr
          !endif
        !endif
      !next nova_si
      !set wims_rm_0=$nova_sr
      !reset nova_sp nova_sg nova_sc nova_si nova_sl nova_sr nova_sn nova_avm nova_avr
    !endif
  !endif
!endif

!! Entree << Reglages de Nova >> juste apres << Apparence >> dans le menu de la configuration d'une classe, d'un portail
!! ou d'un groupement (2026-11-04 : << Badges Nova >> ; 2026-11-08, utilisateur : page de tous les reglages Nova, onglets) :
!! c'est la page Apparence avec l'ancre que lit le script de tete (html.nova-page-reglages, nova.js apparenceClasse).
!! Texte : lang/name.phtml (nova_rg_rubrique) ; icone : nova.js placerMenu.
!if $module=adm/class/config and config_present isin $wims_rm_0 and nova_reglages notin $wims_rm_0
  !default nova_rg_rubrique=Nova settings
  !set wims_name_nova_reglages=$nova_rg_rubrique
  !set nova_bc=!linecnt $wims_rm_0
  !reset nova_br
  !for nova_bi=1 to $nova_bc
    !set nova_bl=!line $nova_bi of $wims_rm_0
    !set nova_br=!append line $nova_bl to $nova_br
    !set nova_bn=!item 1 of $nova_bl
    !if $nova_bn=config_present
      !set nova_br=!append line nova_reglages,1,cmd=reply&job=present#nova-reglages to $nova_br
    !endif
  !next nova_bi
  !set wims_rm_0=$nova_br
  !reset nova_bc nova_bi nova_bl nova_bn nova_br
!endif
