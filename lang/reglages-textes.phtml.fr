:apparence
!! _widgets/apparence.phtml
<template id="nova-apparence" data-sans-effet="$nova_sans" data-champ-theme="$nova_theme" data-couleur-theme="$nova_app_couleur_theme" data-masques="réglages sans effet avec le thème Nova, ou rarement utiles, sont masqués." data-afficher="Les afficher" data-masquer="Les masquer">
!exit
