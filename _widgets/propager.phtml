!! Lu par header.phtml : superviseur, accueil ou adm/class/config.
!! Zones dependantes (adm/class/config, job=propagate ; demande de l'utilisateur, 2026-10-08) : case « Parametres du theme
!! Nova » ajoutee par nova.js (propagationNova), traitee ici, sur l'accueil (module de confiance) : superviseur d'une
!! structure seulement (types 2, 3, 4, comme propagate.proc) ; _procs/propager.sh recopie les blocs Nova de sa feuille
!! dans celles des zones. Message affiche par nova.js (#nova-propage). 2026-11-07 (utilisateur) : apparence et badges
!! separes : nova_propager=apparence, badges ou tout (1 = tout, ancien lien).
!! 2026-11-09 (utilisateur) : aussi sur adm/class/config (page Reglages de Nova, Zones dependantes), ou l'enseignant
!! reste : propager.sh n'ecrit que par !sh, permis la aussi. L'accueil reste accepte (anciens liens).
!read themes/$wims_theme/lang/reglages.phtml.$lang
!set nova_q=!sh printf '%s' "$$QUERY_STRING"
!set nova_q=!replace internal & by $ $ in $nova_q
!set nova_q=!replace internal + by $ $ in $nova_q
!set nova_pr=!getopt nova_propager in $nova_q
!reset nova_pp
!if $nova_pr=1 or $nova_pr=tout
  !set nova_pp=apparence,badges
  !set nova_pq=$nova_propage_quoi_tout
!endif
!if $nova_pr=apparence or $nova_pr=badges
  !set nova_pp=$nova_pr
  !set nova_pq=$(nova_propage_quoi_$nova_pr)
!endif
!if $nova_pp!=$empty
  !set nova_ct=!getdef class_type in wimshome/log/classes/$wims_class/.def
  !if $nova_ct isitemof 2,3,4
    !set nova_tn=!getdef class_typename in wimshome/log/classes/$wims_class/.def
    !set nova_sup=!getdef class_superclass in wimshome/log/classes/$wims_class/.def
    !set nova_pn=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/propager.sh "$wims_home" "$wims_class" "$nova_tn" "$nova_sup" "$nova_pp"
    !if $nova_pn=1
      !set nova_pt=$nova_propage_1
    !else
      !set nova_pt=!replace internal %1 by $nova_pn in $nova_propage_n
    !endif
    !set nova_pt=!replace internal %2 by $nova_pq in $nova_pt
<div id="nova-propage" hidden>$nova_pt</div>
  !endif
!endif
!reset nova_q nova_pr nova_pp nova_pq nova_ct nova_tn nova_sup nova_pn nova_pt
