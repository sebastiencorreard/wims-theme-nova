!! Nova : page Mon avatar de l'eleve (nova_avatar=1 ; demande de l'utilisateur, maquette validee le 2026-11-07).
!! Eleves seulement, hors examen et hors outil. Le choix et les achats arrivent par l'adresse (nova_avatar_choix,
!! nova_avatar_ouvrir) et sont verifies par _procs/avatar.awk, element par element (jetons, niveaux de badge).
!reset nova_avatar_page
!if $wims_user!=supervisor and $wims_user!=$empty and yes notin $user_supervisable
  !if _tool notin $wims_session and _exam notin $wims_session
    !set nova_sq=!sh printf '%s' "$$QUERY_STRING"
    !set nova_sq=!replace internal & by $ $ in $nova_sq
    !set nova_sq=!replace internal + by $ $ in $nova_sq
    !set nova_avatar_page=!getopt nova_avatar in $nova_sq
    !if $nova_avatar_page=1
      !set nova_av_ouvrir=!getopt nova_avatar_ouvrir in $nova_sq
      !set nova_av_choix=!getopt nova_avatar_choix in $nova_sq
      !read themes/$wims_theme/_widgets/avatar.phtml
    !endif
    !reset nova_sq nova_av_ouvrir nova_av_choix
  !endif
!endif
