!! Nova : sequences pedagogiques (2026-11-12, utilisateur, maquette B). Lu par header.phtml (adm/class/sequence, accueil).
!! - Enseignant, adm/class/sequence : glisser-deposer (nova_seq_de, nova_seq_vers : requete en arriere-plan de nova.js,
!!   _procs/sequences.sh deplacer ; le gabarit relit les sequences apres ce widget), option " numero seul " envoyee par
!!   la page Configurer (nova_seq_numero=oui|non dans l'adresse du formulaire), textes de nova.js (sequencesEnseignant),
!!   fenetre de confirmation d'" Effacer " (WIMS efface sans demander).
!! - Tous : #nova-seq-numero si la classe a choisi le numero seul (ligne sequence_nova_numero de seq/.def).
!! - Enseignant, adm/class/sequence (2026-11-19, utilisateur) : plage d'affichage d'une sequence (nova_seq_plage=N,
!!   nova_seq_mode=tous|cachee|plage, nova_seq_debut, nova_seq_fin = AAAAMMJJHHMM ; _procs/sequences.sh plage) ; sur
!!   job=show, #nova-seq-reglages : plages de toutes les sequences, heure du serveur, dates de la classe, presentation en
!!   sequences (sequence_open), mot generique (barre de reglages et pastilles de nova.js, sequencesEnseignant).
!! Valeurs de l'adresse : chiffres seulement, ou oui/non, ou une liste (audit du 2026-11-12).
!! Variables : nova_q la requete ; nova_sd, nova_sv sequence deplacee et place visee ; nova_sr resultat de sequences.sh ;
!! nova_sn option "numero seul" (recue oui/non, puis lue yes) ; nova_sp sequence dont la plage change, puis les plages
!! lues ; nova_sm mode de la plage ; nova_s1, nova_s2 debut et fin ; nova_mo mot generique ; nova_ov sequence_open.
!! Classes en partage des sequences (2026-11-19, utilisateur ; sur job=show, memes variables reprises) : nova_sd leur
!! liste, nova_sv l'une d'elles, nova_s1 leurs plages, nova_s2 leurs noms (separes par |), nova_sr une valeur lue.
!! nova_seq_partage=1 dans l'adresse : la plage est aussi ecrite dans ces classes (case de la fenetre de nova.js).
!if $module=adm/class/sequence and $wims_user=supervisor
  !set nova_q=!sh printf '%s' "$$QUERY_STRING"
  !set nova_q=!replace internal & by $ $ in $nova_q
  !set nova_sd=!getopt nova_seq_de in $nova_q
  !set nova_sv=!getopt nova_seq_vers in $nova_q
  !set nova_sd=!text select 0123456789 in $nova_sd
  !set nova_sv=!text select 0123456789 in $nova_sv
  !if $nova_sd!=$empty and $nova_sv!=$empty
    !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" deplacer "$nova_sd" "$nova_sv"
    !set nova_sr=!text select abcdefghijklmnopqrstuvwxyz in $nova_sr
    !if $nova_sr=ok
      !set wims_class_log=sequence $nova_sd to $nova_sv (Nova) by $wims_realuser
    !endif
<span id="nova-seq-fait" hidden data-resultat="$nova_sr"></span>
  !endif
  !set nova_sn=!getopt nova_seq_numero in $nova_q
  !if $nova_sn isitemof oui,non
    !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" numero "$nova_sn"
  !endif
  !set nova_sp=!getopt nova_seq_plage in $nova_q
  !set nova_sp=!text select 0123456789 in $nova_sp
  !set nova_sm=!getopt nova_seq_mode in $nova_q
  !if $nova_sp!=$empty and $nova_sm isitemof tous,cachee,plage
    !set nova_s1=!getopt nova_seq_debut in $nova_q
    !set nova_s2=!getopt nova_seq_fin in $nova_q
    !set nova_s1=!text select 0123456789 in $nova_s1
    !set nova_s2=!text select 0123456789 in $nova_s2
    !set nova_sd=!getopt nova_seq_partage in $nova_q
    !if $nova_sd=1
      !set nova_sd=partage
    !else
      !reset nova_sd
    !endif
    !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" plage "$nova_sp" "$nova_sm" "$nova_s1" "$nova_s2" $nova_sd
    !set nova_sv=!text select 0123456789 in $nova_sr
    !set nova_sr=!text select abcdefghijklmnopqrstuvwxyz in $nova_sr
    !if $nova_sr=ok
      !set wims_class_log=sequence $nova_sp allow $nova_sm $nova_sd (Nova) by $wims_realuser
    !endif
<span id="nova-seq-plage-fait" hidden data-resultat="$nova_sr" data-partage="$nova_sv"></span>
  !endif
  !if $job=show or $job=$empty
    !! Texte d'aide de WIMS en tete de page (show.phtml) : entoure, masque par le CSS sauf reglage std-listes (2026-11-19).
    !for nova_sm in 1,1c,2,3
      !if $(name_show$nova_sm)!=$empty
        !set name_show$nova_sm=<span class="nova-seq-aide">$(name_show$nova_sm)</span>
      !endif
    !next nova_sm
    !set nova_sp=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" plages
    !set nova_sp=!text select 0123456789abcdefghijklmnopqrstuvwxyz:,; in $nova_sp
    !set nova_mo=!defof sequence_Title in wimshome/log/classes/$wims_class/seq/.def
    !set nova_mo=!replace internal " by &quot; in $nova_mo
    !set nova_mo=!replace internal < by &lt; in $nova_mo
    !set nova_ov=!defof sequence_open in wimshome/log/classes/$wims_class/seq/.def
    !set nova_sd=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" partage
    !set nova_sd=!text select 0123456789/, in $nova_sd
    !reset nova_s1 nova_s2
    !for nova_sv in $nova_sd
      !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$nova_sv" plages
      !set nova_sr=!text select 0123456789abcdefghijklmnopqrstuvwxyz:,; in $nova_sr
      !set nova_s1=$nova_s1|$nova_sr
      !set nova_sr=!defof class_description in wimshome/log/classes/$nova_sv/.def
      !set nova_sr=!replace internal | by / in $nova_sr
      !set nova_sr=!replace internal " by &quot; in $nova_sr
      !set nova_sr=!replace internal < by &lt; in $nova_sr
      !set nova_s2=$nova_s2|$nova_sr
    !next nova_sv
<span id="nova-seq-reglages" hidden data-partage="$nova_sd" data-partage-plages="$nova_s1" data-partage-noms="$nova_s2" data-plages="$nova_sp" data-maintenant="$wims_now" data-creation="$class_creation" data-expiration="$class_expiration" data-ouvert="$nova_ov" data-mot="$nova_mo"></span>
  !endif
!read themes/$wims_theme/lang/enseignant-textes.phtml.$lang sequences
  !read themes/$wims_theme/_widgets/confirmations.phtml
!endif
!set nova_sn=!defof sequence_nova_numero in wimshome/log/classes/$wims_class/seq/.def
!if $nova_sn=yes
<span id="nova-seq-numero" hidden></span>
!endif
!reset nova_q nova_sd nova_sv nova_sr nova_sn nova_sp nova_sm nova_s1 nova_s2 nova_mo nova_ov
