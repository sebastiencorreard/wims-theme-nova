!! Nova : carte « Reglages de Nova » de la page Apparence (maintenance du site), lue par header.phtml pour le
!! gestionnaire ; placee par js/nova.js (apparenceNova). Valeurs actuelles lues dans log/nova.conf.
!! Valeurs par défaut de Nova (jetons.css) : animations non, entree directe oui, clavier non.
!set nova_a=non
!set nova_e=oui
!set nova_k=non
!set nova_b=non
!set nova_m=oui
!set nova_f=!sh if test -r $wims_home/log/nova.conf; then cat $wims_home/log/nova.conf; fi
!if --nova-animations: oui isin $nova_f
  !set nova_a=oui
!endif
!if --nova-entree-directe: non isin $nova_f
  !set nova_e=non
!endif
!if --nova-clavier-maths: oui isin $nova_f
  !set nova_k=oui
!endif
!if --nova-badges: oui isin $nova_f
  !set nova_b=oui
!endif
!if --nova-communication-eleves: non isin $nova_f
  !set nova_m=non
!endif
!! Page « Mon activite » des eleves (2026-10-08) : interrupteur et nombres de log/nova.conf (0 = absent : defaut).
!set nova_v=oui
!if --nova-activite: non isin $nova_f
  !set nova_v=non
!endif
!set nova_av=!sh awk '{ s = $$0; while (match(s, /--nova-activite-[a-z]+: *[0-9]+/)) { t = substr(s, RSTART, RLENGTH); sub(/--nova-activite-/, "", t); split(t, a, /: */); v[a[1]] = a[2]; s = substr(s, RSTART + RLENGTH) } } END { print v["seuil"] + 0, v["objectif"] + 0, v["heures"] + 0, v["notes"] + 0 }' $wims_home/log/nova.conf 2>/dev/null
!set nova_as=!word 1 of $nova_av
!set nova_ao=!word 2 of $nova_av
!set nova_ah=!word 3 of $nova_av
!set nova_an=!word 4 of $nova_av
!if $nova_as=$empty or $nova_as=0
  !set nova_as=2
!endif
!if $nova_ao=$empty or $nova_ao=0
  !set nova_ao=3
!endif
!if $nova_ah=$empty or $nova_ah=0
  !set nova_ah=6
!endif
!if $nova_an=$empty or $nova_an=0
  !set nova_an=5
!endif
!set nova_checked_v_$nova_v=checked
!set nova_checked_a_$nova_a=checked
!set nova_checked_e_$nova_e=checked
!set nova_checked_k_$nova_k=checked
!set nova_checked_b_$nova_b=checked
!set nova_checked_m_$nova_m=checked
!! Reglages de WIMS sans effet avec Nova : rangs dans lang/confdata (2e mot de la 1re ligne = nom).
!set nova_noms=page_bgcolor,page_bgimg,ref_menucolor,ref_button_bgcolor,ref_button_color,ref_button_help_bgcolor,ref_button_help_color,css
!set nova_lg=$modu_lang
!default nova_lg=$lang
!set nova_conf=wimshome/public_html/modules/adm/manage/lang/confdata.$nova_lg
!set nova_n=!recordcnt $nova_conf
!reset nova_sans
!for nova_i=1 to $nova_n
  !set nova_l=!record $nova_i of $nova_conf
  !set nova_l=!line 1 of $nova_l
  !set nova_l=!word 2 of $nova_l
  !if $nova_l isitemof $nova_noms
    !set nova_sans=!append item conf_$nova_i to $nova_sans
  !endif
  !if $nova_l=ref_bgcolor
    !set nova_theme=conf_$nova_i
  !endif
!next nova_i
<template id="nova-apparence" data-sans-effet="$nova_sans" data-champ-theme="$nova_theme" data-couleur-theme="$nova_app_couleur_theme" data-masques="$nova_app_masques" data-afficher="$nova_app_afficher" data-masquer="$nova_app_masquer">
  !if $nova_app_fait=yes
  <div class="wims_msg success nova-app-fait" role="status">$nova_app_enregistre</div>
  !endif
  <form class="nova-app" method="get" action="$wims_ref_name">
    <fieldset class="property_fields blockcenter nova-app-carte">
      <legend>$nova_app_titre <span class="nova-app-pastille">$nova_app_pastille</span></legend>
      <input type="hidden" name="nova_reglages" value="enregistrer">
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-l1">$nova_app_animations<span class="nova-app-aide">$nova_app_animations_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l1">
          <label><input type="radio" name="nova_animations" value="oui" $(nova_checked_a_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_animations" value="non" $(nova_checked_a_non)> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-l2">$nova_app_entree<span class="nova-app-aide">$nova_app_entree_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l2">
          <label><input type="radio" name="nova_entree_directe" value="oui" $(nova_checked_e_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_entree_directe" value="non" $(nova_checked_e_non)> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-l3">$nova_app_clavier<span class="nova-app-aide">$nova_app_clavier_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l3">
          <label><input type="radio" name="nova_clavier_maths" value="oui" $(nova_checked_k_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_clavier_maths" value="non" $(nova_checked_k_non)> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-l4">$nova_app_badges<span class="nova-app-aide">$nova_app_badges_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l4">
          <label><input type="radio" name="nova_badges" value="oui" $(nova_checked_b_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_badges" value="non" $(nova_checked_b_non)> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-l5">$nova_app_communication<span class="nova-app-aide">$nova_app_communication_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l5">
          <label><input type="radio" name="nova_communication" value="oui" $(nova_checked_m_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_communication" value="non" $(nova_checked_m_non)> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne nova-app-activite">
        <span class="nova-app-nom" id="nova-app-l6">$nova_app_activite<span class="nova-app-aide">$nova_app_activite_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-l6">
          <label><input type="radio" name="nova_activite" value="oui" $(nova_checked_v_oui)> $nova_app_oui</label>
          <label><input type="radio" name="nova_activite" value="non" $(nova_checked_v_non)> $nova_app_non</label>
        </span>
        <details class="nova-app-detail"><summary>$nova_app_act_reglages</summary>
        <div class="nova-app-phrases">
          <label class="nova-app-phrase">$nova_app_act_seuil <input type="number" class="nova-app-nombre" name="nova_activite_seuil" min="1" max="7" step="1" value="$nova_as"> $nova_app_act_seuil2</label>
          <label class="nova-app-phrase">$nova_app_act_objectif <input type="number" class="nova-app-nombre" name="nova_activite_objectif" min="1" max="7" step="1" value="$nova_ao"> $nova_app_act_objectif2</label>
          <label class="nova-app-phrase">$nova_app_act_heures <input type="number" class="nova-app-nombre" name="nova_activite_heures" min="1" max="80" step="1" value="$nova_ah"> $nova_app_act_heures2</label>
          <label class="nova-app-phrase">$nova_app_act_notes <input type="number" class="nova-app-nombre" name="nova_activite_notes" min="1" max="20" step="1" value="$nova_an"> $nova_app_act_notes2</label>
        </div>
        </details>
      </div>
      !set nova_std_nom=nova_s_
      !set nova_std_sep=_
      !set nova_std_site=yes
      !read themes/Nova/_widgets/apparence-standard.phtml
      !reset nova_std_nom nova_std_sep nova_std_site
      <p class="nova-app-note">$nova_app_note</p>
      <div class="nova-app-actions"><input type="submit" value="$nova_app_enregistrer"></div>
    </fieldset>
  </form>
</template>
!reset nova_v nova_av nova_as nova_ao nova_ah nova_an nova_checked_v_oui nova_checked_v_non
!reset nova_a nova_e nova_k nova_b nova_m nova_f nova_noms nova_conf nova_n nova_l nova_i nova_sans nova_theme
!reset nova_checked_a_oui nova_checked_a_non nova_checked_e_oui nova_checked_e_non nova_checked_k_oui nova_checked_k_non nova_checked_b_oui nova_checked_b_non nova_checked_m_oui nova_checked_m_non
