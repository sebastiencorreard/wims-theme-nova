!! Note retenue de chaque examen (meilleure session valide, calculee par WIMS), posee sur les
!! cartes d'examen par js/nova.js (notesExamens), comme la note d'une feuille. Seulement pour un examen
!! commence, lu dans score/<eleve>.exam (ligne << n 00 ... >> = debut de session), releve permanent : PAS
!! dans l'historique (examlog), dont WIMS efface chaque nuit les sessions au-dela des 7 dernieres de
!! l'eleve, tous examens confondus (bin/housekeep.daily, examlog_limit ; la pastille disparaissait, 2026-11-04).
!set nova_ec=!sh f="$wims_home/log/classes/$wims_class/score/$wims_user.exam"; [ -f "$$f" ] && awk '$$2=="00" {print $$1}' "$$f" | sort -un | tr '\n' ' '
!set nova_es=!examscore user=$wims_user
!set nova_es=!line 1 of $nova_es
!set nova_sm=!record 0 of wimshome/log/classes/$wims_class/sheets/.severity
!set nova_sm=!line 1 of $nova_sm
!default nova_sm=10
!set nova_en=
!set nova_k=!wordcnt $nova_es
!for nova_i=1 to $nova_k
  !if $nova_i iswordof $nova_ec
    !set nova_v=!word $nova_i of $nova_es
    !set nova_en=$nova_en $nova_i:$[rint(100*$nova_sm*$nova_v/10)/100]
