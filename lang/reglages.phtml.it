!set nova_version_dev=versione di sviluppo
!set nova_app_desact=Disattivare nonostante la condivisione
!set nova_app_desact_aide=Aggiunge un pulsante «Disattiva comunque...» quando WIMS rifiuta di disattivare un esame o un foglio condiviso con altre classi.
!set nova_app_desact_danger=Pericoloso: l'esame o il foglio viene disattivato in tutte le classi che lo condividono, e il suo contenuto è di nuovo modificabile; ogni modifica sfasa i voti registrati, in tutte quelle classi. WIMS lo vieta per questi motivi. Attivalo solo con cognizione di causa.
!set nova_version_lien=Novità di ogni versione (nuova scheda)
!set nova_rg_affichage=Visualizzazione
!set nova_rg_eleves=Studenti
!set nova_rg_dm=Compiti WIMS
!set nova_rg_badges=Distintivi e ricompense
!set nova_rg_avances=Impostazioni avanzate
!set nova_rg_dm_aide=Un compito WIMS è un esame di allenamento (molte sessioni) e un esame valutato (poche sessioni) con lo stesso contenuto. Nova li riconosce dal titolo. Accenti e maiuscole sono ignorati.
!set nova_rg_dm_usage=Queste impostazioni sono usate da:
!set nova_rg_dm_usage1=<strong>«Crea il compito valutato»</strong>: pulsante nella tua pagina iniziale, accanto a un compito di allenamento che non ha ancora un compito valutato; crea una copia «In preparazione», con una parola chiave di valutazione nel titolo e il numero di sessioni qui sotto.
!set nova_rg_dm_usage2=<strong>Distintivo Riscaldamento</strong>: un compito conta quando lo studente ha fatto abbastanza sessioni complete di allenamento prima di aprire quello valutato.
!set nova_rg_dm_usage3=<strong>Distintivo Al top</strong>: compito valutato superato (voto tenuto almeno pari alla soglia del distintivo).
!set nova_rg_dm_mots=Parole chiave di un compito WIMS
!set nova_rg_dm_mots_aide=Obbligatorio: il titolo di un compito WIMS, di allenamento o valutato, contiene una di queste parole, seguita o no da un numero (DMWIMS03).
!set nova_rg_dm_note=Parole chiave di un compito valutato
!set nova_rg_dm_note_aide=Il titolo di un compito valutato contiene inoltre una di queste parole.
!set nova_rg_dm_ent=Parole chiave di un compito di allenamento
!set nova_rg_dm_ent_aide=Il titolo di un compito di allenamento contiene inoltre una di queste parole. Un esame di allenamento e il suo compito valutato hanno lo stesso contenuto, o lo stesso titolo tranne questa parola.
!set nova_rg_dm_essais1=«Crea il compito valutato» gli dà
!set nova_rg_dm_essais2=sessioni.
