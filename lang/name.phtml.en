!! Nova : textes propres au thème (en). Lu par html/headmenu*.phtml (themes/$wims_theme/lang/).
!! Encodage latin-1 : WIMS sert ses pages en windows-1252.
!set nova_menu_activites=Activities
!set nova_menu_participants=Participants
!set nova_menu_communication=Communication
!set nova_menu_classe=Class
!set nova_menu_aide=Help and tools
!set nova_examencours=Exam in progress
!set nova_examen_court=Exam
!set nova_explorer=Explore
!set nova_taxonomie=Taxonomy
!set nova_glossaires=Glossaries
!set nova_parcourir=Browse the site
!set nova_accueil=Home
!set nova_rg_rubrique=Nova settings
!set nova_sv_titre=Live monitoring
!set nova_avs_titre=Students' avatars,Students' badges
!set nova_pied=Terms,Contact us
!! Version imprimable d'une feuille (adm/sheet, job=print : tous les exercices calcules dans une seule page) : le tampon
!! des noms de variables (32 Ko) y est presque plein avant la barre (debordement vu le 2026-11-12, serveur de l'utilisateur,
!! dans ce fichier). Seuls les textes de la barre et du menu ci-dessus y sont lus ; nova.js prend ses textes de secours.
!if $module=adm/sheet and $job=print
  !exit
!endif
!set nova_chrono_libelle=Time left
!set nova_chrono_fin_detail_exo=You can still finish the exercise, but the score goes down as time passes.
!set nova_chrono_fin_detail_exo0=An answer sent now will score 0.
!set nova_examen_a_terminer=Exam to finish
!set nova_examen_a_terminer_court=Finish
