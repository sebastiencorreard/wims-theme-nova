!! Nova : textes (en) des pages Apparence et Reglages de Nova (site, classe, structure) : _widgets/apparence*.phtml, version, propager, reglages-site.
!! Lus seulement par ces gabarits (2026-11-11) : name.phtml, lu sur CHAQUE page, faisait deborder le tampon des noms
!! de variables de WIMS (32 Ko, src/var.c : variable_name_buffer_overflow sur un exercice d'une feuille).
!! Encodage latin-1 : WIMS sert ses pages en windows-1252.
!! Page Apparence de la maintenance du site (header.phtml, js/nova.js apparenceNova)
!set nova_app_titre=Nova settings
!set nova_app_pastille=theme
!set nova_app_animations=Animations
!set nova_app_animations_aide=Stars and shake after an answer, sliding menus. The student's device can always refuse them.
!set nova_app_entree=Go straight into the only course
!set nova_app_entree_aide=Portal or group: a student with a single course or class goes straight into it.
!set nova_app_clavier=Touch math keyboard
!set nova_app_clavier_aide=In the answer fields of exercises, on phones and tablets.
!set nova_app_note=A class, portal or group can choose otherwise with its own CSS override.
!set nova_app_enregistrer=Save Nova settings
!set nova_app_enregistre=Nova settings saved.
!set nova_app_oui=Yes
!set nova_app_non=No
!set nova_app_note_classe=These settings apply to this portal, group or class (and their zones), and override those of the site. They are written in the style sheet of the Appearance page.
!set nova_app_couleur_theme=Theme colour
!set nova_app_couleur_theme_aide=Top bar, buttons and links; also the "Theme colour" of the Appearance page.
!! Badges (2026-10-07): first badge, Loyalty.
!set nova_badges_semaines=weeks
!set nova_badges_semaine=week
!set nova_app_badges=Student badges
!set nova_app_paliers=Regularity badge thresholds
!set nova_app_paliers_aide=Counted weeks (weeks with WIMS) for each of the 8 levels, separated by spaces. Empty: inherited value. 0: level given at once, for testing (the student keeps it).
!set nova_app_vacances=Holidays
!set nova_app_vacances_aide=One period per line, "DD/MM/YYYY - DD/MM/YYYY".
!set nova_app_vac_titre=Holidays
!set nova_app_vac_aide=During the holidays, the page shows no weekly goal.
!set nova_app_vac_herite=Same as the portal or group
!set nova_app_vac_aucune=None
!set nova_app_vac_zone=Zone
!set nova_app_vac_dates=Custom dates
!set nova_bdg_titre=Nova badges
!set nova_bdg_rubrique=Nova badges
!set nova_bdg_rubrique_aide=(student badges: which ones, thresholds)
!set nova_bdg_choix=Badges offered to students
!set nova_bdg_etat_oui=Student badges on (main switch on the page
!set nova_bdg_etat_non=Student badges off: nothing is shown to students (main switch on the page
!set nova_bdg_apparence=Appearance
!set nova_bdg_fid_desc=Weeks with WIMS (number of days adjustable), counted without needing to be in a row. 8 levels, never lost.
!set nova_bdg_vacances_titre=Holiday weeks
!set nova_bdg_note=These settings apply to this portal, group or class (and their areas). They are written in the style sheet of the Appearance page.
!set nova_bdg_enregistrer=Save
!set nova_app_badges_aide=Main switch: on "No", nothing is shown to students.
!set nova_std_titre=Closer to the standard theme
!set nova_std_aide=Setting by setting, get back the standard theme's display where Nova hides, changes or moves something. Colours, font and cards stay Nova's.
!set nova_std_changements=What changes
!set nova_std_menus=Standard theme menus
!set nova_std_menus_aide=Students: menu in a left column. Account, Help and languages in the top bar.
!set nova_std_menus_liste=<li>Students, large screens: the side menu stays in a left column instead of the drawer opened by the menu button.</li><li>Students and teachers: the account menu (name, preferences, terms of use, logout) stays in the top bar instead of the "Profile" section of the side menu; the terms of use come back there (otherwise: footer only).</li><li>"Help" stays in the top bar.</li><li>The language choice stays in the top bar.</li><li>Unchanged: on phones and tablets, the side menu stays a drawer.</li><li>"My activity" opens the WIMS page (charts), not the Nova page.</li><li>Teacher: the "Photoboard" entry of the participants menu opens the WIMS photo board; the avatars and badges page keeps its own "Students' avatars" entry ("Students' badges" without avatars) (otherwise it replaces it, under the photo board's name).</li><li>Teacher: WIMS footer (participant view, message of the day, class diary, forum, Config / Maintenance) with the "Terms of use" and "Help" links, instead of "Terms", "Config / Maintenance" and "Contact us".</li>
!set nova_std_navigation=Full navigation for students
!set nova_std_navigation_aide=Breadcrumbs and full account menu.
!set nova_std_navigation_liste=<li>Breadcrumbs are shown at the top of student pages.</li><li>The "Back" button is no longer added to the bar.</li><li>The student's account menu gets all its links back (display preferences, terms of use...), not only the name, the password change and logout.</li><li>The breadcrumb keeps the final « * » that WIMS writes on a page without a title.</li>
!set nova_std_reponse=Standard answer page
!set nova_std_reponse_aide="Analysis of your answer" table and the standard send button.
!set nova_std_reponse_liste=<li>The "Analysis of your answer" table is shown as is.</li><li>No "Right answer" / "Wrong answer" box, no "Correct" and "To review" columns for mixed answers, no wrong answer in red.</li><li>Chosen or missed choices (checkboxes, words to mark) without frame or badge in the statement.</li><li>No stars and no shake, even with animations on.</li><li>The button keeps its standard label.</li>
!set nova_std_examens=Standard exams
!set nova_std_examens_aide=End of session, messages and titles as in the standard theme.
!set nova_std_examens_liste=<li>"End this exam session" stays in the account menu (or side menu) instead of an "End" button in the bar.</li><li>The student's name, Help and account stay in the bar during the exam.</li><li>Logout links stay visible during the exam.</li><li>The sentence "Your score for this exam is..." is shown on the exam page.</li><li>The "You have already started another exam..." message stays the standard one.</li><li>The titles above the instructions and the exercise list are shown.</li><li>After the "End" warning, "No" goes back to the scores page.</li><li>Unchanged: Nova's timer and the "Exam in progress" pill.</li>
!set nova_std_textes_aide=Original sentences and labels where Nova rewrites them.
!set nova_std_textes_liste=<li>"My scores": standard exam score sentences.</li><li>Login page: introduction texts shown.</li><li>Password change: standard labels.</li><li>Top bar: "Home page" instead of "WIMS".</li><li>Appearance page: "Menu background colour" instead of "Theme colour".</li><li>Teacher "Scores" page: "Exam n" headers instead of the exam title.</li><li>Access restriction: the WIMS field alone, without the form for forbidden hours and periods.</li><li>Login links: the WIMS list as is, without cards or Copy buttons.</li><li>Sheet page: standard subtitle instead of "Sheet 1".</li>
!set nova_std_listes=Sheets and exams as lists
!set nova_std_listes_aide=Standard presentation instead of Nova's cards.
!set nova_std_listes_liste=<li>Student home: sheets, exams, documents, tools and sequences with the standard presentation instead of Nova's cards.</li><li>Sheet and exam scores as written by the standard theme: no segments, score pill or labels.</li><li>Exam attempts and history in the standard form.</li><li>Full type legend.</li><li>Sheet page: standard exercises and scores, with no progress card ("n exercises done") or state per exercise; "Suspend score recording" button instead of the "Practice mode" switch.</li><li>Exam page: exercises as a list instead of cards.</li><li>Server administration (site manager) and Configuration and maintenance of a class, group or portal: standard lists of links instead of cards with icons.</li><li>Class configuration: standard theme "Class capacity" bar (centred text, red and grey), instead of Nova's slim gauge.</li><li>Preparing a sheet or an exam: status and settings of the standard theme, instead of the status banner and tiles (weight, scoring rule and individualisation always visible).</li><li>Teacher's home page: Status and Action columns of sheets, exams, free works, tools, documents and polls as the standard theme writes them, instead of the status badge that opens the menu of actions.</li><li>Teacher home page, sheet or exam page: WIMS warning pages (activate, deactivate, delete) instead of the Nova window.</li><li>Global configuration of a class, group or portal: all settings visible, as in the standard theme, instead of folded sections with a "changed" badge.</li><li>Class backup: zip, tgz and tar.gz formats as standard-theme labels, instead of download buttons.</li><li>Class security management: standard-theme list of links, instead of a card with icons.</li><li>Teacher's teaching sequences: standard theme title bar (status in brackets, Edit, Move up, Delete, Deactivate buttons under the title), instead of the status pill and its menu, the Move up / Move down arrows, collapsible sequences and drag and drop.</li>
!set nova_std_menu_complet=Full teacher menu by default
!set nova_std_menu_complet_aide=All side menu entries, until the teacher chooses.
!set nova_std_menu_complet_liste=<li>The teacher's side menu shows all its entries until the teacher chooses between the simplified and the full menu.</li><li>Unchanged: the simplified menu button and the choice of entries stay available, and each choice is kept.</li>
!set nova_app_communication=Students' "Communication" section
!set nova_app_communication_aide=Forum and "Write to the teacher" in the students' menu. "No" hides the section.
!set nova_std_dominos=Standard dominoes and tiles
!set nova_std_dominos_aide=Domino and drag-tile exercises without Nova's styling.
!set nova_std_dominos_liste=<li>Dominoes and drop boxes with the standard colours and sizes (205 x 50, blue background, orange boxes) instead of white dominoes with a black frame (205 x 80, 175 x 80 on phones) and dashed boxes.</li><li>No computed common text size: the standard one.</li><li>No "Drag each domino..." instruction above the dominoes.</li><li>No highlighted box while dragging, no lit boxes when a domino is chosen.</li><li>No window suggesting landscape mode on phones.</li><li>Correction page: standard dominoes (statement, analysis, solution), no red or green frame, and "Analysis of your answer" shown.</li><li>Drag tiles of other exercises with the standard colours and sizes (blue background, orange boxes with "?"), instead of white tiles, recessed boxes and an eraser to empty a box; small tiles not enlarged to 44 px, no grip or "Drop here".</li><li>Matching items: WIMS colours (grey, beige, bright blue) and blue arrows, instead of white tiles joined by a line; correction without green or red tiles or &#10003; / &#10005; badges.</li>
!set nova_std_tableaux=Standard tables
!set nova_std_tableaux_aide=Table cells clickable only on their link or button.
!set nova_std_tableaux_liste=<li>A table cell that contains a single link or button is no longer clickable as a whole: click the link or button itself; the cell no longer darkens on hover.</li><li>Teacher's Scores page: sheet and exam scores (« -- », 0...) left-aligned as WIMS writes them, instead of centred.</li>
!set nova_std_notes_eleve=Standard student scores page
!set nova_std_notes_eleve_aide=WIMS tables instead of cards, for students.
!set nova_std_notes_eleve_liste=<li>The student's "My scores" page: WIMS tables (one row per exercise, columns Required points, Weight, Quality, Success, Last result, Number of tries, sortable) instead of the large average with its bar, exam score badges and one collapsible card per worksheet. WIMS title ("Detail of the work of ...") instead of "My scores".</li>
!set nova_std_notes_enseignant=Standard student detail and teacher Scores page
!set nova_std_notes_enseignant_aide=WIMS tables instead of cards, for teachers.
!set nova_std_notes_enseignant_liste=<li>Detail of a student's work (name clicked on the "Scores" page): WIMS tables instead of cards (average with its bar, exams, one collapsible card per worksheet).</li><li>"Scores" page: "Show" line with WIMS buttons instead of the selector (current choice in colour).</li>
!set nova_app_activite=Students' "My activity" page
!set nova_app_activite_aide=Replaces the WIMS page with a simple one: regularity, working time, latest scores.
!set nova_app_act_seuil=Encourage students who work fewer than
!set nova_app_act_seuil2=days a week.
!set nova_app_act_objectif=Goal:
!set nova_app_act_objectif2=days a week.
!set nova_app_act_heures=Suggest breaks beyond
!set nova_app_act_heures2=hours a week.
!set nova_app_act_notes=Show the
!set nova_app_act_notes2=latest scores.
!set nova_app_act_herite=Empty field: value of the portal, group or site.
!set nova_app_act_reglages=Page settings
!set nova_propage_1=Settings propagated to 1 dependent zone: %2.
!set nova_propage_n=Settings propagated to %1 dependent zones: %2.
!set nova_propage_quoi_tout=Nova settings
!set nova_propage_quoi_apparence=Nova settings (display, students, advanced)
!set nova_propage_quoi_badges=Nova settings (WIMS homework, badges)
!set nova_app_masques_eleves=Menu sections hidden from students
!set nova_app_masques_eleves_aide=Checked: not in the students' menu. The teacher's menu does not change.
!set nova_app_masque_communication=Communication (forum, write to the teacher)
!set nova_app_masque_liens=External links (other classes, ENT links)
!set nova_bdg_fid_exercices=Working days per week (1 to 7)
!set nova_bdg_per_desc=Succeed at an exercise after several low scores. 8 levels, never lost.
!set nova_bdg_per_paliers=Perseverance badge thresholds
!set nova_bdg_per_paliers_aide=Exercises succeeded after difficulties, for each of the 8 levels, separated by spaces. Empty: inherited value. 0: level given at once, for testing (the student keeps it).
!set nova_bdg_per_regle1=Count an exercise when the student scores at least
!set nova_bdg_per_regle2=/10 after at least
!set nova_bdg_per_regle3=scores strictly below
!set nova_bdg_per_regle4=/10.
!set nova_bdg_per_examens=Include exam scores
!set nova_bdg_ech_desc=Practise before each graded homework: two exams with the same content, many attempts for practice, few for the graded one. 8 levels, never lost.
!set nova_bdg_ech_paliers=Warm-up badge thresholds
!set nova_bdg_ech_paliers_aide=Prepared homework assignments, for each of the 8 levels, separated by spaces. Empty: inherited value. 0: level given at once, for testing (the student keeps it).
!set nova_bdg_ech_sessions1=Count a homework when the student has done at least
!set nova_bdg_ech_sessions2=complete practice sessions (an answer to every exercise) before opening the graded exam.
!set nova_bdg_ech_mots=Also recognise homework by title
!set nova_bdg_ech_mots_aide=When the two exams do not have the same content: words that tell the titles apart, separated by commas, the rest of the title identical ("DM 02 (practice)", "DM 02 (graded)"). Accents and case ignored. Empty: inherited value.
!set nova_bdg_ech_mots_t=Practice
!set nova_bdg_ech_mots_n=Graded
!set nova_bdg_top_desc=Succeed in graded homework: kept score of at least 9/10 (adjustable). Graded homework recognised from the WIMS homework tab. 8 levels, never lost.
!set nova_bdg_top_paliers=Top badge thresholds
!set nova_bdg_top_paliers_aide=Top homework, for each of the 8 levels, separated by spaces. Empty: inherited value. 0: level given at once, for testing (the student keeps it).
!set nova_bdg_top_seuil1=Count a homework when the kept score on the graded test reaches at least
!set nova_bdg_top_seuil2=out of 10.
!set nova_bdg_coul_phrase3=, and gradients at level
!set nova_bdg_coul_degrade=Level that unlocks gradients
!set nova_bdg_coul_titre=Students' own colour
!set nova_bdg_coul_aide=A reward: the student chooses the colour of their interface from a readable palette (profile menu, "My colour"), then, a gradient (top bar, buttons, window titles). Once chosen, it applies throughout the class, group or portal, tests included.
!set nova_bdg_coul_phrase1=Unlock the choice at level
!set nova_bdg_coul_phrase2=of the badge
!set nova_bdg_coul_niveau=Level that unlocks the colour
!set nova_bdg_coul_badge=Badge that unlocks the colour
!set nova_bdg_coul_aucun=nobody (off)
!set nova_bdg_coul_herite_vide=inherited value
!set nova_bdg_reglages=Settings
!set nova_app_fil=Fixed breadcrumb
!set nova_app_fil_aide=Teachers and admins, large screens: the breadcrumb stays under the top bar when the page scrolls.
!set nova_app_deco=Seasonal decorations
!set nova_app_deco_aide=Lights and snowflakes on the top bar in December (more holidays to come); never during an exam.
!set nova_bdg_av_titre=Students' avatar
!set nova_bdg_av_aide=Students earn coins by passing exercises and use them to unlock items of their avatar ("My avatar" in the Profile menu). Some items are badge rewards. The avatar applies throughout the class, group or portal; only the student and their teachers see it.
!set nova_bdg_av_actif=Students' avatar
!set nova_bdg_av_oui=offered
!set nova_bdg_av_regle1=An exercise counts from the mark
!set nova_bdg_av_regle2=out of 10, if the answer comes at least
!set nova_bdg_av_regle3=seconds after it was opened, once a day; at most
!set nova_bdg_av_regle4=exercises per day.
!set nova_bdg_av_paliers=Token thresholds
!set nova_bdg_av_paliers_aide=Number of passed exercises needed for each coin (default: 3 10 20 30 40).
!set nova_bdg_av_pas1=Then one coin every
!set nova_bdg_av_pas2=passed exercises.
!set nova_bdg_av_depart1=Each student starts with
!set nova_bdg_av_depart2=free coin(s), to customise their avatar right away.
!set nova_mois=January,February,March,April,May,June,July,August,September,October,November,December
!set nova_version_dev=development version
!set nova_app_desact=Deactivate despite sharing
!set nova_app_desact_aide=Adds a "Deactivate anyway..." button when WIMS refuses to deactivate an exam or sheet shared with other classes.
!set nova_app_desact_danger=Dangerous: the exam or sheet is deactivated in every sharing class, and its content can be changed again; any change puts the recorded scores out of step, in all those classes. WIMS forbids it for these reasons. Only turn this on if you know what you are doing.
!set nova_version_lien=What is new in each version (new tab)
!set nova_rg_affichage=Display
!set nova_rg_eleves=Students
!set nova_rg_dm=WIMS homework
!set nova_rg_badges=Badges and rewards
!set nova_rg_avances=Advanced settings
!set nova_rg_dm_aide=A WIMS homework is a practice exam (many sessions) and a graded exam (few sessions) with the same content. Nova recognizes them by their title. Accents and capitals are ignored.
!set nova_rg_dm_usage=These settings are used by:
!set nova_rg_dm_usage1=<strong>"Create the graded homework"</strong>: button on your home page, next to a practice homework that has no graded homework yet; it makes a copy "In preparation", titled with a graded keyword and set to the number of sessions below.
!set nova_rg_dm_usage2=<strong>Warm-up badge</strong>: a homework counts when the student has done enough complete practice sessions before opening the graded one.
!set nova_rg_dm_usage3=<strong>Top badge</strong>: graded homework passed (kept score at least the badge threshold).
!set nova_rg_dm_mots=Keywords of a WIMS homework
!set nova_rg_dm_mots_aide=Required: the title of a WIMS homework, practice or graded, contains one of these words, possibly followed by a number (DMWIMS03).
!set nova_rg_dm_note=Keywords of a graded homework
!set nova_rg_dm_note_aide=The title of a graded homework also contains one of these words.
!set nova_rg_dm_ent=Keywords of a practice homework
!set nova_rg_dm_ent_aide=The title of a practice homework also contains one of these words. A practice exam and its graded homework have the same content, or the same title except for this word.
!set nova_rg_dm_essais1="Create the graded homework" gives it
!set nova_rg_dm_essais2=sessions.
!set nova_bdg_coul_ligne1=Colour:
!set nova_bdg_coul_ligne2=Gradients:
!set nova_bdg_coul_au_niveau=at level
!set nova_bdg_coul_badge_deg=Badge that unlocks gradients
!set nova_bdg_coul_meme_badge=same badge as the colour
!set nova_bdg_coul_ordre=Gradients only open once the colour is unlocked.
