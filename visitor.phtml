<!-- begin of standard/visitor.phtml -->
!read themes/$wims_theme/_widgets/accent.phtml
!! WIMS main entrance page theme.
!nocache
!if $module!=home
  !exit
!endif

!set home_theme=yes
!set table_colors=$wims_ref_bgcolor,$wims_ref_bgcolor
</div>
<div id="wimsfrontpage">
!! Nova : accueil du site pour un visiteur (2026-11-27, utilisateur, maquette A) : marque WIMS et nom du serveur a gauche de
!! la barre, boutons << Eleve >> et << Enseignant >> a droite, puis le logo de l'etablissement ($site_logo de la
!! configuration du site, comme Pion2 a AMU). Menu lateral en tiroir a toutes les largeurs ; << A propos >>, la langue
!! et << Administration du site >> (ex << WIMS gestion du site en ligne >>) passent dans le tiroir (nova.js
!! accueilVisiteur, cadre.css). Reglage << Menus du theme standard >> : barre et colonne comme avant, sans les boutons.
!! Boutons, logo et html.nova-accueil-visiteur : _widgets/visiteur-barre.phtml (aussi lu par header.phtml, zones).
!! Variables : nova_ac_hote, nom du serveur filtre (il vient de la requete).
!read themes/$wims_theme/lang/accueil.phtml.$lang

  <div id="wimstopbox">
!set nova_ac_hote=!text select abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-: in $httpd_HTTP_HOST
!set wims_ref_class=nova-marque
!href cmd=new&module=home <img src="html/themes/$wims_theme/img/wims_logo_v4_blanc.svg" width="32" height="32" alt=""><span class="nova-marque-nom">WIMS</span><span class="nova-marque-hote">$nova_ac_hote</span>

!read themes/$wims_theme/_widgets/user_links.phtml

    <div class="wimsmenu menu">
!!read themes/_widgets/virtualzone.phtml
!read themes/_widgets/authlogout.phtml
!set N_manage=<span class="nova-nom-nova">$nova_ac_admin</span><span class="nova-nom-std">$N_manage</span>
!read themes/_widgets/manager.phtml
    </div>
!read themes/$wims_theme/_widgets/visiteur-barre.phtml
  </div>
!read themes/$wims_theme/_widgets/ariane.phtml
  <div id="wimsbodybox">
    <div id="wimspagebox">
      <div class="wimsbody">
!! Titre << WIMS WWW Interactive Multipurpose Server a ... >> : remplace par la marque de la barre (2026-11-27,
!! utilisateur) ; cache par accueil.css, sauf reglage << Textes du theme standard >>. Titre pour les lecteurs d'ecran.
<h1 class="show-for-sr nova-accueil-titre-sr">WIMS $nova_ac_hote</h1>
!read themes/$wims_theme/_widgets/site_title.phtml
!! Ordre de Pion2 (2026-11-27, utilisateur) : message du site, actualite et exemples (repliables), puis recherche de
!! classe, recherche de ressource et << Taxonomie et glossaire >> cote a cote, puis << Sur ce site >>.
!read themes/$wims_theme/_widgets/infos.phtml
<div class="nova-accueil-recherches">
!read themes/$wims_theme/_widgets/search_classe.phtml
  <section class="nova-accueil-carte nova-recherche-ressource">
    <h2 class="wims_title">$name_search_all</h2>
!read ./form.phtml
  </section>
!if $s_category=V
  !read themes/$wims_theme/_widgets/taxo-glossaire.phtml
!endif
</div>
!if $s_category=V
  !read themes/$wims_theme/_widgets/front.phtml
!else
  !read ./result.phtml
!endif
!read themes/$wims_theme/_widgets/logo-site.phtml nova-logo-bas
      </div><!--end wimsbody-->
    </div><!--wimspagebox-->
!distribute items div,div into div0,div1

!! Sets all links to be displayed in menumodubox
!read themes/_procs/homemenu.proc

!set wims_rm_0 = $wims_rm_0\
 itemsep,0,$V_cls
!read themes/_procs/virtualzone.proc

!set wims_rm_0 = $wims_rm_0\
itemsep,0,$CR_Docs
!read themes/_procs/documentation.proc

!set wims_rm_0 = $wims_rm_0\
itemsep,0,$CR_1
!read themes/_procs/devtools.proc

!set wims_rm_0 = $wims_rm_0\
itemsep,0,$wims_name_Site
!read themes/_procs/browsesite.proc
!read themes/_procs/site.proc

!set wims_homeref_n0 = !linecnt $wims_rm_0

!read themes/_widgets/menumodubox_accordion.phtml

!distribute items div,span into div0,div1
!read themes/_widgets/visitormenubox.phtml
!reset div0 div1
  </div><!--wimsbodybox-->

!read themes/_widgets/tailbox.phtml
</div><!--wimsfrontpage-->

!read themes/$wims_theme/_widgets/footer.phtml
!robottrap
</body>
</html>
<!-- end of standard/visitor.phtml -->
