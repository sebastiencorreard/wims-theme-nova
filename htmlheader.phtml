<!-- Nova. ATTENTION : ce fichier est lu par le code C de WIMS (config.c), qui remplace les
     variables $... mais N'EXECUTE PAS les commandes ! (ni !if, ni les commentaires !!) : elles
     partiraient telles quelles dans la page. Ici, seulement du HTML, du CSS et des variables.
     Mode sombre : desactive (2026-10-01). Pour le rallumer, ajouter ici
     <meta name="nova-sombre" content="auto"> et passer color-scheme a "light dark".
     L'accent selon la couleur de la classe est pose par _widgets/accent.phtml (gabarits interpretes). -->
<meta name="color-scheme" content="light">
<meta name="nova-module" content="$module">
<meta name="nova-css" content="b7b6917d65">
<script>/* Nova : menu enseignant simplifie sauf choix contraire (js/nova.js, basculeMenu).
   Les entrees gardees sont choisies par l'enseignant (localStorage nova_menu_garde), sinon la liste
   de Pion ; la regle qui masque les autres est ecrite ici, avant l'affichage, pour qu'aucune
   n'apparaisse un instant. Pas de signe dollar dans ce script : le C de WIMS le remplacerait. */
(function () {
  var d = document.documentElement;
  d.classList.add('nova-js');
  /* modtool (demande de l'utilisateur, 2026-11-04) : son propre choix, gardes a part (suffixe _modtool), et liste
     inverse : les entrees CACHEES, tout le menu par defaut. */
  var mm = document.querySelector('meta[name="nova-module"]');
  var mt = !!mm && mm.content === 'adm/modtool';
  var suf = mt ? '_modtool' : '';  /* le bouton de retour en haut ne se cache qu'avec JavaScript */
  /* Page Reglages de Nova (rubrique de la configuration, js/nova.js apparenceClasse ; ancienne ancre de la page Badges
     Nova acceptee) : la page Apparence de WIMS, masquee jusqu'au passage du script. */
  if (/^#nova(-|%2D)(badges(-|%2D))?reglages(?![\s\S])/i.test(location.hash) && /job=present/.test(location.search)) d.classList.add('nova-page-reglages');
  /* Retour d'un enregistrement de cette page (2026-11-08, utilisateur) : WIMS renvoie la page Apparence (adresse du
     formulaire, sans ancre) ; reperee par sessionStorage (nova.js apparenceClasse), elle reste la page Reglages de Nova. */
  try {
    var rg = JSON.parse(sessionStorage.getItem('nova-reglages-enregistre') || 'null');
    if (rg && Date.now() - rg.quand < 60000) d.classList.add('nova-page-reglages', 'nova-reglages-retour');
  } catch (e) { /* sans stockage : page Apparence */ }
  var defaut = mt ? [] : ['add_sheet', 'add_exam', 'participantview', 'nova_suivi', 'Score1', 'SE_mod', 'backteacher', 'SE_config', 'modtool'];
  var menu = window.novaMenu = { defaut: defaut, garde: defaut.slice(), inverse: mt, suffixe: suf, contexte: mt ? 'modtool-' : '', style: function (liste) {
    var k = liste.filter(function (c) { return typeof c === 'string' && c && !/[^A-Za-z0-9_-]/.test(c); })
      .map(function (c) { return '.' + c; }).join(', ') || '.nova-aucune';
    var p = '.nova-menu-simple:not(.nova-menu-edition) body:has(#nova-menu-bascule) #wimsmenumodubox ';
    if (mt) {
      /* Entrees cachees ; un titre seulement quand toutes les entrees de sa famille le sont. */
      var tm = p + '.menu_title:has(+ * .menuitem):not(:has(+ * .menuitem:not(:is(' + k + '))))';
      return p + '.menuitem:is(' + k + '):not(.nova-deconnexion), ' + tm + ', ' + tm + ' + * { display: none !important; }';
    }
    var titre = p + '.menu_title:not(:has(+ * :is(' + k + ')))';
    /* Deconnexion (rubrique Profil) : jamais masquee, meme avec toute sa rubrique. */
    return p + '.menuitem:not(:is(' + k + '), .nova-deconnexion), ' + titre + ', ' + titre + ' + :not(:has(.nova-deconnexion)) { display: none !important; }';
  } };
  try {
    if (localStorage.getItem('nova_menu' + suf) !== 'complet') d.classList.add('nova-menu-simple');
    var g = JSON.parse(localStorage.getItem('nova_menu_garde' + suf) || 'null');
    if (Array.isArray(g)) menu.garde = g;
  } catch (e) { d.classList.add('nova-menu-simple'); }
  var s = document.createElement('style');
  s.id = 'nova-menu-style';
  s.textContent = menu.style(menu.garde);
  document.head.appendChild(s);
})();
</script>
<meta name="nova-structure" content="$wims_superclass">
<meta name="nova-classe" content="$wims_class">
<meta name="nova-utilisateur" content="$wims_user">
<script>/* Nova : reglages pour rapprocher du theme standard (html.nova-std-...), poses avant l'affichage. La feuille
   de la classe est deja chargee (valeur calculee) ; site et structure : copie gardee par nova.js (sessionStorage,
   reglagesStructure). nova.js (reglagesStandard) recalcule ensuite. Pas de signe dollar ici. */
(function () {
  var d = document.documentElement;
  var lire = function (cle) { var o = {}; try { (sessionStorage.getItem(cle) || '').replace(/--nova-std-([a-z-]+)\s*:\s*(oui|non)/g, function (m, k, v) { o[k] = v; }); } catch (e) {} return o; };
  var site = lire('nova-reglages-site');
  var m = document.querySelector('meta[name="nova-structure"]');
  var st = m && m.content ? lire('nova-reglages-' + m.content) : {};
  /* La feuille de la classe arrive apres ce script : nova.js garde pour la session les reglages calcules de
     chaque classe (nova-std-<classe>), repris ici ; sinon site et structure. */
  var mc = document.querySelector('meta[name="nova-classe"]');
  var connu = null;
  try { connu = sessionStorage.getItem('nova-std-' + (mc ? mc.content : '')); } catch (e) {}
  ['menus', 'navigation', 'reponse', 'examens', 'textes', 'listes', 'menu-complet', 'dominos'].forEach(function (k) {
    var v = connu !== null ? ((' ' + connu + ' ').indexOf(' ' + k + ' ') >= 0 ? 'oui' : 'non') : (st[k] || site[k] || 'non');
    if (v === 'oui') d.classList.add('nova-std-' + k);
  });
  /* Rubriques masquees aux eleves (meme memoire de session : jetons sans-communication, sans-liens). Reglage
     --nova-masques-eleves s'il est pose, sinon l'ancien --nova-communication-eleves. */
  var val = function (cle, nom) { try { var m2 = new RegExp('--nova-' + nom + '\\s*:\\s*([^;}\\n]*)').exec(sessionStorage.getItem(cle) || ''); return m2 ? m2[1].trim() : ''; } catch (e) { return ''; } };
  var cles = [m && m.content ? 'nova-reglages-' + m.content : '', 'nova-reglages-site'];
  var premier = function (nom) { var v = ''; cles.forEach(function (c) { if (!v && c) v = val(c, nom); }); return v; };
  ['communication', 'liens'].forEach(function (r) {
    var sans;
    if (connu !== null) sans = (' ' + connu + ' ').indexOf(' sans-' + r + ' ') >= 0;
    else {
      var liste = premier('masques-eleves');
      sans = liste && liste !== 'defaut' ? (' ' + liste.replace(/,/g, ' ') + ' ').indexOf(' ' + r + ' ') >= 0 : r === 'communication' && premier('communication-eleves') === 'non';
    }
    if (sans) d.classList.add('nova-sans-' + r);
  });
  /* Couleur personnelle d'un eleve (2026-11-07) : gardee par nova.js (couleurPerso) sous nova-couleur|<structure ou
     classe>|<login>, posee ici avant l'affichage, examens compris. */
  try {
    var mu = document.querySelector('meta[name="nova-utilisateur"]');
    var racine = (m && m.content) || (mc ? mc.content.split('/')[0] : '');
    var coul = mu && mu.content && racine ? localStorage.getItem('nova-couleur|' + racine + '|' + mu.content) : '';
    var cs = (coul || '').split(' '), hex = function (x) { return !!x && x.length === 7 && /^#[0-9a-fA-F]{6}/.test(x); };
    if (hex(cs[0])) d.style.setProperty('--nova-accent', cs[0]);
    /* Degrade (2026-11-07) : << #accent #seconde >>, html.nova-degrade et --nova-degrade (_css/couleur.css). */
    if (hex(cs[0]) && hex(cs[1])) {
      d.style.setProperty('--nova-degrade', 'linear-gradient(90deg, ' + cs[0] + ', ' + cs[1] + ')');
      d.classList.add('nova-degrade');
    }
  } catch (e) {}
  /* Menu enseignant complet par defaut : seulement si l'enseignant n'a rien choisi lui-meme. */
  try { if (d.classList.contains('nova-std-menu-complet') && localStorage.getItem('nova_menu') === null) d.classList.remove('nova-menu-simple'); } catch (e) {}
})();
</script>
<script src="html/themes/$wims_theme/js/nova.js?v=f3399818f0" defer></script>

