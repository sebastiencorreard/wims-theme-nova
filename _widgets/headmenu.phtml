!default div1=div
<!-- Nova/_widgets/headmenu.phtml -->
!! Copie de themes/_widgets/headmenu.phtml : écrit les entrées de la barre du haut ($wims_hm,
!! préparées par html/headmenu*.phtml). Seule différence : l'entrée « chrono » (session d'examen,
!! html/headmenu_user.phtml) devient le chronomètre de Nova. Son contenu WIMS - le span
!! #chrono_exam et le script clockid() qui le fait décompter et recharge la fenêtre parente - est
!! écrit tel quel à l'intérieur ; js/nova.js lit le décompte et pose les états (data-etat).
!! Textes : lang/name.phtml.<langue> du thème, lus par html/headmenu*.phtml.
!default nova_chrono_libelle=Time left
!default nova_chrono_5min=Less than 5 minutes left
!default nova_chrono_1min=Last minute
!default nova_chrono_fin=Time is up
!default nova_chrono_fin_detail=Answers sent now will not be taken into account.
!default nova_chrono_fin_a=Ends at
!default nova_profil=Profile
!default nova_plus=More
!default nova_retour=Back
!default nova_terminer=Finish
!default nova_fin_session=You have finished.
!default nova_fin_session_detail=Click on Finish to close this session: you will then be able to start another exam. You will be logged out.
!default nova_parcours=Exercise %n of %t
!default nova_parcours_reussi=passed
!default nova_parcours_a_faire=to do
!default nova_parcours_en_cours=in progress
!default nova_parcours_note=scored
!default nova_parcours_termine=finished
!default nova_parcours_titre=Course progress
!for i_=1 to $wims_hm_cnt
  !set 1_=!line $i_ of $wims_hm
  !set wims_ref_class = !item 1 of $1_
  !if " isin $wims_ref_class
    !reset wims_ref_class
  !endif
  !if $wims_ref_class=chrono
    <$div1 class="menuitem chrono">
    <div class="nova-chrono" data-etat="normal" data-texte-5min="$nova_chrono_5min" data-texte-1min="$nova_chrono_1min" data-texte-fin="$nova_chrono_fin" data-texte-fin-detail="$nova_chrono_fin_detail" data-texte-fin-a="$nova_chrono_fin_a">
      <svg class="nova-chrono-icone" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2.5M9 2h6"></path></svg>
      <span class="nova-chrono-libelle">$nova_chrono_libelle</span>
      <span class="nova-chrono-temps" role="timer" aria-label="$nova_chrono_libelle">
      !read $(w_path)oneitem.phtml $1_
      </span>
    </div>
    </$div1>
  !else
    <$div1 class="menuitem $wims_ref_class">
    !read $(w_path)oneitem.phtml $1_
    </$div1>
  !endif
  !reset wims_ref_class
!next i_
!! Textes du thème pour js/nova.js, utiles aussi hors de la fenêtre d'exercice (page de l'examen,
!! où le chronomètre est recopié depuis la page ; section « Profil »).
<span id="nova-textes" hidden data-libelle="$nova_chrono_libelle" data-texte-5min="$nova_chrono_5min" data-texte-1min="$nova_chrono_1min" data-texte-fin="$nova_chrono_fin" data-texte-fin-detail="$nova_chrono_fin_detail" data-profil="$nova_profil" data-plus="$nova_plus" data-retour="$nova_retour" data-terminer="$nova_terminer" data-fin-session="$nova_fin_session" data-fin-session-detail="$nova_fin_session_detail" data-parcours="$nova_parcours" data-parcours-reussi="$nova_parcours_reussi" data-parcours-a-faire="$nova_parcours_a_faire" data-parcours-en-cours="$nova_parcours_en_cours" data-parcours-note="$nova_parcours_note" data-parcours-termine="$nova_parcours_termine" data-parcours-titre="$nova_parcours_titre"></span>
<!-- end Nova/_widgets/headmenu.phtml -->
