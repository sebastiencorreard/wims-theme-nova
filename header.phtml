!if $module = home
  !set w_path = ./adm/
!else
  !set w_path = $empty
!endif
<!-- begin of standard/header.phtml -->
!read themes/$wims_theme/_widgets/accent.phtml
!read themes/$wims_theme/_widgets/couleurs-notes.phtml
!! Titre de l'onglet du navigateur traduit (audit, 2026-11-13, utilisateur) : WIMS y met le titre anglais de l'index du
!! module ($module_title2 : "Scores of the participants") ; ici title_<langue> de l'index, et le nom de la classe sur
!! l'accueil d'une classe ("WWW Interactive Multipurpose Server" sinon). Pose par nova.js (titreOnglet).
!set nova_to=!module title_$lang $module
!if $module=home and $wims_classname!=$empty
  !set nova_to=$wims_classname
!endif
!if $nova_to!=$empty
  !set nova_to=!replace internal " by &quot; in $nova_to
<template id="nova-titre-onglet" data-titre="$nova_to"></template>
!endif
!reset nova_to

!! Jeu d'icones Lucide de Nova (2026-11-11) : lien gifs/themes/Lucide vers icones/Lucide du theme, pour qu'il
!! figure dans le choix "Jeu d'icones" de WIMS (pages de configuration seulement : un test par page).
!if $module=adm/class/config or $module=adm/manage
  !set nova_ji=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/jeu-icones.sh "$wims_home" "$wims_theme"
  !reset nova_ji
!endif
!! Reglages de Nova pour tout le site (log/nova.conf), enregistres par le gestionnaire : _widgets/reglages-site.phtml.
!if $module=adm/manage and $wims_ismanager=2
  !read themes/$wims_theme/_widgets/reglages-site.phtml
!endif
!! Zones dependantes : propagation des reglages Nova (nova_propager) : _widgets/propager.phtml.
!if ($module=home or $module=adm/class/config) and $wims_user=supervisor and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/propager.phtml
!endif
!! Desactiver malgre le partage (page de refus, puis action sur l'accueil) : _widgets/desactiver.phtml.
!if $wims_user=supervisor and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/desactiver.phtml
!endif
!! Zones dependantes aux reglages ou a la restriction d'acces differents : _widgets/ecarts-zones.phtml.
!if $module=adm/class/config and $wims_user=supervisor and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/ecarts-zones.phtml
!endif
!! Lecture seulement la ou wimshome/log est lisible (module home et adm/...) ; ailleurs, nova.js reprend la
!! derniere valeur lue (sessionStorage).
!set nova_m=!char 1 to 4 of $module
!if $module=home or $nova_m=adm/
  !! Seules les declarations --nova-..., sans < (audit du 2026-11-12, comme user.phtml).
  !set nova_site=!sh LC_ALL=C grep -ao -- '--nova-[a-z0-9-]*[[:space:]]*:[^;}]*' $wims_home/log/nova.conf 2>/dev/null | tr -d '<' | sed 's/$$/;/'
  !! Toujours transmis, meme vide (reglages retires : nova.js oublie l'ancienne valeur gardee).
<script type="text/plain" id="nova-css-site">$nova_site</script>
!endif
!! Page Apparence (configuration du site, rubrique 1) : carte « Reglages de Nova » et reglages de WIMS sans effet
!! avec Nova (repères par leur nom dans lang/confdata, leur rang donne le champ conf_N). Placees par nova.js.
!if $module=adm/manage and $wims_ismanager=2 and $job=conf and $confcat=1
  !read themes/$wims_theme/_widgets/apparence.phtml
!endif
!! Page Apparence de la configuration d'une classe, d'un groupement ou d'un portail : meme carte, ecrite dans
!! la feuille de style de la classe (js/nova.js, apparenceClasse). WIMS ne montre cette page qu'a qui en a le droit.
!if $module=adm/class/config and $wims_user!=$empty and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/apparence-classe.phtml
!endif
!! Restriction d'acces d'une classe : formulaire Nova (js/nova.js, accesClasse ; 2026-11-10).
!if $module=adm/class/config and $wims_user!=$empty and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/acces-classe.phtml
  !read themes/$wims_theme/_widgets/capacite.phtml
  !read themes/$wims_theme/_widgets/config-globale.phtml
!endif
!! Sequences pedagogiques : glisser-deposer, numero seul, textes (_widgets/sequences.phtml ; 2026-11-12).
!if ($module=adm/class/sequence or $module=home) and $wims_user!=$empty and $wims_class!=$empty
  !read themes/$wims_theme/_widgets/sequences.phtml
!endif
!! Preparation d'une feuille ou d'un examen : bandeau d'etat et reglages en tuiles (js/nova.js, ficheRessource ; 2026-11-12).
!if ($module=adm/class/sheet or $module=adm/class/exam) and $wims_user!=$empty
  !read themes/$wims_theme/_widgets/fiche-ressource.phtml
!endif
!! Detail des notes d'un eleve en cartes (adm/class/userscore ; js/nova.js, notesDetail ; 2026-11-13).
!if $module=adm/class/userscore and $wims_user!=$empty
  !read themes/$wims_theme/_widgets/notes-detail.phtml
!endif
!! Liens de connexion (scripts/adm/class/links.phtml) : cartes et boutons Copier (js/nova.js, liensConnexion ; 2026-11-10).
!if adm/class isin $module and $wims_user!=$empty
  !read themes/$wims_theme/lang/name-textes.phtml.$lang header
!endif
!! Choix gardes sur le serveur : menu personnalise et classes repliees de l'enseignant (_widgets/menu-serveur.phtml,
!! replis-classes.phtml), couleur personnelle de l'eleve (_widgets/couleur-choix.phtml).
!if ($module=home or $nova_m=adm/) and $wims_user!=$empty and $wims_class!=$empty and ($wims_developer=$empty or $module=adm/modtool)
  !read themes/$wims_theme/_procs/eleve.proc
  !if $nova_est_eleve!=yes
    !read themes/$wims_theme/_widgets/menu-serveur.phtml
  !endif
  !if $nova_est_eleve=yes and $module=home
    !read themes/$wims_theme/_widgets/couleur-choix.phtml
  !endif
!endif
!reset nova_m nova_site
!! Header menu bar definition.
!nocache
!set wims_theme_header=yes
!set jquery_defined=yes

!default wims_theme_icon=$class_theme_icon
!default wims_theme_icon=wimsedu

!if _help isin $wims_session
  <div id="wimsmhelp">
!endif

!if _exam isin $wims_session
  <div id="wimsexam">
!endif

!if $wims_lightpopup=yes
  <div id="wimslightpopup">
   <link rel="stylesheet" href="html/themes/_css/light.css">
!endif

!set wims_theme_version=1
!set current_module=!replace / by , in $module
!set module_path= !item 1 of $current_module

!! Nova : la deconnexion d'un eleve (lien de html/headmenu_user.phtml) ramene a la page de connexion de sa
!! classe, ou de son portail ou groupement ($wims_superclass), au lieu de la liste des classes (demande de
!! l'utilisateur, 2026-10-05), identifiant pre-rempli (auth_user). WIMS ferme la session (cmd=close) et
!! ouvre cette page dans la meme requete.
!! Pas pour une classe a authentification CAS (lien different, laisse tel quel).
!if $wims_class!=$empty and $wims_user!=supervisor and $wims_user!=$empty and anonymous notin $wims_user and $class_cas_auth=$empty
  !set nova_entree=$wims_superclass
  !default nova_entree=$wims_class
  !set wims_link_close=!replace internal cmd=close&module=adm/class/classes&type=participant by cmd=close&module=adm/class/classes&type=authparticipant&class=$nova_entree&auth_user=$wims_user in $wims_link_close
!endif

!! Nova : classe (ou portail, groupement) en authentification CAS, page de connexion sans session : adresse de
!! connexion CAS de la classe (comme le bouton « Entrer » de la liste des classes, participant2.phtml), pour que
!! nova.js (reconnexionCas) y renvoie l'eleve qui vient de terminer une session d'examen ; le CAS, qui le
!! connait encore, le ramene dans la classe (demande de l'utilisateur, 2026-10-06).
!if $module=adm/class/classes and $type=authparticipant and $wims_user=$empty and $class!=$empty
  !set nova_ss=!replace internal / by , in $class
  !set nova_ss=$(nova_ss[1])
  !set nova_idp=!defof class_authidp in wimshome/log/classes/$nova_ss/.def
  !set nova_idp=$(nova_idp[1;])
  !if $nova_idp=cas
    !set nova_cas=!defof class_cas_auth in wimshome/log/classes/$nova_ss/.def
    !default nova_cas=!defof cas_auth in wimshome/log/wims.conf
    !if $nova_cas!=$empty
      !! Adresse de retour encodee par nova.js : adm/codeurl de WIMS depend de liburi-perl (absent ici, adresse vide).
      !! Numero filtre : $class vient de l'adresse (2026-11-12).
      !set nova_cc=!text select 0123456789/ in $class
      <span id="nova-cas" hidden data-cas="$nova_cas" data-service="$wims_ref_name?module=adm/class/classes&amp;type=authparticipant&amp;class=$nova_cc"></span>
    !endif
  !endif
  !reset nova_ss nova_idp nova_cas nova_cc
!endif

!if $[$wims_home_items_cnt + $wims_hm_cnt + $wims_link_close_cnt]!=0 or ($module_path notitemof home,adm,classes and _exam notin $session and $module_init_parm == $empty)
  !if $module!=home or $wims_user!=
    <div id="wimstopbox">
    !distribute items span into div1
    <div class="wimsmenu menu float_left">
    !read themes/$wims_theme/_widgets/headhome.phtml
    !! Nova : le nom de la classe a cote de l'accueil (pas pendant un examen : place au chronometre).
    !if $wims_classname!=$empty and _exam notin $wims_session
      <span class="nova-classe">$wims_classname</span>
    !endif
    !read themes/$wims_theme/_widgets/examencours.phtml
    !! Nova : marque des participants (eleves) : fil d'Ariane masque, bouton Retour (js/nova.js).
    !read themes/$wims_theme/_procs/eleve.proc
    !if $nova_est_eleve=yes
      <span id="nova-eleve" hidden></span>
      !! html.nova-role-eleve (audit B2 point 4, 2026-11-13) : remplace body:has(#nova-eleve) dans le CSS, recalcul moins cher.
      <script>document.documentElement.classList.add('nova-role-eleve');</script>
      !! Nova : jetons de l'avatar a jour sur la page d'une feuille (retour d'exercice ; l'accueil passe par user.phtml).
      !if $module=adm/sheet
        !read themes/$wims_theme/_widgets/avatar-barre.phtml
      !endif
    !endif
    </div>
    !distribute items li into div1
    !read themes/$wims_theme/_widgets/user_links.phtml
    <div class="wimsmenu menu">
    !!read themes/_widgets/headmenu.phtml
    !!read themes/_widgets/about.phtml
    !if _help notin $wims_session
      !distribute items div,span into div0,div1
!!## technical parameters FIXME, should be elsewere
      !if $class_cas_auth=$empty
        !set m_init_parm=!replace internal & by $ $ in $module_init_parm
        !set class_cas_auth=!getopt class_auth in $m_init_parm
      !endif
      !if $class_cas_auth!=$empty and $wims_class=$empty
        <$div1 class="menuitem">
        !read adm/class/logout_cas
        </$div1>
      !endif
    !endif
    </div><!--wimsmenu-->
    <br class="clearall">
    !reset div1
    </div><!--wimstopbox-->
    !if _light notin $wims_session
      !read themes/$wims_theme/_widgets/ariane.phtml
    !endif
  !endif
!endif

!if $module!=home or $wims_user!=
  <div id="wimsbodybox">
    <div id="wimspagebox">
!endif

!read themes/_widgets/alertchat.phtml

<!-- end of standard/header.phtml -->
