!set nova_bdg_per_regle4=/10.
!set nova_bdg_per_examens=Inclure les notes d'examens
!set nova_bdg_ech_desc=S'entraîner avant chaque DM noté : deux examens au même contenu, beaucoup d'essais pour l'entraînement, peu pour le DM noté. 8 niveaux, jamais perdus.
!set nova_bdg_ech_paliers=Paliers du badge Échauffement
!set nova_bdg_ech_paliers_aide=DM préparés, pour chacun des 8 niveaux, séparés par des espaces. Vide : valeur héritée. 0 : niveau obtenu d'office, pour tester (il reste acquis par l'élève).
!set nova_bdg_ech_sessions1=Compter un DM quand l'élève a fait au moins
!set nova_bdg_ech_sessions2=sessions complètes de l'entraînement (une réponse à chaque exercice) avant d'ouvrir le DM noté.
!set nova_bdg_ech_mots=Reconnaître aussi les DM par leur titre
!set nova_bdg_ech_mots_aide=Quand les deux examens n'ont pas le même contenu : mots qui distinguent les titres, séparés par des virgules, le reste du titre identique (« DMWIMS 02 (entraînement) », « DMWIMS 02 (noté) »). Accents et majuscules ignorés. Vide : valeur héritée.
!set nova_bdg_ech_mots_t=Entraînement
!set nova_bdg_ech_mots_n=DM noté
!set nova_bdg_top_desc=Réussir les DM notés : note retenue d'au moins 9/10 (réglable). DM notés reconnus d'après l'onglet DM WIMS. 8 niveaux, jamais perdus.
!set nova_bdg_top_paliers=Paliers du badge Au top
!set nova_bdg_top_paliers_aide=DM au top, pour chacun des 8 niveaux, séparés par des espaces. Vide : valeur héritée. 0 : niveau obtenu d'office, pour tester (il reste acquis par l'élève).
!set nova_bdg_top_seuil1=Compter un DM quand la note retenue au DM noté atteint au moins
!set nova_bdg_top_seuil2=sur 10.
!set nova_bdg_coul_phrase3=, et les dégradés au niveau
!set nova_bdg_coul_degrade=Niveau qui débloque les dégradés
!set nova_bdg_coul_titre=Couleur personnelle des élèves
!set nova_bdg_coul_aide=Une récompense : l'élève choisit la couleur de son interface dans une palette lisible (menu du profil, « Ma couleur »), puis un dégradé (barre du haut, boutons, titres des fenêtres). Une fois choisie, elle vaut dans toute la classe, le groupement ou le portail, examens compris.
!set nova_bdg_coul_phrase1=Débloquer le choix au niveau
!set nova_bdg_coul_phrase2=du badge
!set nova_bdg_coul_niveau=Niveau qui débloque la couleur
!set nova_bdg_coul_badge=Badge qui débloque la couleur
!set nova_bdg_coul_aucun=personne (désactivé)
!set nova_bdg_coul_herite_vide=valeur héritée
!set nova_bdg_reglages=Réglages
!set nova_app_fil=Fil d'Ariane fixe
!set nova_app_fil_aide=Profs et admins, grand écran : le fil d'Ariane reste sous la barre du haut quand la page défile.
!set nova_app_deco=Décorations de saison
!set nova_app_deco_aide=Guirlande et flocons sous la barre du haut en décembre (d'autres fêtes viendront) ; jamais pendant un examen.
!set nova_bdg_av_titre=Avatar des élèves
!set nova_bdg_av_aide=Les élèves gagnent des pièces en réussissant des exercices et débloquent avec elles des éléments de leur avatar (entrée « Mon avatar » du menu Profil). Certains éléments sont des récompenses des badges. L'avatar vaut dans toute la classe, le groupement ou le portail ; seuls l'élève et ses enseignants le voient.
!set nova_bdg_av_actif=Avatar des élèves
!set nova_bdg_av_oui=proposé
!set nova_bdg_av_regle1=Un exercice compte à partir de la note
!set nova_bdg_av_regle2=sur 10, si la réponse arrive au moins
!set nova_bdg_av_regle3=secondes après son ouverture, une fois par jour ; au plus
!set nova_bdg_av_regle4=exercices par jour.
!set nova_bdg_av_paliers=Paliers des pièces
!set nova_bdg_av_paliers_aide=Nombre d'exercices réussis qu'il faut pour chaque pièce (par défaut : 3 10 20 30 40).
!set nova_bdg_av_pas1=Ensuite, une pièce tous les
!set nova_bdg_av_pas2=exercices réussis.
!set nova_bdg_av_depart1=Chaque élève commence avec
!set nova_bdg_av_depart2=pièce(s) offerte(s), pour personnaliser son avatar tout de suite.
!set nova_mois=janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre
!set nova_version_dev=version de développement
!set nova_app_desact=Désactiver malgré le partage
!set nova_app_desact_aide=Ajoute un bouton « Désactiver quand même... » quand WIMS refuse de désactiver un examen ou une feuille partagés avec d'autres classes.
!set nova_app_desact_danger=Dangereux : l'examen ou la feuille est désactivé dans toutes les classes du partage, et son contenu redevient modifiable ; un changement désaccorde les notes déjà enregistrées, dans toutes ces classes. WIMS l'interdit pour ces raisons. À n'activer qu'en connaissance de cause.
!set nova_version_lien=Nouveautés de chaque version (nouvel onglet)
!set nova_rg_affichage=Affichage
!set nova_rg_eleves=Élèves
!set nova_rg_dm=DM WIMS
!set nova_rg_badges=Badges et récompenses
!set nova_rg_avances=Réglages avancés
!set nova_rg_dm_aide=Un DM WIMS, c'est un examen d'entraînement (beaucoup de sessions) et un examen noté (peu de sessions) au même contenu. Nova les reconnaît à leur titre. Les accents et les majuscules ne comptent pas.
!set nova_rg_dm_usage=Ces réglages servent à :
!set nova_rg_dm_usage1=<strong>« Créer le DM noté »</strong> : bouton de votre accueil, à côté d'un DM d'entraînement qui n'a pas encore son DM noté ; il en fait une copie « En préparation », titrée avec un mot de DM noté et réglée sur le nombre de sessions ci-dessous.
!set nova_rg_dm_usage2=<strong>Badge Échauffement</strong> : un DM compte quand l'élève a fait assez de sessions complètes de l'entraînement avant d'ouvrir le DM noté.
!set nova_rg_dm_usage3=<strong>Badge Au top</strong> : DM notés réussis (note retenue au moins égale au seuil du badge).
!set nova_rg_dm_mots=Mots-clés d'un DM WIMS
!set nova_rg_dm_mots_aide=Obligatoire : le titre d'un DM WIMS, d'entraînement comme noté, contient l'un de ces mots, éventuellement suivi d'un numéro (DMWIMS03).
!set nova_rg_dm_note=Mots-clés d'un DM noté
!set nova_rg_dm_note_aide=Le titre d'un DM noté contient en plus l'un de ces mots.
!set nova_rg_dm_ent=Mots-clés d'un DM d'entraînement
!set nova_rg_dm_ent_aide=Le titre d'un DM d'entraînement contient en plus l'un de ces mots. Un entraînement et son DM noté ont le même contenu, ou le même titre à ce mot près.
!set nova_rg_dm_essais1=« Créer le DM noté » lui donne
!set nova_rg_dm_essais2=sessions.
!set nova_bdg_coul_ligne1=Couleur :
!set nova_bdg_coul_ligne2=Dégradés :
!set nova_bdg_coul_au_niveau=au niveau
!set nova_bdg_coul_badge_deg=Badge qui débloque les dégradés
!set nova_bdg_coul_meme_badge=même badge que la couleur
!set nova_bdg_coul_ordre=Les dégradés ne s'ouvrent qu'une fois la couleur débloquée.
