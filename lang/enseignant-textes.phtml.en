<template id="nova-editeur-textes" data-find="Find" data-replace="Replace" data-next="next" data-previous="previous" data-all="all" data-match-case="match case" data-regexp="regexp" data-by-word="by word" data-replace-1="replace" data-replace-all="replace all" data-close="close" data-current-match="current match" data-replaced="replaced $ matches" data-replaced-line="replaced match on line $" data-on-line="on line" data-go-to-line="Go to line" data-go="go" data-source="Source" data-control-character="Control character" data-undo="Undo" data-redo="Redo" data-text-size="Text size" data-smaller="Smaller text" data-larger="Larger text" data-default="default" data-full-screen="Full screen" data-exit-full-screen="Exit full screen" data-syntax="Syntax" data-of="of" data-no-results="No results" data-show-replace="Show or hide replace"></template>
