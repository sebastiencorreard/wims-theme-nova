!! Lu par header.phtml : superviseur, adm/class/config.
!! Pages Apparence et Badges Nova d'une structure (2026-11-07, utilisateur) : zones dependantes dont les blocs Nova
!! different de ceux de la structure (copie ancienne ou reglage de la zone). nova.js (ecartsZones) en fait une alerte
!! avec un bouton qui propage (accueil, nova_propager). Memes droits que la propagation.
!set nova_ct=!getdef class_type in wimshome/log/classes/$wims_class/.def
!if $nova_ct isitemof 2,3,4
  !set nova_tn=!getdef class_typename in wimshome/log/classes/$wims_class/.def
  !set nova_sup=!getdef class_superclass in wimshome/log/classes/$wims_class/.def
  !set nova_ez=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/propager.sh "$wims_home" "$wims_class" "$nova_tn" "$nova_sup" apparence,badges ecarts
!read themes/$wims_theme/lang/enseignant-textes.phtml.$lang ecarts_zones_1
  !! Restriction d'acces (2026-11-10, utilisateur) : zones dont access.conf differe ; nova.js (accesClasse) propose, apres
  !! l'enregistrement, de la leur appliquer par la propagation de WIMS (job=propagate, propagate=access).
  !set nova_ea=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/propager.sh "$wims_home" "$wims_class" "$nova_tn" "$nova_sup" acces ecarts
!read themes/$wims_theme/lang/enseignant-textes.phtml.$lang ecarts_zones_2
!endif
!reset nova_ct nova_tn nova_sup nova_ez nova_ea
