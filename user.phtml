:normal
!! Nova : bouton Mes notes bien visible, tout en haut de l'accueil de l'eleve (demande de l'utilisateur,
!! 2026-10-03). Lien du menu de WIMS (module adm/class/userscore), libelle de WIMS.
!! Nova : badges de l'eleve (demande de l'utilisateur, 2026-10-07 : Fidelite ; 2026-10-09 : Persevérance). Calcul par
!! _procs/badges.awk (Fidelite : semaines avec assez d'exercices, vacances sautees ; Perseverance : exercices reussis
!! apres des notes faibles) ; reglages --nova-badges, --nova-badges-actifs, --nova-fidelite-*, --nova-perseverance-*,
!! --nova-echauffement-* (2026-11-06 : DM WIMS prepares), --nova-vacances lus dans les feuilles du site, de la structure et de la classe (la derniere l'emporte) ; niveaux
!! gardes dans score/<eleve>.nova_badges (avant le 2026-11-12 : .nova, renomme a la visite suivante ; jamais perdus, annonces une seule fois). Une seule pastille « Badges » (maquette B,
!! 2026-10-09), fenetre a onglets (nova.js fenetreBadges). Pas dans l'accueil d'un portail ou d'un groupement (le
!! travail est dans ses zones), ni en examen.
!reset nova_bdg nova_lf nova_lp nova_lh nova_ld nova_lc nova_lr nova_lt nova_lu nova_xn
!if $wims_user!=supervisor and $wims_user!=$empty and _exam notin $wims_session
  !ifval 0$class_type<2
    !set nova_cl=$wims_home/log/classes
    !set nova_auj=!char 1 to 8 of $wims_now
    !! Au top (2026-11-07) : note retenue (sur 10, calculee par WIMS) de chaque examen commence, « n:note ».
    !set nova_xc=!sh f="$nova_cl/$wims_class/score/$wims_user.exam"; [ -f "$$f" ] && awk '$$2=="00" {print $$1}' "$$f" | sort -un | tr '\n' ' '
    !set nova_xn=
    !if $nova_xc!=$empty
      !set nova_xs=!examscore user=$wims_user
      !set nova_xs=!line 1 of $nova_xs
      !set nova_k=!wordcnt $nova_xs
      !for nova_i=1 to $nova_k
        !if $nova_i iswordof $nova_xc
          !set nova_v=!word $nova_i of $nova_xs
          !set nova_xn=$nova_xn $nova_i:$nova_v
        !endif
      !next
    !endif
    !set nova_bd=!sh { echo '#conf'; cat $wims_home/log/nova.conf $nova_cl/$wims_superclass/css $nova_cl/$wims_class/css 2>/dev/null; echo; echo '#stock'; o=$nova_cl/$wims_class/score/$wims_user.nova; [ -f "$$o" ] && { [ -e "$$o"_badges ] || mv -f "$$o" "$$o"_badges; rm -f "$$o"; }; cat "$$o"_badges 2>/dev/null; echo '#score'; cat $nova_cl/$wims_class/score/$wims_user $nova_cl/$wims_class/noscore/$wims_user 2>/dev/null; } | awk -v auj=$nova_auj -v classe=$nova_cl/$wims_class -v "notes=$nova_xn" -f $wims_home/public_html/themes/$wims_theme/_procs/badges.awk
    !set nova_lf=!line 1 of $nova_bd
    !set nova_lp=!line 2 of $nova_bd
    !set nova_lh=!line 3 of $nova_bd
    !set nova_lt=!line 4 of $nova_bd
    !set nova_lu=!line 5 of $nova_bd
    !set nova_ld=!line 6 of $nova_bd
    !set nova_lc=!line 7 of $nova_bd
    !set nova_lr=!line 8 of $nova_bd
    !set nova_le=!line 9 of $nova_bd
    !set nova_le=!word 2 of $nova_le
    !if $nova_le=1
      !set nova_st=!line 10 to -1 of $nova_bd
      !writefile wimshome/log/classes/$wims_class/score/$wims_user.nova_badges $nova_st
    !endif
    !set nova_fo=!word 2 of $nova_lf
    !set nova_po=!word 2 of $nova_lp
    !set nova_ho=!word 2 of $nova_lh
    !set nova_to=!word 2 of $nova_lt
    !set nova_lu=!replace internal " by ' in $nova_lu
    !! Echauffement : DM note ouvert, pas encore commence (sessions faites, demandees, titre).
    !set nova_ld=!replace internal " by ' in $nova_ld
    !if $nova_fo=on or $nova_po=on or $nova_ho=on or $nova_to=on
      !set nova_bdg=on
    !endif
    !! Couleur personnelle (2026-11-07, utilisateur) : choisie par l'eleve une fois le niveau requis atteint (badge et
    !! niveau regles par l'enseignant, --nova-couleur-badge/-niveau), gardee pour toute la structure (portail,
    !! groupement) dans log/classes/<structure ou classe>/score/<login>.nova_couleur (ecrite par header.phtml ; ancien .nova_couleur_<login> repris ici) ; appliquee
    !! par nova.js (couleurPerso) et, sur chaque page, par le script de tete (htmlheader.phtml, localStorage).
    !! Reglage coupe (« personne ») : valeur vide, nova.js retire la couleur gardee. Badges coupes dans cette zone : rien,
    !! la couleur choisie ailleurs dans la structure reste.
    !set nova_cb=!word 10 of $nova_lr
    !set nova_cv=
    !if $nova_bdg=on and $nova_cb!=aucun and $nova_cb!=$empty
      !set nova_ck=$wims_superclass
      !default nova_ck=!word 1 of $wims_class
      !set nova_ck=!replace internal / by , in $nova_ck
      !set nova_ck=$(nova_ck[1])
      !set nova_cv=!sh r=$nova_cl/$nova_ck; u=$wims_user; o="$$r/.nova_couleur_$$u"; n="$$r/score/$$u.nova_couleur"; [ -n "$$u" ] && [ -f "$$o" ] && { if [ -e "$$n" ] && ! [ "$$o" -nt "$$n" ]; then rm -f "$$o"; else mv -f "$$o" "$$n"; fi; }; cat "$$n" 2>/dev/null | tr -cd 'a-z'
    !endif
    !! Toujours ecrit (2026-11-07) : data-bdg dit a nova.js si l'entree « Ma couleur » du menu existe ici.
    <div id="nova-couleur" hidden data-couleur="$nova_cv" data-bdg="$nova_bdg"></div>
    !! Exercice « en cours » de Perseverance (assez de notes faibles, pas encore de reussite) : son titre.
    !reset nova_ct
    !set nova_cx=!word 2 of $nova_lc
    !if $nova_po=on and $nova_cx!=- and $nova_cx!=$empty
      !set nova_cf=!word 3 of $nova_lc
      !set nova_co=!word 4 of $nova_lc
      !set nova_cn=!word 5 of $nova_lc
      !if $nova_cx=1
        !set nova_rec=!record $nova_co of wimshome/log/classes/$wims_class/exams/.exam$nova_cf
        !set nova_ct=!line 3 of $nova_rec
      !else
        !set nova_rec=!record $nova_co of wimshome/log/classes/$wims_class/sheets/.sheet$nova_cf
        !set nova_ct=!line 5 of $nova_rec
      !endif
      !set nova_ct=!replace internal " by ' in $nova_ct
      !set nova_ct=$nova_ct|$nova_cn
      !reset nova_cf nova_co nova_cn nova_rec
    !endif
    !reset nova_cl nova_auj nova_bd nova_le nova_st nova_cx
  !endif
!endif
