!! Nova : textes propres au thème (it). Lu par html/headmenu*.phtml (themes/$wims_theme/lang/).
!! Encodage latin-1 : WIMS sert ses pages en windows-1252.
!! Textes anglais d'abord (repli : un texte absent de cette langue s'affiche en anglais, jamais vide ; 2026-11-10).
!read themes/$wims_theme/lang/name.phtml.en
!set nova_menu_activites=Attività
!set nova_menu_participants=Partecipanti
!set nova_menu_communication=Comunicazione
!set nova_menu_classe=Classe
!set nova_menu_aide=Aiuto e strumenti
!set nova_examencours=Esame in corso
!set nova_examen_court=Esame
!set nova_explorer=Esplora
!set nova_taxonomie=Tassonomia
!set nova_glossaires=Glossari
!set nova_parcourir=Sfoglia il sito
!set nova_accueil=Home
!set nova_rg_rubrique=Impostazioni di Nova
!set nova_sv_titre=Monitoraggio in diretta
!set nova_avs_titre=Avatar degli studenti,Distintivi degli studenti
!set nova_pied=Condizioni,Contattaci
!! Version imprimable d'une feuille (adm/sheet, job=print : tous les exercices calcules dans une seule page) : le tampon
!! des noms de variables (32 Ko) y est presque plein avant la barre (debordement vu le 2026-11-12, serveur de l'utilisateur,
!! dans ce fichier). Seuls les textes de la barre et du menu ci-dessus y sont lus ; nova.js prend ses textes de secours.
!if $module=adm/sheet and $job=print
  !exit
!endif
!set nova_chrono_libelle=Tempo rimanente
!set nova_chrono_fin_detail_exo=Puoi ancora finire l'esercizio, ma il voto diminuisce con il passare del tempo.
!set nova_chrono_fin_detail_exo0=Una risposta inviata adesso avrà 0.
!set nova_examen_a_terminer=Esame da terminare
!set nova_examen_a_terminer_court=Termina
!set nova_badges_titre=I miei distintivi
!set nova_fid_nom=Regolarità
!set nova_fid_niveaux=Carta,Legno,Pietra,Ferro,Bronzo,Oro,Diamante,Cosmico
!set nova_std_textes=Testi standard
!set nova_per_nom=Perseveranza
!set nova_ech_nom=Riscaldamento
!set nova_top_nom=Al top
!set nova_bdg_av_non=non proposto
!! Suivi en direct (_widgets/suivi.phtml ; nova_svj_ : js/suivi.js), 2026-11-10.
