!! Nova : calcul de l'avatar de l'eleve par _procs/avatar.awk (lu par _widgets/avatar.phtml et _widgets/avatar-barre.phtml).
!! Entree : nova_av_ouvrir, nova_av_choix (vides : simple lecture). Sortie : nova_av (sortie de avatar.awk), nova_ak
!! (structure ou classe ou est garde le fichier de l'eleve), nova_cl, nova_auj. Module de confiance seulement (home, adm/...).
!set nova_cl=$wims_home/log/classes
!set nova_ak=$wims_superclass
!default nova_ak=!word 1 of $wims_class
!set nova_ak=!replace internal / by , in $nova_ak
!set nova_ak=$(nova_ak[1])
!set nova_auj=!char 1 to 8 of $wims_now
!set nova_av_ouvrir=!text select char abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789. in $nova_av_ouvrir
!set nova_av_choix=!text select char abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789., in $nova_av_choix
!! Fichier de l'eleve : <structure ou classe>/score/<login>.nova_avatar depuis le 2026-11-12 (utilisateur : sauvegarde et
!! nettoye avec les notes) ; l'ancien (.nova_avatar_<login> a la racine) est deplace a la premiere visite, ou efface si le
!! nouveau existe deja.
!! Zones = dossiers numerotes de la structure, sans entrer dans les autres (score, examlog, .users...) : un find sur
!! toute la structure a chaque accueil d'eleve pesait sur un gros portail (audit du 2026-11-12 ; meme sortie verifiee).
!set nova_av=!sh r=$nova_cl/$nova_ak; u=$wims_user; o="$$r/.nova_avatar_$$u"; n="$$r/score/$$u.nova_avatar"; [ -n "$$u" ] && [ -f "$$o" ] && { [ -e "$$n" ] && rm -f "$$o" || mv "$$o" "$$n"; }; z=$$(find "$$r" ! -name '[0-9]*' -prune -o -type d -print 2>/dev/null); { echo '#conf'; cat $wims_home/log/nova.conf $nova_cl/$wims_superclass/css $nova_cl/$wims_class/css 2>/dev/null; echo; echo '#fichier'; cat "$$n" 2>/dev/null; echo '#stock'; for d in $$z; do [ -f "$$d/score/$$u.nova" ] && cat "$$d/score/$$u.nova"; done; for d in $$z; do for s in score noscore; do [ -f "$$d/$$s/$$u" ] && { echo "#zone $$d"; cat "$$d/$$s/$$u"; }; done; done; } | awk -v auj=$nova_auj -v catalogue=$wims_home/public_html/themes/$wims_theme/_procs/avatar-catalogue.txt -v ouvrir=$nova_av_ouvrir -v choix=$nova_av_choix -f $wims_home/public_html/themes/$wims_theme/_procs/avatar.awk
