!! Nova : textes de nova.js en clair (it), lus par !read themes/$wims_theme/lang/suivi-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:suivi_1
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Considerare gli ultimi %1 minuti."><input id="nova-suivi-fenetre" type="number" min="1" max="120" step="1" value="60" aria-label="$nova_sv_a_fenetre"></p>
!exit

:suivi_2
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Indicare «senza azione» dopo %1 min."><input id="nova-suivi-inactivite" type="number" min="1" max="120" step="1" value="5" aria-label="$nova_sv_a_inactivite"></p>
!exit

:suivi_3
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Aggiornare ogni %1 s."><input id="nova-suivi-intervalle" type="number" min="10" max="300" step="1" value="30" aria-label="$nova_sv_a_intervalle"></p>
!exit

:suivi_4
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Quando almeno %1 degli ultimi %2 voti dell'esercizio sono sotto %3 /10."><input id="nova-suivi-erreurs" type="number" min="1" max="5" step="1" value="3" aria-label="$nova_sv_a_erreurs"> <input id="nova-suivi-resultats" type="number" min="1" max="100" step="1" value="5" aria-label="$nova_sv_a_resultats"> <input id="nova-suivi-note-faible" type="number" min="0" max="10" step="0.1" value="5" aria-label="$nova_sv_a_note_faible"></p>
!exit

:suivi_5
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Quando nessun voto arriva da %1 min sull'esercizio in corso."><input id="nova-suivi-attente" type="number" min="1" max="120" step="1" value="8" aria-label="$nova_sv_a_attente"></p>
!exit

:suivi_6
!! _widgets/suivi.phtml
      <p class="nova-suivi-phrase" data-phrase="Quando lo studente riavvia l'esercizio %1 volte dopo %2 voti di almeno %3 /10."><input id="nova-suivi-reprises" type="number" min="1" max="1000" step="1" value="4" aria-label="$nova_sv_a_reprises"> <input id="nova-suivi-reussites" type="number" min="1" max="100" step="1" value="3" aria-label="$nova_sv_a_reussites"> <input id="nova-suivi-note-reussite" type="number" min="0" max="10" step="0.1" value="9" aria-label="$nova_sv_a_note_reussite"></p>
!exit

:suivi_7
!! _widgets/suivi.phtml
  <template id="nova-suivi-textes" data-indispo="Il rilevamento non è disponibile. Clicca su Aggiorna per riprovare." data-ily-s="%1 s fa" data-ily-min="%1 min fa" data-aucun-signal="Nessun segnale su questo esercizio" data-why-difficulte="%1 risultati < %2/10 tra gli ultimi %3" data-why-repetition="%1 riavvii dopo %2 risultati &ge; %3/10" data-why-attente="Nessun risultato registrato da %1 min: da verificare" data-difficulte="$nova_svj_difficulte" data-attente="$nova_svj_attente" data-repetition="$nova_svj_repetition" data-travail="Al lavoro" data-silence="Senza azione" data-ancien="Sessione vecchia" data-f-actifs="Tutti" data-f-attention="Da andare a vedere" data-f-tous="Con le sessioni vecchie" data-g-repetition="Ripetizione dopo un successo" data-g-silence="Senza azione da %1 min" data-g-ancien="Sessioni aperte, fuori dalla finestra" data-examen="Esame %1 &middot; %2" data-feuille="Foglio %1 &middot; %2" data-chrono-titre="Cronologia &middot; ultimi %1 minuti" data-relances="%1 nuovi tentativi senza risposta: %2" data-pas-de-note="nessun voto" data-res-indispo="Risultato non disponibile" data-res-indispo-court="risultato non disponibile" data-note="voto" data-note-a="%1/10 alle %2" data-aucun-essai="Nessun tentativo registrato in questa finestra." data-quarante="Sono mostrati gli ultimi 40 eventi." data-partiel="Cronologia parziale: gli eventi più vecchi sono omessi." data-masquer="Nascondi la cronologia" data-voir-chrono="Vedi la cronologia di %1" data-masquer-chrono="Nascondi la cronologia di %1" data-passee="segnale dell'attività passata" data-pas-encore="ancora nessun voto" data-auto="Aggiorna ogni %1 s" data-n-classes="%1 classi o corsi" data-minutes="ultimi %1 minuti" data-releve-a="Rilevamento delle %1" data-actualisation="Aggiornamento&hellip;" data-impossible="Aggiornamento impossibile. Ultimo rilevamento: %1. %2" data-expiree="Sessione scaduta o accesso non disponibile: torna alla classe." data-err-trop="Troppe sessioni per questo rilevamento. Apri il monitoraggio da una classe o da un corso." data-err-refuse="Accesso negato." data-err-reserve="Accesso riservato ai docenti e agli amministratori delle loro classi." data-err-indispo="Rilevamento non disponibile. Aggiorna per riprovare." data-exo="Esercizio %1" data-accueil="Home" data-inconnue="Attività sconosciuta"></template>
!exit
