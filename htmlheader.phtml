<!-- Nova. ATTENTION : ce fichier est lu par le code C de WIMS (config.c), qui remplace les
     variables $... mais N'EXECUTE PAS les commandes ! (ni !if, ni les commentaires !!) : elles
     partiraient telles quelles dans la page. Ici, seulement du HTML, du CSS et des variables.
     Mode sombre : desactive (2026-10-01). Pour le rallumer, ajouter ici
     <meta name="nova-sombre" content="auto"> et passer color-scheme a "light dark".
     L'accent selon la couleur de la classe est pose par _widgets/accent.phtml (gabarits interpretes). -->
<meta name="color-scheme" content="light">
<script>/* Nova : menu enseignant simplifie sauf choix contraire (js/nova.js, basculeMenu).
   Les entrees gardees sont choisies par l'enseignant (localStorage nova_menu_garde), sinon la liste
   de Pion ; la regle qui masque les autres est ecrite ici, avant l'affichage, pour qu'aucune
   n'apparaisse un instant. Pas de signe dollar dans ce script : le C de WIMS le remplacerait. */
(function () {
  var d = document.documentElement;
  d.classList.add('nova-js');  /* le bouton de retour en haut ne se cache qu'avec JavaScript */
  /* Page Badges Nova (rubrique de la configuration de la classe, js/nova.js badgesClasse) : la page Apparence
     de WIMS, masquee jusqu'au passage du script. */
  if (location.hash === '#nova-badges-reglages' && /job=present/.test(location.search)) d.classList.add('nova-page-badges');
  var defaut = ['add_sheet', 'add_exam', 'participantview', 'nova_suivi', 'Score1', 'SE_mod', 'backteacher', 'SE_config', 'modtool'];
  var menu = window.novaMenu = { defaut: defaut, garde: defaut.slice(), style: function (liste) {
    var k = liste.filter(function (c) { return typeof c === 'string' && c && !/[^A-Za-z0-9_-]/.test(c); })
      .map(function (c) { return '.' + c; }).join(', ') || '.nova-aucune';
    var p = '.nova-menu-simple:not(.nova-menu-edition) body:has(#nova-menu-bascule) #wimsmenumodubox ';
    var titre = p + '.menu_title:not(:has(+ * :is(' + k + ')))';
    /* Deconnexion (rubrique Profil) : jamais masquee, meme avec toute sa rubrique. */
    return p + '.menuitem:not(:is(' + k + '), .nova-deconnexion), ' + titre + ', ' + titre + ' + :not(:has(.nova-deconnexion)) { display: none !important; }';
  } };
  try {
    if (localStorage.getItem('nova_menu') !== 'complet') d.classList.add('nova-menu-simple');
    var g = JSON.parse(localStorage.getItem('nova_menu_garde') || 'null');
    if (Array.isArray(g)) menu.garde = g;
  } catch (e) { d.classList.add('nova-menu-simple'); }
  var s = document.createElement('style');
  s.id = 'nova-menu-style';
  s.textContent = menu.style(menu.garde);
  document.head.appendChild(s);
})();
</script>
<meta name="nova-structure" content="$wims_superclass">
<meta name="nova-classe" content="$wims_class">
<script>/* Nova : reglages pour rapprocher du theme standard (html.nova-std-...), poses avant l'affichage. La feuille
   de la classe est deja chargee (valeur calculee) ; site et structure : copie gardee par nova.js (sessionStorage,
   reglagesStructure). nova.js (reglagesStandard) recalcule ensuite. Pas de signe dollar ici. */
(function () {
  var d = document.documentElement;
  var lire = function (cle) { var o = {}; try { (sessionStorage.getItem(cle) || '').replace(/--nova-std-([a-z-]+)\s*:\s*(oui|non)/g, function (m, k, v) { o[k] = v; }); } catch (e) {} return o; };
  var site = lire('nova-reglages-site');
  var m = document.querySelector('meta[name="nova-structure"]');
  var st = m && m.content ? lire('nova-reglages-' + m.content) : {};
  /* La feuille de la classe arrive apres ce script : nova.js garde pour la session les reglages calcules de
     chaque classe (nova-std-<classe>), repris ici ; sinon site et structure. */
  var mc = document.querySelector('meta[name="nova-classe"]');
  var connu = null;
  try { connu = sessionStorage.getItem('nova-std-' + (mc ? mc.content : '')); } catch (e) {}
  ['menus', 'navigation', 'reponse', 'examens', 'textes', 'listes', 'menu-complet', 'dominos'].forEach(function (k) {
    var v = connu !== null ? ((' ' + connu + ' ').indexOf(' ' + k + ' ') >= 0 ? 'oui' : 'non') : (st[k] || site[k] || 'non');
    if (v === 'oui') d.classList.add('nova-std-' + k);
  });
  /* Rubrique Communication des eleves (meme memoire de session : jeton sans-communication). */
  var com = function (cle) { try { var m2 = /--nova-communication-eleves\s*:\s*(oui|non)/.exec(sessionStorage.getItem(cle) || ''); return m2 ? m2[1] : ''; } catch (e) { return ''; } };
  var sans = connu !== null ? (' ' + connu + ' ').indexOf(' sans-communication ') >= 0 : (com(m && m.content ? 'nova-reglages-' + m.content : '') || com('nova-reglages-site')) === 'non';
  if (sans) d.classList.add('nova-sans-communication');
  /* Menu enseignant complet par defaut : seulement si l'enseignant n'a rien choisi lui-meme. */
  try { if (d.classList.contains('nova-std-menu-complet') && localStorage.getItem('nova_menu') === null) d.classList.remove('nova-menu-simple'); } catch (e) {}
})();
</script>
<script src="html/themes/Nova/js/nova.js?v=16e2abe279" defer></script>

<style>
/* Nova : les variables de WIMS, que les feuilles metier utilisent (var(--wims_...)), pointent sur
   les jetons de Nova (_css/jetons.css). */
:root {
  --wims_bgcolor: var(--nova-fond);
  --wims_link_color: var(--nova-lien);
  --wims_vlink_color: var(--nova-lien);
  --wims_hlink_color: var(--nova-lien-survol);
  --wims_ref_menucolor: var(--nova-sur-accent);
  --wims_ref_bgcolor: var(--nova-accent);
  --wims_ref_button_color: var(--nova-sur-accent);
  --wims_ref_button_bgcolor: var(--nova-accent);
  --wims_ref_button_help_bgcolor: var(--nova-aide);
  --wims_ref_button_help_color: #FFFFFF;
}
