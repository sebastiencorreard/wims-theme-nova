<!--begin of $wims_theme/htmlheader.phtml-->
<meta charset="$wims_main_font">
<title>$module_title2</title>
<meta name="GENERATOR" content="wims [$module_language]">
<meta name="description" content="$module_description $wims_site_description">
<meta name="keywords" content="$wims_site_keywords, $module_domain, $module_keywords">
<meta name="Author" content="$module_author">

<!-- makes browsers render all elements more consistently -->
<link rel="stylesheet" href="scripts/js/external/normalize.min.css">

<!-- Foundation Accordion -->
<link rel="stylesheet" href="html/themes/_css/foundation_accordion.css">

$wims_CSS

<!-- METAS iOS : -->
<link rel="apple-touch-icon" href="gifs/wims_logo.png">
<meta name="apple-mobile-web-app-capable" content="yes">

<!-- prevents links from apps from opening in mobile safari>
<script src="scripts/js/external/safari_mobile_links/compressed.js"></script-->

<!-- Librairies JQUERY -->
  <script src="scripts/js/external/jquery/jquery.min.js"></script>
  <link rel="stylesheet" href="scripts/js/external/jquery-ui/themes/smoothness/jquery-ui.min.css">
  <script src="scripts/js/external/jquery-ui/jquery-ui.min.js"></script>

<!-- JQUERY pour autocompletion -->
  <script src="scripts/js/interface/autocomplete.js"></script>

<!-- Style pour impression -->
  <link rel="stylesheet" media="print" href="html/themes/_css/print.css">

<!-- Nova : menu sur telephone (bouton, ouverture, fermeture) -->
  <script src="html/themes/Nova/js/nova.js" defer></script>

<style>
!! Nova : les variables de WIMS, que les feuilles métier utilisent (var(--wims_...)), pointent sur
!! les jetons de Nova (_css/jetons.css). Seul ref_bgcolor garde un rôle : il devient l'accent.
:root {
  --wims_bgcolor: var(--nova-fond);
  --wims_link_color: var(--nova-lien);
  --wims_vlink_color: var(--nova-lien);
  --wims_hlink_color: var(--nova-lien-survol);
  --wims_ref_menucolor: var(--nova-sur-accent);
  --wims_ref_bgcolor: var(--nova-accent);
  --wims_ref_button_color: var(--nova-sur-accent);
  --wims_ref_button_bgcolor: var(--nova-accent);
  --wims_ref_button_help_bgcolor: var(--nova-aide);
  --wims_ref_button_help_color: #FFFFFF;
}

!! Nova : l'accent est la couleur des barres du site ou de la classe ; le gris #676767 est la
!! valeur par défaut de WIMS (DF_ref_bgcolor) - personne ne l'a choisi : on garde la prune Nova.
!if $wims_ref_bgcolor!=$empty and $wims_ref_bgcolor notsametext #676767
:root { --nova-accent: $wims_ref_bgcolor; }
!endif

$class_actcolor_css
</style>
<!--end $wims_theme/htmlheader.phtml-->
