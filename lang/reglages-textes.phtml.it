<template id="nova-apparence" data-sans-effet="$nova_sans" data-champ-theme="$nova_theme" data-couleur-theme="$nova_app_couleur_theme" data-masques="le impostazioni senza effetto nel tema Nova, o raramente utili, sono nascoste." data-afficher="Mostrale" data-masquer="Nascondile">
!exit
