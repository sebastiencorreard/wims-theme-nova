!! Nova : sequences pedagogiques (2026-11-12, utilisateur, maquette B). Lu par header.phtml (adm/class/sequence, accueil).
!! - Enseignant, adm/class/sequence : glisser-deposer (nova_seq_de, nova_seq_vers : requete en arriere-plan de nova.js,
!!   _procs/sequences.sh deplacer ; le gabarit relit les sequences apres ce widget), option " numero seul " envoyee par
!!   la page Configurer (nova_seq_numero=oui|non dans l'adresse du formulaire), textes de nova.js (sequencesEnseignant),
!!   fenetre de confirmation d'" Effacer " (WIMS efface sans demander).
!! - Tous : #nova-seq-numero si la classe a choisi le numero seul (ligne sequence_nova_numero de seq/.def).
!! Valeurs de l'adresse : chiffres seulement, ou oui/non (audit du 2026-11-12).
!if $module=adm/class/sequence and $wims_user=supervisor
  !set nova_q=!sh printf '%s' "$$QUERY_STRING"
  !set nova_q=!replace internal & by $ $ in $nova_q
  !set nova_sd=!getopt nova_seq_de in $nova_q
  !set nova_sv=!getopt nova_seq_vers in $nova_q
  !set nova_sd=!text select 0123456789 in $nova_sd
  !set nova_sv=!text select 0123456789 in $nova_sv
  !if $nova_sd!=$empty and $nova_sv!=$empty
    !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" deplacer "$nova_sd" "$nova_sv"
    !set nova_sr=!text select abcdefghijklmnopqrstuvwxyz in $nova_sr
    !if $nova_sr=ok
      !set wims_class_log=sequence $nova_sd to $nova_sv (Nova) by $wims_realuser
    !endif
<span id="nova-seq-fait" hidden data-resultat="$nova_sr"></span>
  !endif
  !set nova_sn=!getopt nova_seq_numero in $nova_q
  !if $nova_sn isitemof oui,non
    !set nova_sr=!sh sh $wims_home/public_html/themes/$wims_theme/_procs/sequences.sh "$wims_home" "$wims_class" numero "$nova_sn"
  !endif
!read themes/$wims_theme/lang/enseignant-textes.phtml.$lang sequences
  !read themes/$wims_theme/_widgets/confirmations.phtml
!endif
!set nova_sn=!defof sequence_nova_numero in wimshome/log/classes/$wims_class/seq/.def
!if $nova_sn=yes
<span id="nova-seq-numero" hidden></span>
!endif
!reset nova_q nova_sd nova_sv nova_sr nova_sn
