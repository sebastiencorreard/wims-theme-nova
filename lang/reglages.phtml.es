!set nova_app_masques_eleves=Secciones del menú ocultas a los alumnos
!set nova_app_masques_eleves_aide=Marcada: no aparece en el menú de los alumnos. El menú del profesor no cambia.
!set nova_app_masque_communication=Comunicación (foro, escribir al profesor)
!set nova_app_masque_liens=Enlaces externos (otras clases, enlaces de la plataforma educativa)
!set nova_bdg_fid_exercices=Días de trabajo por semana (1 a 7)
!set nova_bdg_per_desc=Superar un ejercicio tras varias notas bajas. 8 niveles, nunca perdidos.
!set nova_bdg_per_paliers=Umbrales de la insignia Perseverancia
!set nova_bdg_per_paliers_aide=Ejercicios superados tras dificultades, para cada uno de los 8 niveles, separados por espacios. Vacío: valor heredado. 0: nivel concedido de inmediato, para hacer pruebas (el alumno lo conserva).
!set nova_bdg_per_regle1=Contar un ejercicio cuando el alumno obtiene al menos
!set nova_bdg_per_regle2=/10 tras al menos
!set nova_bdg_per_regle3=notas estrictamente inferiores a
!set nova_bdg_per_regle4=/10.
!set nova_bdg_per_examens=Incluir las notas de examen
!set nova_bdg_ech_desc=Practicar antes de cada deber calificado: dos exámenes con el mismo contenido, muchos intentos para la práctica, pocos para el calificado. 8 niveles, nunca perdidos.
!set nova_bdg_ech_paliers=Umbrales de la insignia Calentamiento
!set nova_bdg_ech_paliers_aide=Deberes preparados, para cada uno de los 8 niveles, separados por espacios. Vacío: valor heredado. 0: nivel concedido de inmediato, para hacer pruebas (el alumno lo conserva).
!set nova_bdg_ech_sessions1=Contar un deber cuando el alumno ha hecho al menos
!set nova_bdg_ech_sessions2=sesiones completas de práctica (una respuesta a cada ejercicio) antes de abrir el examen calificado.
!set nova_bdg_ech_mots=Reconocer también los deberes por su título
!set nova_bdg_ech_mots_aide=Cuando los dos exámenes no tienen el mismo contenido: palabras que distinguen los títulos, separadas por comas, el resto del título idéntico («DM 02 (práctica)», «DM 02 (calificado)»). Se ignoran acentos y mayúsculas. Vacío: valor heredado.
!set nova_bdg_ech_mots_t=Práctica
!set nova_bdg_ech_mots_n=Calificado
!set nova_bdg_top_desc=Tener éxito en los deberes calificados: nota retenida de al menos 9/10 (ajustable). Deberes calificados reconocidos por la pestaña Deberes WIMS. 8 niveles, nunca perdidos.
!set nova_bdg_top_paliers=Umbrales de la insignia En la cima
!set nova_bdg_top_paliers_aide=Deberes en la cima, para cada uno de los 8 niveles, separados por espacios. Vacío: valor heredado. 0: nivel concedido de inmediato, para hacer pruebas (el alumno lo conserva).
!set nova_bdg_top_seuil1=Contar un deber cuando la nota retenida en la prueba calificada llega al menos a
!set nova_bdg_top_seuil2=sobre 10.
!set nova_bdg_coul_phrase3=, y los degradados en el nivel
!set nova_bdg_coul_degrade=Nivel que desbloquea los degradados
!set nova_bdg_coul_titre=Color personal de los alumnos
!set nova_bdg_coul_aide=Una recompensa: el alumno elige el color de su interfaz en una paleta legible (menú Perfil, «Mi color»), y después un degradado (barra superior, botones, títulos de ventana). Una vez elegido, se aplica en toda la clase, agrupación o portal, pruebas incluidas.
!set nova_bdg_coul_phrase1=Desbloquear la elección en el nivel
!set nova_bdg_coul_phrase2=de la insignia
!set nova_bdg_coul_niveau=Nivel que desbloquea el color
!set nova_bdg_coul_badge=Insignia que desbloquea el color
!set nova_bdg_coul_aucun=nadie (desactivado)
!set nova_bdg_coul_herite_vide=valor heredado
!set nova_bdg_reglages=Ajustes
!set nova_app_fil=Ruta de navegación fija
!set nova_app_fil_aide=Profesores y administradores, pantallas grandes: la ruta de navegación queda bajo la barra superior al desplazar la página.
!set nova_app_deco=Decoraciones de temporada
!set nova_app_deco_aide=Guirnalda y copos de nieve en la barra superior en diciembre (vendrán otras fiestas); nunca durante un examen.
!set nova_bdg_av_titre=Avatar de los alumnos
!set nova_bdg_av_aide=Los alumnos ganan monedas superando ejercicios y las usan para desbloquear elementos de su avatar («Mi avatar» en el menú Perfil). Algunos elementos son recompensas de insignias. El avatar se aplica en toda la clase, agrupación o portal; solo lo ven el alumno y sus profesores.
!set nova_bdg_av_actif=Avatar de los alumnos
!set nova_bdg_av_oui=ofrecido
!set nova_bdg_av_regle1=Un ejercicio cuenta a partir de la nota
!set nova_bdg_av_regle2=sobre 10, si la respuesta llega al menos
!set nova_bdg_av_regle3=segundos después de abrirlo, una vez al día; como máximo
!set nova_bdg_av_regle4=ejercicios al día.
!set nova_bdg_av_paliers=Umbrales de las monedas
!set nova_bdg_av_paliers_aide=Número de ejercicios superados necesarios para cada moneda (por defecto: 3 10 20 30 40).
!set nova_bdg_av_pas1=Después, una moneda cada
!set nova_bdg_av_pas2=ejercicios superados.
!set nova_bdg_av_depart1=Cada alumno empieza con
!set nova_bdg_av_depart2=moneda(s) gratis, para personalizar su avatar enseguida.
!set nova_mois=enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre
!set nova_version_dev=versión de desarrollo
!set nova_app_desact=Desactivar a pesar del uso compartido
!set nova_app_desact_aide=Añade un botón «Desactivar de todos modos...» cuando WIMS se niega a desactivar un examen o una hoja compartidos con otras clases.
!set nova_app_desact_danger=Peligroso: el examen o la hoja se desactiva en todas las clases que lo comparten, y su contenido se puede volver a modificar; cualquier cambio desajusta las notas registradas, en todas esas clases. WIMS lo prohíbe por estas razones. Actívalo solo con conocimiento de causa.
!set nova_version_lien=Novedades de cada versión (nueva pestaña)
!set nova_rg_affichage=Visualización
!set nova_rg_eleves=Alumnos
!set nova_rg_dm=Deberes WIMS
!set nova_rg_badges=Insignias y recompensas
!set nova_rg_avances=Ajustes avanzados
!set nova_rg_dm_aide=Un deber WIMS es un examen de práctica (muchas sesiones) y un examen calificado (pocas sesiones) con el mismo contenido. Nova los reconoce por su título. Se ignoran acentos y mayúsculas.
!set nova_rg_dm_usage=Estos ajustes los usan:
!set nova_rg_dm_usage1=<strong>«Crear el deber calificado»</strong>: botón en tu página de inicio, junto a un deber de práctica que todavía no tiene deber calificado; hace una copia «En preparación», con una palabra clave de calificado en el título y el número de sesiones de abajo.
!set nova_rg_dm_usage2=<strong>Insignia Calentamiento</strong>: un deber cuenta cuando el alumno ha hecho suficientes sesiones completas de práctica antes de abrir el calificado.
!set nova_rg_dm_usage3=<strong>Insignia En la cima</strong>: deber calificado superado (nota retenida al menos igual al umbral de la insignia).
!set nova_rg_dm_mots=Palabras clave de un deber WIMS
!set nova_rg_dm_mots_aide=Obligatorio: el título de un deber WIMS, de práctica o calificado, contiene una de estas palabras, seguida o no de un número (DMWIMS03).
!set nova_rg_dm_note=Palabras clave de un deber calificado
!set nova_rg_dm_note_aide=El título de un deber calificado contiene además una de estas palabras.
!set nova_rg_dm_ent=Palabras clave de un deber de práctica
!set nova_rg_dm_ent_aide=El título de un deber de práctica contiene además una de estas palabras. Un examen de práctica y su deber calificado tienen el mismo contenido, o el mismo título salvo esta palabra.
!set nova_rg_dm_essais1=«Crear el deber calificado» le da
!set nova_rg_dm_essais2=sesiones.
!set nova_bdg_coul_ligne1=Color:
!set nova_bdg_coul_ligne2=Degradados:
!set nova_bdg_coul_au_niveau=en el nivel
!set nova_bdg_coul_badge_deg=Insignia que desbloquea los degradados
!set nova_bdg_coul_meme_badge=la misma insignia que el color
!set nova_bdg_coul_ordre=Los degradados solo se abren una vez desbloqueado el color.
