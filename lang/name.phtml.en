!! Closer to the standard theme (Appearance page, 2026-10-07).
!set nova_std_titre=Closer to the standard theme
!set nova_std_aide=Setting by setting, get back the standard theme's display where Nova hides, changes or moves something. Colours, font and cards stay Nova's.
!set nova_std_changements=What changes
!set nova_std_menus=Standard theme menus
!set nova_std_menus_aide=Students: menu in a left column. Account, Help and languages in the top bar.
!set nova_std_menus_liste=<li>Students, large screens: the side menu stays in a left column instead of the drawer opened by the menu button.</li><li>Students and teachers: the account menu (name, preferences, terms of use, logout) stays in the top bar instead of the "Profile" section of the side menu.</li><li>"Help" stays in the top bar.</li><li>The language choice stays in the top bar.</li><li>Unchanged: on phones and tablets, the side menu stays a drawer.</li><li>"My activity" opens the WIMS page (charts), not the Nova page.</li>
!set nova_std_navigation=Full navigation for students
!set nova_std_navigation_aide=Breadcrumbs and full account menu.
!set nova_std_navigation_liste=<li>Breadcrumbs are shown at the top of student pages.</li><li>The "Back" button is no longer added to the bar.</li><li>The student's account menu gets all its links back (display preferences, terms of use...), not only the name, the password change and logout.</li>
!set nova_std_reponse=Standard answer page
!set nova_std_reponse_aide="Analysis of your answer" table and the standard send button.
!set nova_std_reponse_liste=<li>The "Analysis of your answer" table is shown as is.</li><li>No "Right answer" / "Wrong answer" box, no "Correct" and "To review" columns for mixed answers, no wrong answer in red.</li><li>Chosen or missed choices (checkboxes, words to mark) without frame or badge in the statement.</li><li>No stars and no shake, even with animations on.</li><li>The button keeps its standard label.</li>
!set nova_std_examens=Standard exams
!set nova_std_examens_aide=End of session, messages and titles as in the standard theme.
!set nova_std_examens_liste=<li>"End this exam session" stays in the account menu (or side menu) instead of an "End" button in the bar.</li><li>The student's name, Help and account stay in the bar during the exam.</li><li>Logout links stay visible during the exam.</li><li>The sentence "Your score for this exam is..." is shown on the exam page.</li><li>The "You have already started another exam..." message stays the standard one.</li><li>The titles above the instructions and the exercise list are shown.</li><li>After the "End" warning, "No" goes back to the scores page.</li><li>Unchanged: Nova's timer and the "Exam in progress" pill.</li>
!set nova_std_textes=Standard texts
!set nova_std_textes_aide=Original sentences and labels where Nova rewrites them.
!set nova_std_textes_liste=<li>"My scores": standard exam score sentences.</li><li>Login page: introduction texts shown.</li><li>Password change: standard labels.</li><li>Top bar: "Home page" instead of "WIMS".</li><li>Appearance page: "Menu background colour" instead of "Theme colour".</li><li>Teacher "Scores" page: "Exam n" headers instead of the exam title.</li>
!set nova_std_listes=Sheets and exams as lists
!set nova_std_listes_aide=Standard presentation instead of Nova's cards.
!set nova_std_listes_liste=<li>Student home: sheets, exams, documents, tools and sequences with the standard presentation instead of Nova's cards.</li><li>Sheet and exam scores as written by the standard theme: no segments, score pill or labels.</li><li>Exam attempts and history in the standard form.</li><li>Full type legend.</li><li>Sheet page: standard exercises and scores.</li><li>Exam page: exercises as a list instead of cards.</li>
!set nova_std_menu_complet=Full teacher menu by default
!set nova_std_menu_complet_aide=All side menu entries, until the teacher chooses.
!set nova_std_menu_complet_liste=<li>The teacher's side menu shows all its entries until the teacher chooses between the simplified and the full menu.</li><li>Unchanged: the simplified menu button and the choice of entries stay available, and each choice is kept.</li>
!set nova_app_communication=Students' "Communication" section
!set nova_app_communication_aide=Forum and "Write to the teacher" in the students' menu. "No" hides the section.
!set nova_consigne_dominos=Drag each domino into a box, or tap a domino and then a box.
!set nova_std_dominos=Standard dominoes
!set nova_std_dominos_aide=Domino exercises (drag labels made of a table) without Nova's styling.
!set nova_std_dominos_liste=<li>Dominoes and drop boxes with the standard colours and sizes (205 x 50, blue background, orange boxes) instead of white dominoes with a black frame (205 x 80, 175 x 80 on phones) and dashed boxes.</li><li>No computed common text size: the standard one.</li><li>No "Drag each domino..." instruction above the dominoes.</li><li>No highlighted box while dragging, no lit boxes when a domino is chosen.</li><li>No window suggesting landscape mode on phones.</li><li>Correction page: standard dominoes (statement, analysis, solution), no red or green frame, and "Analysis of your answer" shown.</li>
!set nova_paysage=Turn your phone sideways (landscape) to see the dominoes better.
!set nova_fermer=Close
!set nova_indisponible_examen=Not available during an exam
