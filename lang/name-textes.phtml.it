!! Nova : textes de nova.js en clair (it), lus par !read themes/$wims_theme/lang/name-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:avatar_barre
!! _widgets/avatar-barre.phtml
<div id="nova-avatar-barre" hidden data-actif="$nova_avb" data-choix="$nova_avc" data-jetons="$nova_avj" data-script="themes/$wims_theme/js/avatar.js" data-titre="Il mio avatar" data-t-jeton="%n moneta" data-t-jetons="%n monete"></div>
!exit

:headmenu_1
!! _widgets/headmenu.phtml
    <div class="nova-chrono" data-etat="normal" data-texte-5min="Meno di 5 minuti rimasti" data-texte-1min="Ultimo minuto" data-texte-fin="Tempo scaduto" data-texte-fin-detail="Le risposte inviate adesso non saranno prese in considerazione." data-texte-fin-a="Finisce alle">
!exit

:headmenu_2
!! _widgets/headmenu.phtml
<span id="nova-textes" hidden data-texte-mes-badges="$nova_badges_titre" data-texte-consigne-dominos="Trascina ogni domino in una casella, oppure tocca un domino e poi una casella." data-texte-paysage="Gira il telefono (in orizzontale) per vedere meglio i domino." data-texte-consigne-tuiles="Trascina ogni etichetta in una casella, oppure tocca un'etichetta e poi una casella." data-texte-consigne-associer="Tocca un elemento a sinistra, poi quello che gli corrisponde a destra." data-texte-deposer="Rilascia qui" data-texte-indisponible-examen="Non disponibile durante un esame" data-texte-fermer="Chiudi" data-texte-en-ligne="Online" data-texte-rubrique-reglages="$nova_rg_rubrique" data-texte-rubrique-reglages-aide="(tema Nova: visualizzazione, studenti, compiti WIMS, distintivi, impostazioni avanzate)" data-texte-nouveau="Nuovo" data-libelle="$nova_chrono_libelle" data-texte-5min="Meno di 5 minuti rimasti" data-texte-1min="Ultimo minuto" data-texte-fin="Tempo scaduto" data-texte-fin-detail="Le risposte inviate adesso non saranno prese in considerazione." data-texte-fin-detail-exo="$nova_chrono_fin_detail_exo" data-profil="Profilo" data-plus="Altro" data-retour="Indietro" data-terminer="Termina" data-fin-session="Hai finito." data-fin-session-detail="Clicca su Termina per chiudere questa sessione: potrai poi iniziare un altro esame. Verrai disconnesso." data-terminer-impossible="Rispondi ad almeno un esercizio prima di terminare la sessione: finché non è stata inviata nessuna risposta, WIMS non può chiuderla." data-car-prec="Esempio precedente" data-car-suiv="Esempio successivo" data-car-pause="Ferma lo scorrimento" data-car-lecture="Riprendi lo scorrimento" data-car-diapo="Esempio %n di %t" data-car-titre="Esempi" data-exo-suivant="Esercizio successivo" data-revenir-liste="Torna all'elenco" data-parcours="Esercizio %n di %t" data-parcours-reussi="superato" data-parcours-a-faire="da fare" data-parcours-en-cours="in corso" data-parcours-note="valutato" data-parcours-termine="terminato" data-parcours-question="Domanda %n di %t" data-parcours-titre="Avanzamento del percorso" data-valider="Conferma" data-bonne="Risposta giusta" data-bonnes="Risposte giuste" data-mauvaise="Risposta sbagliata" data-bonne-etait="la risposta giusta era" data-texte-propager-apparence="Impostazioni di Nova: visualizzazione, studenti, impostazioni avanzate" data-texte-propager-badges="Impostazioni di Nova: compiti WIMS, distintivi e ricompense" data-texte-propager-tout="Seleziona tutto" data-texte-propager-rien="Deseleziona tutto" data-juste-sur="%1 risposta giusta su %2" data-justes-sur="%1 risposte giuste su %2" data-partielle="Risposta in parte giusta" data-precision="Precisione insufficiente" data-votre-reponse="La tua risposta:" data-mdp-afficher="Mostra la password" data-mdp-masquer="Nascondi la password" data-texte-autre-examen="Devi terminare l'esame in corso prima di iniziarne un altro. Clicca sul pulsante qui sotto." data-texte-examen="$nova_examen_court" data-texte-examen-encours="$nova_examencours" data-texte-clavier="Tastiera matematica" data-texte-clavier-suivant="Avanti" data-texte-clavier-ok="Conferma" data-texte-clavier-abc="Tastiera del telefono" data-texte-clavier-123="Tastiera matematica" data-texte-clavier-effacer="Cancella" data-texte-clavier-gauche="Sposta a sinistra" data-texte-clavier-droite="Sposta a destra" data-texte-clavier-carre="Al quadrato" data-texte-clavier-cube="Al cubo" data-texte-clavier-racine="Radice quadrata" data-texte-clavier-puissance10="Per dieci elevato a" data-texte-signe-croix="sessione senza durata registrata (ancora in corso, o interrotta prima della fine)" data-texte-signe-inconnu="esercizio senza voto in questa sessione (non aperto, o aperto senza inviare una risposta)" data-texte-masquer-moyenne="Nascondi la media" data-texte-titres-examens="Esami: mostrare il titolo invece del numero" data-texte-titres-feuilles="Fogli: mostrare il titolo invece del numero" data-choix-juste="scelta, giusta" data-choix-faux="scelta per errore" data-choix-oublie="dimenticata: andava scelta" data-choix-pris="scelta" data-choix-a-tort="%1 risposta scelta per errore" data-choix-a-torts="%1 risposte scelte per errore" data-choix-manque="manca %1 risposta" data-choix-manques="mancano %1 risposte" data-texte-dm-note="Crea il compito valutato" data-texte-dm-note-aide="Copia di questo esame, stessi esercizi, %1 sessioni, lasciata in preparazione" data-texte-dm-note-encours="Creazione..." data-texte-dm-note-mot="valutato" data-texte-dm-note-fait="Compito valutato creato: «%1». Resta in preparazione: controllalo, poi attivalo."></span>
!exit

:menu_bascule
!! _widgets/menu-bascule.phtml
<span id="nova-menu-bascule" hidden data-simplifie="Menu semplificato"
  data-personnaliser="Scegli le voci del menu" data-termine="Fatto" data-defaut="Torna al menu predefinito"
  data-cacher="Nascondi" data-montrer="Mostra" data-consigne="Fai clic sull'occhio di una voce per mostrarla o nasconderla." data-rien="Nessuna voce nascosta per ora"></span>
!exit

:replis_classes
!! _widgets/replis-classes.phtml
<span id="nova-replis" hidden data-valeur="$nova_rv" data-replier="Comprimi le %1 classi" data-replier1="Comprimi la classe" data-afficher="Mostra le %1 classi" data-afficher1="Mostra la classe"></span>
!exit

:header
!! header.phtml
  <template id="nova-liens-textes" data-type="$class_type" data-qr-script="themes/$wims_theme/js/qrcode.js" data-script-flyers="themes/$wims_theme/js/flyers.js" data-nom="$wims_classname" data-flyers="Volantini da stampare (PDF)" data-fl-nom="Nome della classe sui volantini" data-fl-aide="Una pagina A4 con 30 volantini da ritagliare: uno per studente, da incollare sul quaderno." data-agrandir="Ingrandisci" data-telecharger="Scarica" data-fermer="Chiudi" data-qr-alt="Codice QR del link per i suoi studenti" data-vous="Link per lei" data-vous-aide="Apre l'accesso docente: fogli, esami, studenti e i loro voti. Lo salvi nei preferiti." data-eleves="Link per i suoi studenti" data-eleves-aide="Per iscriversi alla classe o entrarvi una volta iscritti. Da condividere sul registro elettronico o alla lavagna." data-eleves-aide-s="Per iscriversi a una classe o entrarvi una volta iscritti. Da condividere sul registro elettronico o alla lavagna." data-qr="Codice QR da proiettare in classe: gli studenti lo scansionano con il telefono." data-ens="Link per i docenti" data-ens-aide="Perché i docenti entrino nelle loro classi." data-insc="Iscrizione dei docenti" data-insc-aide="Perché un docente crei il suo account." data-copier="Copia" data-copie="Copiato" data-copier-num="Copia il numero" data-echec="Copia impossibile: selezioni il link e lo copi." data-numero="Numero della classe" data-numero-s="Numero della struttura" data-numero-aide="Da conservare anche questo: permette di ritrovarla dalla pagina iniziale di WIMS."></template>
!exit
