!! Nova : carte « Reglages de Nova » de la page Apparence de la configuration d'une classe, d'un groupement ou
!! d'un portail (adm/class/config). Les choix sont ecrits par js/nova.js (apparenceClasse) dans la zone de texte
!! de la feuille de style de la classe (pr_cssfile), enregistree par WIMS (scripts/setdefr.proc).
!! La feuille complete est aussi transmise : WIMS remplit cette zone par !record 0, qui coupe au premier « : »
!! en debut de ligne (une feuille commencant par « :root » y apparaissait vide, et l'enregistrer l'effacait).
!set nova_cf=!sh if test -r $wims_home/log/classes/$wims_class/css; then cat $wims_home/log/classes/$wims_class/css; fi
<script type="text/plain" id="nova-css-classe-complete">$nova_cf</script>
!! Vacances de « Mon activite » (2026-11-07, utilisateur ; avant : page Badges Nova) : zone A, B, C (dates officielles
!! livrees avec Nova, _procs/vacances-zones.txt, maj-vacances.py) ou dates personnalisees ; valeur de la structure
!! (portail, groupement) pour l'option « heritee ».
!set nova_vz=!sh cat $wims_home/public_html/themes/$wims_theme/_procs/vacances-zones.txt 2>/dev/null
<script type="text/plain" id="nova-vacances-zones">$nova_vz</script>
!reset nova_vs
!if $wims_superclass!=$empty and $wims_superclass!=$wims_class
  !set nova_vs=!sh grep -ao -- '--nova-vacances *: *[^;}]*' $wims_home/log/classes/$wims_superclass/css 2>/dev/null | tail -1 | cut -d: -f2
  !set nova_vs=!trim $nova_vs
  !default nova_vs=aucune
!endif
!! Repliés aussi (demande de l'utilisateur, 2026-10-06) : degrade des scores et couleurs des activites (remplaces
!! par Nova), feuille de style (css). « Couleur de fond des menus » (couleur d'accent de Nova) : « Couleur du theme ».
<template id="nova-apparence-classe" data-vac-noms="$nova_app_vac_noms" data-vac-ete="$nova_app_vac_ete" data-vac-manque="$nova_app_vac_manque" data-vac-zone="$nova_app_vac_zone" data-vac-resume-aucune="$nova_app_vac_resume_aucune" data-vac-herite-de="$nova_app_vac_herite_de" data-erreur-vacances="$nova_app_vacances_erreur" data-sans-effet="pr_bgcolor,pr_bgimg,pr_ref_menucolor,pr_ref_button_bgcolor,pr_ref_button_color,pr_ref_button_help_bgcolor,pr_ref_button_help_color,pr_sccolor1,pr_actcolor1,pr_css,pr_homepage" data-sans-effet-ligne="wims_deposit" data-champ-theme="pr_refcolor" data-couleur-theme="$nova_app_couleur_theme" data-masques="$nova_app_masques" data-afficher="$nova_app_afficher" data-masquer="$nova_app_masquer">
  <div class="nova-app">
    <fieldset class="property_fields blockcenter nova-app-carte">
      <legend>$nova_app_titre <span class="nova-app-pastille">$nova_app_pastille</span></legend>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c1">$nova_app_animations<span class="nova-app-aide">$nova_app_animations_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c1">
          <label><input type="radio" name="nova_c_animations" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_animations" value="non"> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c2">$nova_app_entree<span class="nova-app-aide">$nova_app_entree_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c2">
          <label><input type="radio" name="nova_c_entree-directe" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_entree-directe" value="non"> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c3">$nova_app_clavier<span class="nova-app-aide">$nova_app_clavier_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c3">
          <label><input type="radio" name="nova_c_clavier-maths" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_clavier-maths" value="non"> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c4">$nova_app_badges<span class="nova-app-aide">$nova_app_badges_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c4">
          <label><input type="radio" name="nova_c_badges" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_badges" value="non"> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c5">$nova_app_masques_eleves<span class="nova-app-aide">$nova_app_masques_eleves_aide</span></span>
        <span class="nova-app-cases" role="group" aria-labelledby="nova-app-c5">
          <label><input type="checkbox" name="nova_c_masque" value="communication"> $nova_app_masque_communication</label>
          <label><input type="checkbox" name="nova_c_masque" value="liens"> $nova_app_masque_liens</label>
        </span>
      </div>
      <div class="nova-app-ligne">
        <span class="nova-app-nom" id="nova-app-c7">$nova_app_fil<span class="nova-app-aide">$nova_app_fil_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c7">
          <label><input type="radio" name="nova_c_fil-fixe" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_fil-fixe" value="non"> $nova_app_non</label>
        </span>
      </div>
      <div class="nova-app-ligne nova-app-activite">
        <span class="nova-app-nom" id="nova-app-c6">$nova_app_activite<span class="nova-app-aide">$nova_app_activite_aide</span></span>
        <span class="nova-app-choix" role="radiogroup" aria-labelledby="nova-app-c6">
          <label><input type="radio" name="nova_c_activite" value="oui"> $nova_app_oui</label>
          <label><input type="radio" name="nova_c_activite" value="non"> $nova_app_non</label>
        </span>
        <details class="nova-app-detail"><summary>$nova_app_act_reglages</summary>
        <div class="nova-app-phrases">
          <label class="nova-app-phrase">$nova_app_act_seuil <input type="number" class="nova-app-nombre" name="nova_c_activite-seuil" min="1" max="7" step="1"> $nova_app_act_seuil2</label>
          <label class="nova-app-phrase">$nova_app_act_objectif <input type="number" class="nova-app-nombre" name="nova_c_activite-objectif" min="1" max="7" step="1"> $nova_app_act_objectif2</label>
          <label class="nova-app-phrase">$nova_app_act_heures <input type="number" class="nova-app-nombre" name="nova_c_activite-heures" min="1" max="80" step="1"> $nova_app_act_heures2</label>
          <label class="nova-app-phrase">$nova_app_act_notes <input type="number" class="nova-app-nombre" name="nova_c_activite-notes" min="1" max="20" step="1"> $nova_app_act_notes2</label>
          <p class="nova-app-aide">$nova_app_act_herite</p>
          <div class="nova-app-vac" role="radiogroup" aria-labelledby="nova-app-vac-titre" data-herite="$nova_vs">
            <p class="nova-app-nom" id="nova-app-vac-titre">$nova_app_vac_titre<span class="nova-app-aide">$nova_app_vac_aide</span></p>
            <div class="nova-app-vac-choix">
!if $nova_vs!=$empty
              <label class="nova-app-vac-herite"><input type="radio" name="nova_c_vacances" value=""> <span>$nova_app_vac_herite</span></label>
!endif
              <label><input type="radio" name="nova_c_vacances" value="aucune"> $nova_app_vac_aucune</label>
              <label><input type="radio" name="nova_c_vacances" value="zone-a"> $nova_app_vac_zone A</label>
              <label><input type="radio" name="nova_c_vacances" value="zone-b"> $nova_app_vac_zone B</label>
              <label><input type="radio" name="nova_c_vacances" value="zone-c"> $nova_app_vac_zone C</label>
              <label><input type="radio" name="nova_c_vacances" value="dates"> $nova_app_vac_dates</label>
            </div>
            <p class="nova-app-aide nova-app-vac-resume" aria-live="polite"></p>
            <label class="nova-app-vac-saisie" hidden><span class="nova-app-aide">$nova_app_vacances_aide</span>
              <textarea class="nova-app-vac-dates" rows="5" spellcheck="false"></textarea></label>
            <p class="wims_msg warning nova-app-vac-erreur" role="alert" hidden></p>
          </div>
        </div>
        </details>
      </div>
      !set nova_std_nom=nova_c_std-
      !set nova_std_sep=-
      !reset nova_std_site
      !read themes/$wims_theme/_widgets/apparence-standard.phtml
      !reset nova_std_nom nova_std_sep
      <p class="nova-app-note">$nova_app_note_classe</p>
      <div class="nova-app-actions"><button type="button" class="nova-app-enregistrer wims_button">$nova_app_enregistrer</button></div>
    </fieldset>
  </div>
</template>
!! Page « Badges Nova » (demande de l'utilisateur, 2026-10-07) : rubrique ajoutee par nova.js (rubriqueBadges) a
!! la configuration de la classe ; c'est la page Apparence (job=present#nova-badges-reglages), dont le formulaire
!! de WIMS est masque et sert a enregistrer la feuille de style, ou nova.js (badgesClasse) ecrit le bloc
!! « Nova : badges ». L'interrupteur general des badges reste dans la carte de la page Apparence.
<template id="nova-badges-classe" data-titre="$nova_bdg_titre" data-erreur-vacances="$nova_app_vacances_erreur" data-etat-oui="$nova_bdg_etat_oui" data-etat-non="$nova_bdg_etat_non">
  <div class="nova-app nova-badges-reglages">
    <fieldset class="property_fields blockcenter nova-app-carte">
      <legend>$nova_bdg_choix</legend>
      <p class="nova-bdg-etat"><span class="nova-bdg-etat-texte"></span> <a class="nova-bdg-apparence" href="#">$nova_bdg_apparence</a>).</p>
      <div class="nova-app-ligne nova-bdg-badge">
        <label class="nova-bdg-coche"><input type="checkbox" class="nova-bdg-actif" value="fidelite"> <img src="themes/$wims_theme/img/badges/regularite/coeur_06.webp" alt="" width="48" height="48"> <span class="nova-app-nom">$nova_fid_nom<span class="nova-app-aide">$nova_bdg_fid_desc</span></span></label>
      </div>
      <div class="nova-app-ligne nova-app-texte nova-bdg-detail" data-badge="fidelite">
        <details class="nova-app-detail nova-bdg-replie"><summary>$nova_bdg_reglages</summary><div class="nova-bdg-contenu">
          <label class="nova-app-nom" for="nova-app-paliers">$nova_app_paliers<span class="nova-app-aide">$nova_app_paliers_aide</span></label>
          <input type="text" id="nova-app-paliers" class="nova-app-paliers" data-cle="fidelite-paliers" inputmode="numeric" autocomplete="off" spellcheck="false">
          <label class="nova-app-phrase">$nova_bdg_fid_exercices <input type="number" class="nova-app-nombre" data-cle="fidelite-jours" min="1" max="7" step="1"></label>
        </div></details>
      </div>
      <div class="nova-app-ligne nova-bdg-badge">
        <label class="nova-bdg-coche"><input type="checkbox" class="nova-bdg-actif" value="perseverance"> <img src="themes/$wims_theme/img/badges/perseverance/flamme_06.webp" alt="" width="48" height="48"> <span class="nova-app-nom">$nova_per_nom<span class="nova-app-aide">$nova_bdg_per_desc</span></span></label>
      </div>
      <div class="nova-app-ligne nova-app-texte nova-bdg-detail" data-badge="perseverance">
        <details class="nova-app-detail nova-bdg-replie"><summary>$nova_bdg_reglages</summary><div class="nova-bdg-contenu">
          <label class="nova-app-nom" for="nova-app-paliers-per">$nova_bdg_per_paliers<span class="nova-app-aide">$nova_bdg_per_paliers_aide</span></label>
          <input type="text" id="nova-app-paliers-per" class="nova-app-paliers" data-cle="perseverance-paliers" inputmode="numeric" autocomplete="off" spellcheck="false">
          <p class="nova-app-phrase">$nova_bdg_per_regle1 <input type="number" class="nova-app-nombre" data-cle="perseverance-reussite" min="0" max="10" step="0.5" aria-label="$nova_bdg_per_regle1"> $nova_bdg_per_regle2 <input type="number" class="nova-app-nombre" data-cle="perseverance-echecs" min="1" max="20" step="1" aria-label="$nova_bdg_per_regle2"> $nova_bdg_per_regle3 <input type="number" class="nova-app-nombre" data-cle="perseverance-echec" min="0" max="10" step="0.5" aria-label="$nova_bdg_per_regle3"> $nova_bdg_per_regle4</p>
          <label class="nova-bdg-examens"><input type="checkbox" data-cle="perseverance-examens"> $nova_bdg_per_examens</label>
        </div></details>
      </div>
      <div class="nova-app-ligne nova-bdg-badge">
        <label class="nova-bdg-coche"><input type="checkbox" class="nova-bdg-actif" value="echauffement"> <img src="themes/$wims_theme/img/badges/entrainement/halteres_06.webp" alt="" width="48" height="48"> <span class="nova-app-nom">$nova_ech_nom<span class="nova-app-aide">$nova_bdg_ech_desc</span></span></label>
      </div>
      <div class="nova-app-ligne nova-app-texte nova-bdg-detail" data-badge="echauffement">
        <details class="nova-app-detail nova-bdg-replie"><summary>$nova_bdg_reglages</summary><div class="nova-bdg-contenu">
          <label class="nova-app-nom" for="nova-app-paliers-ech">$nova_bdg_ech_paliers<span class="nova-app-aide">$nova_bdg_ech_paliers_aide</span></label>
          <input type="text" id="nova-app-paliers-ech" class="nova-app-paliers" data-cle="echauffement-paliers" inputmode="numeric" autocomplete="off" spellcheck="false">
          <p class="nova-app-phrase">$nova_bdg_ech_sessions1 <input type="number" class="nova-app-nombre" data-cle="echauffement-sessions" min="1" max="50" step="1" aria-label="$nova_bdg_ech_sessions1"> $nova_bdg_ech_sessions2</p>
          <p class="nova-app-nom">$nova_bdg_ech_mots<span class="nova-app-aide">$nova_bdg_ech_mots_aide</span></p>
          <label class="nova-app-phrase nova-bdg-mots">$nova_bdg_ech_mots_t <input type="text" class="nova-app-mots" data-cle="echauffement-entrainement" autocomplete="off" spellcheck="false"></label>
          <label class="nova-app-phrase nova-bdg-mots">$nova_bdg_ech_mots_n <input type="text" class="nova-app-mots" data-cle="echauffement-note" autocomplete="off" spellcheck="false"></label>
        </div></details>
      </div>
    </fieldset>
    <p class="nova-app-note">$nova_bdg_note</p>
    <div class="nova-app-actions"><button type="button" class="nova-app-enregistrer wims_button">$nova_bdg_enregistrer</button></div>
  </div>
</template>
!reset nova_cf
