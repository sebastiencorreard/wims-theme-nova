!! Nova : textes de nova.js en clair (en), lus par !read themes/$wims_theme/lang/enseignant-textes.phtml.$lang <etiquette>.
!! Aucun nom de variable WIMS (tampon des noms de 32 Ko par page, src/var.c ; 2026-11-12). Encodage latin-1.
!! Un texte = un attribut dans fr, en, es, it (verifier.sh compare les etiquettes et les attributs).
!goto $wims_read_parm

:acces_classe
!! _widgets/acces-classe.phtml
<template id="nova-acces" data-titre-jour="Forbidden hours, every day" data-aide-jour="Your students can neither do exercises nor open resources during these hours. The home page and scores stay available." data-de="From" data-a="to" data-lendemain="next day" data-retirer-plage="Remove this time slot" data-ajouter-plage="Add a time slot" data-nuit="At night: 8:30 pm to 7 am" data-titre-periodes="Forbidden periods" data-aide-periodes="Once, between two dates: an exam weekend, a holiday week..." data-du="From" data-au="to" data-heure-debut="Start time" data-heure-fin="End time" data-retirer-periode="Remove this period" data-ajouter-periode="Add a period" data-incomplet="incomplete: ignored" data-titre-portee="What is forbidden" data-tout="All work in the class" data-exo="Exercises only" data-titre-resume="Summary" data-resume-tout="Work in the class is forbidden %1." data-resume-exo="Exercises are forbidden %1." data-chaque-jour="every day from %1 to %2" data-chaque-jour-lendemain="every day from %1 to %2 the next day" data-periode="from %1 at %2 to %3 at %4" data-aucune="No restriction: your students can work at any time." data-lignes="Lines written for WIMS" data-expert="Expert setting (other rules, IP addresses...)" data-expert-n="Expert setting: %1 other hand-written rule(s)" data-expert-aide="The WIMS field. Hand-written rules are kept; the rules of this form are between the lines "# Nova : debut" and "# Nova : fin". A duplicate rule is written only once."></template>
!exit

:avatars_classe
!! _widgets/avatars-classe.phtml
<section id="nova-avatars" aria-labelledby="nova-avatars-titre" data-script="themes/$wims_theme/js/avatar.js"
  data-t-resume="Students: %n · with an avatar: %a · without: %s" data-t-gagnees="Coins earned" data-t-depensees="Spent"
  data-t-dispo="Available" data-t-elements="Items unlocked: %n" data-t-exercices="Successful exercises counted: %n" data-t-niveau="lvl %n"
  data-t-sans="No avatar saved yet." data-t-attente="Coins available: %n" data-t-precedent="Previous" data-t-suivant="Next"
  data-t-fermer="Close" data-t-enregistrer="Save avatar (.svg)" data-classe="$nova_avk" data-avatar="$nova_avb"
  data-t-afficher="Show:" data-t-avatar="Avatar" data-t-aucun="no badge" data-t-eleves="Students: %n" data-t-jeton="%n coin" data-t-jetons="%n coins"
  data-t-detail="Avatar and badges of %n" data-t-fidelite="$nova_fid_nom" data-t-perseverance="$nova_per_nom" data-t-echauffement="$nova_ech_nom" data-t-top="$nova_top_nom">
!exit

:capacite
!! _widgets/capacite.phtml
<template id="nova-capacite-textes" data-sur="%u of %t (%p%)" data-plein="The class is nearing its maximum capacity."></template>
!exit

:config_globale
!! _widgets/config-globale.phtml
<template id="nova-cg-textes" data-plus="More settings (%1)" data-moins="Fewer settings" data-modifie="changed" data-defaut="WIMS default settings"></template>
!exit

:confirmations
!! _widgets/confirmations.phtml
<template id="nova-confirm-textes" data-activer-sheet="Activate sheet %1?" data-activer-exam="Activate exam %1?" data-effacer-sheet="Delete sheet %1?" data-effacer-exam="Delete exam %1?" data-effacer-freework="Delete free work %1?" data-effacer-doc="Delete document %1?" data-effacer-tool="Delete tool %1?" data-travail-sheet="Students have already worked on sheet %1" data-desactiver-sheet="Deactivate sheet %1?" data-desactiver-exam="Deactivate exam %1?" data-desactiver-freework="Deactivate free work %1?" data-refus-sheet="Sheet %1 cannot be deactivated" data-refus-exam="Exam %1 cannot be deactivated" data-refus-freework="Free work %1 cannot be deactivated" data-wims-refuse="WIMS refuses" data-comptes="%1 accounts have already worked on it" data-fw-effacer="This is permanent: the assignment and the uploaded files are deleted." data-b-activer="Activate" data-b-effacer="Delete" data-b-desactiver="Deactivate" data-b-scores="Delete the scores and deactivate" data-b-fermer="Close" data-b-annuler="Cancel" data-b-page="Open the WIMS page" data-erreur="WIMS did not answer: nothing was done. Try again." data-effacer-seq="Delete sequence %1?" data-seq-effacer="Only the grouping disappears: sheets, exams and documents stay in the class, with their status." data-motd-classe="Delete the class message?" data-motd-eleve="Delete the personal message?" data-motd-choix="Delete the personal messages of the selected students?" data-motd-actions="Actions for %1" data-motd-effacer="Students will no longer see it. This cannot be undone."></template>
!exit

:desactiver_1
!! _widgets/desactiver.phtml
<span id="nova-forcer" hidden data-examen="$nova_fs" data-point-examen="Exercises of this sheet are used in an exam: changing them also changes that exam, and its students' scores." data-point-commence="Students have already started it: their scores are kept. Do not deactivate it while a student is taking it." data-type="$nova_ft" data-n="$nova_fn" data-bouton="Deactivate anyway..." data-titre="$(nova_forcer_titre_$nova_fk)" data-points="$(nova_forcer_points_$nova_fk)" data-ok="Deactivate anyway" data-annuler="Cancel" data-sauver="Download a backup of the class first" data-sauver-aide="Participants, scores, worksheets, exams... everything needed to restore it if necessary (Configuration, Backup and restore)." data-ok-sauver="Back up, then deactivate" data-etape1="Preparing the backup of the class..." data-etape2="Downloading: %1" data-etape3="Deactivating" data-echec="The backup failed: nothing was deactivated." data-reessayer="Try again" data-sans="Deactivate without backup"></span>
!exit

:desactiver_2
!! _widgets/desactiver.phtml
<span id="nova-forcer" hidden data-reglage="1" data-refus="Deactivating despite sharing is not allowed in this class. A teacher can allow it in Nova settings, Appearance tab ("Deactivate despite sharing")."></span>
!exit

:ecarts_zones_1
!! _widgets/ecarts-zones.phtml
<ul id="nova-ecarts" hidden data-titre="%n dependent zones do not use these %q settings" data-titre1="1 dependent zone does not use these %q settings" data-texte="They have their own settings: an older copy, or a setting made in the zone." data-texte1="It has its own settings: an older copy, or a setting made in the zone." data-quoi-apparence="of Nova (display, students, advanced)" data-quoi-badges="of Nova (WIMS homework, badges)" data-quoi-tout="of Nova" data-voir="Show the zones" data-appliquer="Apply these settings to all zones" data-plus-tard="Later" data-attente="Save your changes first, then apply them to the zones.">$nova_ez</ul>
!exit

:ecarts_zones_2
!! _widgets/ecarts-zones.phtml
<ul id="nova-ecarts-acces" hidden data-enregistre="Access restriction saved." data-question="%1 dependent zones have a different access restriction. Apply this one to them?" data-question1="A dependent zone has a different access restriction. Apply this one to it?" data-texte="Their current restriction will be replaced by this one, hand-written rules included." data-voir="Show the zones" data-appliquer="Apply to the %1 zones" data-appliquer1="Apply to this zone" data-non="No, only here" data-attente="Applying..." data-fait="Restriction applied to the %1 dependent zones." data-fait1="Restriction applied to the dependent zone." data-erreur="The restriction could not be applied to the zones. Use "Dependent zones" in the configuration.">$nova_ea</ul>
!exit

:fiche_ressource
!! _widgets/fiche-ressource.phtml
<template id="nova-fiche-textes" data-f0="Not visible to students. You can still add, remove and edit exercises." data-f1="Students can see it and their scores are recorded." data-f2="Students can still see it, but their scores are no longer recorded." data-f3="Students no longer see it; their scores are no longer recorded." data-f4="Students no longer see it." data-e0="Not visible to students. You can still add, remove and edit exercises." data-e1="Students can take it and their scores are recorded." data-e2="Students can still see it, but their scores are no longer recorded." data-e3="Students no longer see it; their scores are no longer recorded." data-e4="Students no longer see it." data-avances="Advanced options" data-cut-aide="A student who started the exam before a cut-off time cannot open a new session after it." data-cut-le="On" data-cut-a="at" data-cut-ajouter="Add a cut-off time" data-cut-retirer="Remove this cut-off time" data-cut-aucune="No cut-off time." data-cut-expert="Expert setting: what WIMS sees" data-cut-format="The cut-off times as WIMS reads them: yyyymmdd.hh:mm, separated by spaces." data-com-ecrire="Write a comment" data-com-modifier="Edit the comment" data-com-replier="Hide the editor"></template>
!exit

:statuts_ressources
!! _widgets/statuts-ressources.phtml
<template id="nova-statuts-textes" data-activer="Activate" data-reactiver="Reactivate" data-activer-f="Students see it and their scores are recorded." data-activer-e="Students can take it and their scores are recorded." data-activer-d="Students can hand in their work." data-vide="Add an exercise first." data-expirer-f="Still visible; new scores are no longer recorded." data-expirer-e="Students can no longer take it; scores are kept." data-expirer-d="No more submissions; refused if some copies are not marked." data-cacher="Disappears from the students' page." data-montrer="Reappears on the students' page." data-reactiver-n="Scores are recorded again." data-reactiver-d="Submissions reopen." data-desactiver="Back to preparation; warning if students have worked on it." data-effacer="Permanent; confirmation is asked." data-archiver="Freezes the assignment; it can no longer be reactivated."></template>
!exit
:sequences
!! _widgets/sequences.phtml
<template id="nova-seq-textes" data-plier="Collapse" data-deplier="Expand" data-tout-plier="Collapse all" data-tout-deplier="Expand all" data-compte="%1 sequences" data-compte-1="1 sequence" data-monter="Move up" data-descendre="Move down" data-glisser="Drag to move" data-modifier="Edit" data-activer="Students see the sequence and its active resources." data-desactiver="The sequence disappears from the students' page; its resources remain." data-effacer="The grouping disappears; sheets, exams and documents remain. Confirmation is asked." data-enregistrement="Saving..." data-erreur="The move was not saved. The page will be reloaded." data-numero="Number only, no generic word" data-numero-aide="Sequences are shown with their number only, for you and for students. The word kept above comes back if you uncheck."></template>
!exit

:export
!! header.phtml, Liaison tableur (adm/class/userscore job=csv ; nova.js exportTableur, audit C2, 2026-11-14)
<template id="nova-export-textes" data-titre="Spreadsheet link" data-eleves="Students" data-autres="Other" data-feuille="Sheet %1" data-examen="Exam %1" data-moyenne="Average" data-col-login="Login" data-col-lastname="Last name" data-col-firstname="First name" data-col-password="Password" data-col-email="Email" data-col-regnum="Registration number" data-col-comments="Comments" data-col-photourl="Photo" data-col-external_auth="External login" data-deposer="Drop the file here, or" data-choisir="choose it"></template>
!exit
