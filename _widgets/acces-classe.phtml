!! Nova : formulaire de la page Restriction d'acces (adm/class/config, job=access ; 2026-11-10, utilisateur, maquette A) :
!! heures interdites chaque jour, periodes entre deux dates, portee (classe ou exercices). nova.js (accesClasse) ecrit les
!! lignes dans le champ accessdef de WIMS, entre # Nova : debut et # Nova : fin, en tete ; regles a la main gardees,
!! doublons ecrits une seule fois. Textes : lang/enseignant.phtml.<lang> (nova_acc_...).
!read themes/$wims_theme/lang/enseignant.phtml.$lang
<template id="nova-acces" data-titre-jour="$nova_acc_titre_jour" data-aide-jour="$nova_acc_aide_jour" data-de="$nova_acc_de" data-a="$nova_acc_a" data-lendemain="$nova_acc_lendemain" data-retirer-plage="$nova_acc_retirer_plage" data-ajouter-plage="$nova_acc_ajouter_plage" data-nuit="$nova_acc_nuit" data-titre-periodes="$nova_acc_titre_periodes" data-aide-periodes="$nova_acc_aide_periodes" data-du="$nova_acc_du" data-au="$nova_acc_au" data-heure-debut="$nova_acc_heure_debut" data-heure-fin="$nova_acc_heure_fin" data-retirer-periode="$nova_acc_retirer_periode" data-ajouter-periode="$nova_acc_ajouter_periode" data-incomplet="$nova_acc_incomplet" data-titre-portee="$nova_acc_titre_portee" data-tout="$nova_acc_tout" data-exo="$nova_acc_exo" data-titre-resume="$nova_acc_titre_resume" data-resume-tout="$nova_acc_resume_tout" data-resume-exo="$nova_acc_resume_exo" data-chaque-jour="$nova_acc_chaque_jour" data-chaque-jour-lendemain="$nova_acc_chaque_jour_lendemain" data-periode="$nova_acc_periode" data-aucune="$nova_acc_aucune" data-lignes="$nova_acc_lignes" data-expert="$nova_acc_expert" data-expert-n="$nova_acc_expert_n" data-expert-aide="$nova_acc_expert_aide"></template>
